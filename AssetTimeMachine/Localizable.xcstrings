          "stringUnit": {
            "state": "translated",
            "value": "Historical candidate since 2001: 65% gold, 15.7% S&P 500, and 19.3% Nasdaq. Each asset must be above its 200-day moving average with positive 120-session momentum. Rebalanced every 20 trading sessions with 8.5% target volatility."
          }
        },
        "zh-Hans": {
