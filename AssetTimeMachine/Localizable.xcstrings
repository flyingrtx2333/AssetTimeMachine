    "黄金作为防守核心，纳指/标普只做趋势卫星；黄金看MA120，权益看MA250，每20个交易日再平衡，目标波动9.5%。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gold is the core of defense, and the Nasdaq/S&P is only a trend satellite; gold looks at MA120, and equity looks at MA250. It is rebalanced every 20 trading days, with a target volatility of 9.5%."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黄金作为防守核心，纳指/标普只做趋势卫星；黄金看MA120，权益看MA250，每20个交易日再平衡，目标波动9.5%。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "黃金作為防守核心，納指/標普只做趨勢衛星；黃金看MA120，權益看MA250，每20個交易日再平衡，目標波動9.5%。"
          }
        }
      }
    },
