        if ProcessInfo.processInfo.environment["ATM_C3L3_PBO_PANEL"] == "1" {
            func loadPBOSeries(_ path: String) -> [(releaseDate: String, value: Double)] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [] }
                return text.split(whereSeparator: \.isNewline).dropFirst().compactMap { line in
                    let f = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard f.count >= 3, let v = Double(f[2]), v.isFinite else { return nil }
                    return (String(f[0]), v)
                }.sorted { $0.0 < $1.0 }
            }
            func pboChange(_ s: [(releaseDate: String, value: Double)], _ d: String, _ n: Int) -> Double? {
                var latest: Int?
                for i in s.indices { if s[i].releaseDate <= d { latest = i } else { break } }
                guard let i = latest, i >= n else { return nil }
                return s[i].value - s[i-n].value
            }
            let creditSeries = loadPBOSeries("tools/research-results/NFCICREDIT_initial_release.csv")
            let leverageSeries = loadPBOSeries("tools/research-results/NFCILEVERAGE_initial_release.csv")
            guard creditSeries.count >= 700, leverageSeries.count >= 700 else { return }
            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceLowNoise
            let options = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { options[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { seriesBySymbol[normalizedHistorySymbol($0)] }
            }
            guard let base = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                assetInputs: inputs, initialCash: 100_000, settings: settings, mode: mode
            ) else { return }
            let baseTargets = Dictionary(uniqueKeysWithValues: base.dailyStates.map { ($0.date.recordDateString, $0.targetWeights) })
            let baseTrades = Set(base.report.trades.map { $0.date.recordDateString })
            let us: Set<String> = ["nasdaq", "sp500"]
            var ids: [String] = []
            var valueMaps: [[String: Double]] = []
            var metadata: [String] = ["id,credit_threshold,leverage_threshold,generic_retention,cagr,mdd,sharpe,trades,events"]
            for cThreshold in [-0.02, -0.03, -0.04] {
                for lThreshold in [-0.03, -0.04, -0.05] {
                    for genericRetention in [0.75, 0.90, 1.00] {
                        let id = String(format: "c%.2f_l%.2f_g%.2f", cThreshold, lThreshold, genericRetention)
                            .replacingOccurrences(of: "-", with: "m")
                        let config = ResearchTargetStrategyConfig(
                            symbol: id, title: id, warmupSessions: 21, rebalanceSessions: 1,
                            rebalanceBand: 0.244, maxGrossExposure: 1, allowsFinancedExposure: false,
                            financingAnnualRate: 0, buyReason: id
                        )
                        var priorBase: [String: Double] = [:]
                        var pending: [String: Double] = [:]
                        var events = 0
                        guard let run = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                            assetInputs: inputs, initialCash: 100_000, settings: settings, config: config,
                            rebalanceDecision: { index, signalIndex, data in
                                guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else {
                                    return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                                }
                                let execution = data.dates[index].recordDateString
                                guard baseTrades.contains(execution), var target = baseTargets[execution] else {
                                    return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                                }
                                let prior = priorBase; priorBase = target
                                guard !prior.isEmpty else { pending = target; return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false) }
                                let signal = data.dates[signalIndex].recordDateString
                                let c = pboChange(creditSeries, signal, 8).map { $0 <= cThreshold } ?? false
                                let l = pboChange(leverageSeries, signal, 4).map { $0 <= lThreshold } ?? false
                                let priorGross = prior.values.reduce(0,+), proposedGross = target.values.reduce(0,+)
                                let priorUS = prior.reduce(0.0) { $0 + (us.contains($1.key) ? $1.value : 0) }
                                let proposedUS = target.reduce(0.0) { $0 + (us.contains($1.key) ? $1.value : 0) }
                                let usDrop = priorUS - proposedUS, grossDrop = priorGross - proposedGross
                                var extras: [String: Double] = [:]
                                if c || l {
                                    if usDrop >= 0.05, grossDrop >= 0.03 {
                                        let retention = c && l ? 1.0 : 0.5
                                        for symbol in us {
                                            let reduction = max((prior[symbol] ?? 0) - (target[symbol] ?? 0), 0)
                                            if reduction > 0 { extras[symbol] = retention * reduction }
                                        }
                                    } else if grossDrop >= 0.05 {
                                        for (symbol, weight) in prior {
                                            let reduction = max(weight - (target[symbol] ?? 0), 0)
                                            if reduction > 0 { extras[symbol] = genericRetention * reduction }
                                        }
                                    }
                                }
                                let desired = extras.values.reduce(0,+)
                                if desired > 0 {
                                    let scale = min(1.0, max(1.0 - proposedGross, 0) / desired)
                                    for (symbol, extra) in extras { target[symbol, default: 0] += extra * scale }
                                    events += 1
                                }
                                let gross = target.values.reduce(0,+)
                                if gross > 1, gross > 0 { target = target.mapValues { max($0,0) / gross } }
                                pending = target
                                return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                            },
                            targetWeights: { _, _ in pending }
                        ) else { continue }
                        let map = Dictionary(uniqueKeysWithValues: run.report.points.map { ($0.date.recordDateString, $0.portfolioValue) })
                        ids.append(id); valueMaps.append(map)
                        metadata.append([
                            id, String(format:"%.2f",cThreshold), String(format:"%.2f",lThreshold), String(format:"%.2f",genericRetention),
                            String(format:"%.6f",(run.report.annualizedReturn ?? 0)*100), String(format:"%.6f",run.report.maxDrawdown*100),
                            String(format:"%.6f",run.report.sharpeRatio ?? 0), String(run.report.trades.count), String(events)
                        ].joined(separator:","))
                    }
                }
            }
            guard ids.count == 27, let firstMap = valueMaps.first else { print("APP_C3L3_PBO_PANEL\nvariants=\(ids.count)"); return }
            let dates = firstMap.keys.sorted().filter { key in valueMaps.allSatisfy { $0[key] != nil } }
            var lines: [String] = []
            lines.reserveCapacity(dates.count + 1)
            lines.append((["date"] + ids).joined(separator:","))
            for d in dates {
                let values = valueMaps.map { String(format:"%.10f",$0[d] ?? 0) }
                lines.append(([d] + values).joined(separator:","))
            }
            let panelPath = ProcessInfo.processInfo.environment["ATM_C3L3_PBO_PANEL_PATH"] ?? "/private/tmp/c3l3_pbo_panel.csv"
            let metaPath = ProcessInfo.processInfo.environment["ATM_C3L3_PBO_META_PATH"] ?? "/private/tmp/c3l3_pbo_meta.csv"
            do {
                try (lines.joined(separator:"\n") + "\n").write(toFile: panelPath, atomically: true, encoding: .utf8)
                try (metadata.joined(separator:"\n") + "\n").write(toFile: metaPath, atomically: true, encoding: .utf8)
                print("APP_C3L3_PBO_PANEL")
                print("variants=\(ids.count),rows=\(dates.count),panel=\(panelPath),meta=\(metaPath)")
            } catch { print("APP_C3L3_PBO_PANEL\nwrite_failed=\(error)") }
            return
        }
