        if ProcessInfo.processInfo.environment["ATM_FACTOR_DURATION_001"] == "1" {
            let formal = ProcessInfo.processInfo.environment["ATM_FACTOR_DURATION_001_FORMAL"] == "1"
            let outputDir = ProcessInfo.processInfo.environment["ATM_FACTOR_DURATION_001_OUTPUT_DIR"]
            let symbols = ["vbr_tr", "mtum_tr", "qual_tr", "tlt_tr", "spy_tr"]
            func loadAdjustedCloseSeries(path:String,symbol:String,label:String)->PublicHistorySeries?{
                guard let text=try?String(contentsOfFile:path,encoding:.utf8) else{return nil};var dates:[String]=[],prices:[Double]=[]
                for line in text.split(whereSeparator:\.isNewline).dropFirst(){let f=line.split(separator:",",omittingEmptySubsequences:false);guard f.count>=2,let v=Double(f[1]),v.isFinite,v>0 else{continue};dates.append(String(f[0]));prices.append(v)}
                guard dates.count>=500,dates.count==prices.count else{return nil}
                return PublicHistorySeries(symbol:symbol,category:"long_only_factor_total_return_proxy",label:label,currency:"USD",unit:"adjusted_close",source:"Frozen Yahoo adjusted close",dates:dates,prices:prices,hasOHLC:false,ohlcSource:nil,ohlcCoverageRatio:nil,openPrices:nil,highPrices:nil,lowPrices:nil,closePrices:nil,volumes:nil)
