                  let mtum=loadAdjustedCloseSeries(path:"tools/research-results/strategy-validation/factor-data/US-MOMENTUM-QUALITY-ROLE-V1-2026-08-22/MTUM.csv",symbol:"mtum_tr",label:"MTUM momentum TR"),
                  let qual=loadAdjustedCloseSeries(path:"tools/research-results/strategy-validation/factor-data/US-MOMENTUM-QUALITY-ROLE-V1-2026-08-22/QUAL.csv",symbol:"qual_tr",label:"QUAL quality TR"),
                  let tlt=loadAdjustedCloseSeries(path:"tools/research-results/strategy-validation/factor-data/ATM-SVP2-ORTHO-FACTOR-005/TLT.csv",symbol:"tlt_tr",label:"TLT duration TR"),
                  let spy=loadAdjustedCloseSeries(path:"tools/research-results/strategy-validation/factor-data/ATM-SVP2-ORTHO-FACTOR-003/SPY.csv",symbol:"spy_tr",label:"SPY TR"),
                  let fx=seriesBySymbol["usd_per_cny"] else{print("FACTOR_DURATION_001_INPUTS_MISSING");return}
            func option(_ s:PublicHistorySeries,_ title:String,_ color:Color)->BacktestAssetOption{BacktestAssetOption(symbol:s.symbol,title:title,color:color,requiresHistoricalFX:true,historicalFXSymbol:"usd_per_cny",currency:"USD")}
            let inputs=[
                (assetSeries:Optional(vbr),assetOption:option(vbr,"VBR",AssetTheme.accentOrange),fxSeries:Optional(fx)),
                (assetSeries:Optional(mtum),assetOption:option(mtum,"MTUM",AssetTheme.accentRed),fxSeries:Optional(fx)),
                (assetSeries:Optional(qual),assetOption:option(qual,"QUAL",AssetTheme.positive),fxSeries:Optional(fx)),
                (assetSeries:Optional(tlt),assetOption:option(tlt,"TLT",AssetTheme.accentBlue),fxSeries:Optional(fx)),
                (assetSeries:Optional(spy),assetOption:option(spy,"SPY",AssetTheme.textPrimary),fxSeries:Optional(fx))]
            let settings=AdvancedBacktestRiskSettings(feeRate:1.00,slippageRate:0.05,maxPositionRatio:100,cooldownDays:0,stopLossRatio:0,takeProfitRatio:0)
            let formatter=DateFormatter();formatter.calendar=BacktestSeriesAlignment.historicalSeriesCalendar;formatter.locale=Locale(identifier:"en_US_POSIX");formatter.timeZone=BacktestSeriesAlignment.historicalSeriesCalendar.timeZone;formatter.dateFormat="yyyy-MM-dd"
            guard let start=formatter.date(from:"2013-07-18"),let end=formatter.date(from:"2026-08-13") else{print("FACTOR_DURATION_001_DATE_FAILED");return};let bounds=start...end
            let folds:[(String,String,String)]=[("2013-2014","2013-07-18","2014-12-31"),("2015-2016","2015-01-01","2016-12-31"),("2017-2018","2017-01-01","2018-12-31"),("2019-2020","2019-01-01","2020-12-31"),("2021-2022","2021-01-01","2022-12-31"),("2023-2024","2023-01-01","2024-12-31"),("2025-latest","2025-01-01","9999-12-31")]
            enum Mode{case factorDuration,spy,cash}
            func config(_ id:String)->ResearchTargetStrategyConfig{ResearchTargetStrategyConfig(symbol:id,title:"Factor Duration 001",warmupSessions:2,rebalanceSessions:1,rebalanceBand:0,maxGrossExposure:1,allowsFinancedExposure:false,financingAnnualRate:0,buyReason:"固定value-momentum-quality-duration等权年度再平衡")}
            func runPath(_ id:String,_ mode:Mode)->ResearchTargetStrategyRun?{var first=true;return BacktestEngine.runResearchTargetProviderStrategyWithTrace(assetInputs:inputs,initialCash:100_000,settings:settings,config:config(id),dateBounds:bounds,rebalanceDecision:{index,signalIndex,data in guard data.dates.indices.contains(index) else{return BacktestRebalanceDecision(shouldRebalance:false,refreshOverlay:false)};if first{first=false;return BacktestRebalanceDecision(shouldRebalance:true,refreshOverlay:false)};guard mode == .factorDuration,data.dates.indices.contains(signalIndex) else{return BacktestRebalanceDecision(shouldRebalance:false,refreshOverlay:false)};return BacktestRebalanceDecision(shouldRebalance:FactorDuration001Logic.shouldRebalance(current:data.dates[index].recordDateString,previous:data.dates[signalIndex].recordDateString),refreshOverlay:false)},targetWeights:{_,_ in switch mode{case .factorDuration:return FactorDuration001Logic.targetWeights;case .spy:return ["spy_tr":1.0];case .cash:return[:]}})}
            guard let candidate=runPath("FD001",.factorDuration),let control=runPath("C-SPY-BUYHOLD",.spy),let cash=runPath("C-CASH",.cash) else{print("FACTOR_DURATION_001_RUN_FAILED");return}
            func pts(_ r:ResearchTargetStrategyRun)->[BacktestSeriesPoint]{r.report.points.filter{$0.date>=start && $0.date<=end}}
            func sts(_ r:ResearchTargetStrategyRun)->[BacktestDailyState]{r.dailyStates.filter{$0.date>=start && $0.date<=end}}
            func fp(_ ss:[BacktestDailyState])->String{var h:UInt64=1469598103934665603;for s in ss{for sym in symbols{var v=UInt64(bitPattern:Int64(((s.targetWeights[sym] ?? 0)*1_000_000).rounded()));for _ in 0..<8{h ^= v & UInt64(0xff);h &*= UInt64(1099511628211);v >>= 8}}};return String(format:"%016llx",h)}
            func foldMetrics(_ p:[BacktestSeriesPoint])->[[String:Any]]{folds.map{name,a,b in let x=p.filter{$0.date.recordDateString>=a && $0.date.recordDateString<=b};let m=BacktestMetricsCalculator.performanceMetrics(from:x);return ["name":name,"sessions":x.count,"cagr_percent":(m?.annualizedReturn ?? 0)*100,"mdd_percent":(m?.maxDrawdown ?? 0)*100,"sharpe":m?.sharpeRatio ?? 0]}}
            func doc(_ id:String,_ r:ResearchTargetStrategyRun)->[String:Any]{let p=pts(r),s=sts(r),m=BacktestMetricsCalculator.performanceMetrics(from:p),m20=BacktestMetricsCalculator.performanceMetrics(from:p.filter{$0.date.recordDateString>="2020-01-01"}),m22=BacktestMetricsCalculator.performanceMetrics(from:p.filter{$0.date.recordDateString>="2022-01-01"});let g=s.map{x in x.portfolioValue>0 ? x.holdingsBySymbol.values.reduce(0,+)/x.portfolioValue:0};return ["id":id,"start":p.first?.date.recordDateString ?? "","end":p.last?.date.recordDateString ?? "","sessions":p.count,"cagr_percent":(m?.annualizedReturn ?? 0)*100,"mdd_percent":(m?.maxDrawdown ?? 0)*100,"volatility_percent":(m?.annualizedVolatility ?? 0)*100,"sharpe":m?.sharpeRatio ?? 0,"trades":r.report.trades.count,"average_cash_ratio":r.report.averageCashRatio,"max_gross":g.max() ?? 0,"minimum_cash":s.map(\.cash).min() ?? 0,"target_fingerprint":fp(s),"since2020_cagr_percent":(m20?.annualizedReturn ?? 0)*100,"since2020_sharpe":m20?.sharpeRatio ?? 0,"since2022_cagr_percent":(m22?.annualizedReturn ?? 0)*100,"since2022_sharpe":m22?.sharpeRatio ?? 0,"folds":foldMetrics(p)]}
            let cdoc=doc("FD001",candidate),sdoc=doc("C-SPY-BUYHOLD",control),cashdoc=doc("C-CASH",cash)
            if !formal{let t=cdoc["trades"] as? Int ?? 0,g=cdoc["max_gross"] as? Double ?? 0,mc=cdoc["minimum_cash"] as? Double ?? -1;print("FACTOR_DURATION_001_SMOKE_TRADES=\(t)");print("FACTOR_DURATION_001_SMOKE_MAX_GROSS=\(g)");print("FACTOR_DURATION_001_SMOKE_MIN_CASH=\(mc)");guard t>0,g<=1.000000001,mc >= -1e-6 else{print("FACTOR_DURATION_001_SMOKE_INVALID");return};print("FACTOR_DURATION_001_SMOKE_OK");return}
            if let outputDir{try? FileManager.default.createDirectory(atPath:outputDir,withIntermediateDirectories:true);for(id,r) in [("FD001",candidate),("C-SPY-BUYHOLD",control),("C-CASH",cash)]{var lines=["date,portfolio_value"];lines.append(contentsOf:pts(r).map{"\($0.date.recordDateString),\(String(format:"%.10f",$0.portfolioValue))"});let path=URL(fileURLWithPath:outputDir).appendingPathComponent("\(id)-portfolio.csv").path;try?(lines.joined(separator:"\n")+"\n").write(toFile:path,atomically:true,encoding:.utf8)}}
            let out:[String:Any]=["trial_id":"ATM-SVP3-FACTOR-DURATION-001","candidate_id":"S-FACTOR-DURATION-001","candidate":cdoc,"spy_buy_hold_control":sdoc,"cash_control":cashdoc,"sleeve_weight":0.25,"fee_percent_per_trade":1.0,"slippage_percent_per_trade":0.05,"evaluation_start":"2013-07-18","evaluation_end":"2026-08-13","rule":"fixed annual 25% VBR value + 25% MTUM momentum + 25% QUAL quality + 25% TLT duration, all matched adjusted-close total-return proxies"]
            guard JSONSerialization.isValidJSONObject(out),let json=try?JSONSerialization.data(withJSONObject:out,options:[.sortedKeys]),let text=String(data:json,encoding:.utf8) else{print("FACTOR_DURATION_001_JSON_FAILED");return};print("FACTOR_DURATION_001_FORMAL_JSON="+text);print("FACTOR_DURATION_001_FORMAL_OK");return
        }
