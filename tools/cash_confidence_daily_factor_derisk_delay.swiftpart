        if ProcessInfo.processInfo.environment["ATM_CC_DAILY_FACTOR_DERISK_DELAY"] == "1" {
            struct DailyFactorDeriskDelayCandidate {
                let title: String
                let retention: Double
                let holdSessions: Int
                let activationDate: String
                let annualized: Double
                let maxDrawdown: Double
                let volatility: Double
                let sharpe: Double
                let sliceRows: [SliceMetricRow]
                let trades: Int
                let averageCash: Double
                let events: Int
                let maxTargetGross: Double
                let maxActualGross: Double
                let minCash: Double
                let financedDays: Int
            }

            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceLowNoise
            let optionsBySymbol = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { optionsBySymbol[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }
            guard let baseRun = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                assetInputs: inputs,
                initialCash: 100_000,
                settings: settings,
                mode: mode
            ), let baseStartDate = baseRun.report.points.first?.date else {
                print("APP_CC_DAILY_FACTOR_DERISK_DELAY\nbase_missing")
                return
            }
            let dates = baseRun.dailyStates.map(\.date)
            let baseTargets = Dictionary(uniqueKeysWithValues: baseRun.dailyStates.map { ($0.date.recordDateString, $0.targetWeights) })
            let baseTradeDates = Set(baseRun.report.trades.map { $0.date.recordDateString })
            let dateIndex = Dictionary(uniqueKeysWithValues: dates.enumerated().map { ($0.element.recordDateString, $0.offset) })
            let symbols = ["gold_cny", "nasdaq", "sp500", "csi300", "shanghai_composite"]

            func delayBlankMA(_ values: [Double], _ period: Int) -> [Double?] { Array(repeating: nil, count: values.count) }
            func delayBlankBoll(_ values: [Double], _ period: Int, _ multiplier: Double) -> [(middle: Double, lower: Double, upper: Double)?] {
                Array(repeating: nil, count: values.count)
            }
            func alignedDelayPrices(_ symbol: String) -> [Double]? {
                guard let input = inputs.first(where: { $0.assetOption.symbol == symbol }),
                      let prepared = BacktestAdvancedSeriesPreparer.preparedAdvancedSeries(
                        assetSeries: input.assetSeries,
                        assetOption: input.assetOption,
                        fxSeries: input.fxSeries,
                        movingAverage: delayBlankMA,
                        bollingerBands: delayBlankBoll
                      ) else { return nil }
                let map = Dictionary(uniqueKeysWithValues: prepared.pricePoints.map { ($0.date.recordDateString, $0.cnyPrice) })
                var output: [Double] = []
                var last: Double?
                for date in dates {
                    if let value = map[date.recordDateString], value.isFinite, value > 0 { last = value }
                    guard let value = last else { return nil }
                    output.append(value)
                }
                return output
            }
            var prices: [String: [Double]] = [:]
            for symbol in symbols {
                guard let aligned = alignedDelayPrices(symbol) else { return }
                prices[symbol] = aligned
            }
            func delayMomentum(_ values: [Double], at index: Int, lookback: Int) -> Double? {
                guard index >= lookback, values[index - lookback] > 0 else { return nil }
                return values[index] / values[index - lookback] - 1
            }
            func delayVol(_ values: [Double], at index: Int, lookback: Int) -> Double? {
                guard index >= lookback else { return nil }
                var rs: [Double] = []
                for i in (index - lookback + 1)...index {
                    guard values[i - 1] > 0 else { return nil }
                    rs.append(values[i] / values[i - 1] - 1)
                }
                let m = rs.reduce(0, +) / Double(rs.count)
                let v = rs.reduce(0.0) { $0 + ($1 - m) * ($1 - m) } / Double(max(rs.count - 1, 1))
                return sqrt(max(v, 0))
            }
            func delayRanks(_ raw: [String: Double]) -> [String: Double] {
                let ordered = raw.sorted { lhs, rhs in lhs.value == rhs.value ? lhs.key < rhs.key : lhs.value < rhs.value }
                var result: [String: Double] = [:]
                for (i, item) in ordered.enumerated() { result[item.key] = Double(i) / Double(max(ordered.count - 1, 1)) }
                return result
            }
            func delayFactorSignal(at signalIndex: Int) -> (compositeTop: [String], shortTop: [String], longTop: [String], consensus: Bool)? {
                guard signalIndex >= 252 else { return nil }
                var short: [String: Double] = [:]
                var long: [String: Double] = [:]
                for symbol in symbols {
                    guard let v = prices[symbol],
                          let m60 = delayMomentum(v, at: signalIndex, lookback: 60),
                          let m252 = delayMomentum(v, at: signalIndex, lookback: 252),
                          let vol20 = delayVol(v, at: signalIndex, lookback: 20),
                          let vol60 = delayVol(v, at: signalIndex, lookback: 60),
                          vol20 > 1e-8, vol60 > 1e-8 else { return nil }
                    short[symbol] = m60 / vol20
                    long[symbol] = m252 / vol60
                }
                let sr = delayRanks(short)
                let lr = delayRanks(long)
                var scored: [(String, Double)] = []
                for symbol in symbols {
                    let shortRank = sr[symbol] ?? 0.5
                    let longRank = lr[symbol] ?? 0.5
                    scored.append((symbol, 0.5 * shortRank + 0.5 * longRank))
                }
                scored.sort { lhs, rhs in
                    if lhs.1 == rhs.1 { return lhs.0 < rhs.0 }
                    return lhs.1 > rhs.1
                }
                let shortTopArray = Array(short.sorted { lhs, rhs in lhs.value > rhs.value }.prefix(2).map { $0.key })
                let longTopArray = Array(long.sorted { lhs, rhs in lhs.value > rhs.value }.prefix(2).map { $0.key })
                let shortTop = Set(shortTopArray)
                let longTop = Set(longTopArray)
                return (Array(scored.prefix(2).map { $0.0 }), shortTopArray, longTopArray, shortTop == longTop)
            }

            let configs: [(String, Double, Int, String, Int)] = [
                ("生产冠军重放控制组", 0.00, 5, "0000-01-01", 0),
                ("RAM复合Top2延迟25%", 0.25, 5, "0000-01-01", 0),
                ("RAM60_20 Top2延迟25%", 0.25, 5, "0000-01-01", 1),
                ("RAM60_20 Top2延迟50%", 0.50, 5, "0000-01-01", 1),
                ("RAM252_60 Top2延迟25%", 0.25, 5, "0000-01-01", 2),
                ("RAM252_60 Top2延迟50%", 0.50, 5, "0000-01-01", 2),
                ("RAM252_60 Top2延迟25%-2015+", 0.25, 5, "2015-01-01", 2),
                ("RAM252_60 Top2延迟25%-2021+", 0.25, 5, "2021-01-01", 2),
                ("RAM共识Top2延迟25%", 0.25, 5, "0000-01-01", 3),
            ]
            var candidates: [DailyFactorDeriskDelayCandidate] = []

            for (title, retention, holdSessions, activationDate, signalMode) in configs {
                let config = ResearchTargetStrategyConfig(
                    symbol: "cc_daily_factor_derisk_delay",
                    title: title,
                    warmupSessions: 21,
                    rebalanceSessions: 1,
                    rebalanceBand: 0.244,
                    maxGrossExposure: 1.0,
                    allowsFinancedExposure: false,
                    financingAnnualRate: 0,
                    buyReason: "RAM高排名资产减仓延迟"
                )
                var previousBase: [String: Double] = [:]
                var pending: [String: Double] = [:]
                var retainedCeiling: [String: Double] = [:]
                var retainedExtra: [String: Double] = [:]
                var expiryIndex: Int?
                var events = 0

                guard let run = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                    assetInputs: inputs,
                    initialCash: 100_000,
                    settings: settings,
                    config: config,
                    rebalanceDecision: { index, signalIndex, data in
                        guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let key = data.dates[index].recordDateString
                        guard var target = baseTargets[key] else { return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false) }
                        let isBaseTrade = baseTradeDates.contains(key)
                        let expiryDue = expiryIndex.map { index >= $0 } ?? false
                        guard isBaseTrade || expiryDue else { return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false) }

                        if expiryDue {
                            retainedCeiling = [:]
                            retainedExtra = [:]
                            expiryIndex = nil
                        }

                        if isBaseTrade {
                            let prior = previousBase
                            previousBase = target
                            if retention > 0, key >= activationDate, !prior.isEmpty,
                               let alignedSignal = dateIndex[data.dates[signalIndex].recordDateString],
                               let factorSignal = delayFactorSignal(at: alignedSignal),
                               (signalMode != 3 || factorSignal.consensus) {
                                let topTwo: [String]
                                if signalMode == 1 {
                                    topTwo = factorSignal.shortTop
                                } else if signalMode == 2 {
                                    topTwo = factorSignal.longTop
                                } else {
                                    topTwo = factorSignal.compositeTop
                                }
                                let priorGross = prior.values.reduce(0, +)
                                let proposedGross = target.values.reduce(0, +)
                                let grossDecrease = priorGross - proposedGross
                                var topSale = 0.0
                                var eventExtra: [String: Double] = [:]
                                var eventCeiling: [String: Double] = [:]
                                for symbol in topTwo {
                                    let reduction = max((prior[symbol] ?? 0) - (target[symbol] ?? 0), 0)
                                    topSale += reduction
                                    if reduction > 0 {
                                        eventExtra[symbol] = retention * reduction
                                        eventCeiling[symbol] = prior[symbol] ?? 0
                                    }
                                }
                                if grossDecrease >= 0.03, topSale >= 0.05, !eventExtra.isEmpty {
                                    let availableCash = max(1.0 - proposedGross, 0)
                                    let desired = eventExtra.values.reduce(0, +)
                                    let scale = desired > 0 ? min(1.0, availableCash / desired) : 0
                                    retainedExtra = eventExtra.mapValues { $0 * scale }
                                    retainedCeiling = eventCeiling
                                    expiryIndex = index + holdSessions
                                    events += 1
                                }
                            }
                        }

                        if expiryIndex != nil, !retainedExtra.isEmpty {
                            for (symbol, extra) in retainedExtra {
                                let ceiling = retainedCeiling[symbol] ?? (target[symbol] ?? 0)
                                let desired = (target[symbol] ?? 0) + extra
                                target[symbol] = max(target[symbol] ?? 0, min(desired, ceiling))
                            }
                            let gross = target.values.reduce(0, +)
                            if gross > 1.0, gross > 0 { target = target.mapValues { max($0, 0) / gross } }
                        }
                        pending = target
                        return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                    },
                    targetWeights: { _, _ in pending }
                ) else { continue }

                let points = run.report.points.filter { $0.date >= baseStartDate }
                guard let metrics = BacktestMetricsCalculator.performanceMetrics(from: points) else { continue }
                let fullRow = MetricRow(
                    title: title,
                    id: "cc_daily_factor_derisk_delay",
                    annualized: metrics.annualizedReturn,
                    maxDrawdown: metrics.maxDrawdown,
                    volatility: metrics.annualizedVolatility,
                    sharpe: metrics.sharpeRatio,
                    start: points.first?.date.recordDateString ?? "n/a",
                    end: points.last?.date.recordDateString ?? "n/a",
                    pointCount: points.count
                )
                var maxTargetGross = 0.0
                var maxActualGross = 0.0
                var minCash = Double.greatestFiniteMagnitude
                var financedDays = 0
                for state in run.dailyStates where state.portfolioValue > 0 && state.date >= baseStartDate {
                    maxTargetGross = max(maxTargetGross, state.targetWeights.values.reduce(0, +))
                    maxActualGross = max(maxActualGross, state.holdingsBySymbol.values.reduce(0, +) / state.portfolioValue)
                    minCash = min(minCash, state.cash / state.portfolioValue)
                    if state.cash < -0.0001 { financedDays += 1 }
                }
                candidates.append(.init(
                    title: title,
                    retention: retention,
                    holdSessions: holdSessions,
                    activationDate: activationDate,
                    annualized: metrics.annualizedReturn ?? -1,
                    maxDrawdown: metrics.maxDrawdown,
                    volatility: metrics.annualizedVolatility ?? -1,
                    sharpe: metrics.sharpeRatio ?? -1,
                    sliceRows: metricRowsForSlices(title: title, id: "cc_daily_factor_derisk_delay", points: points, fullRow: fullRow),
                    trades: run.report.trades.filter { $0.date >= baseStartDate }.count,
                    averageCash: run.report.averageCashRatio,
                    events: events,
                    maxTargetGross: maxTargetGross,
                    maxActualGross: maxActualGross,
                    minCash: minCash == Double.greatestFiniteMagnitude ? 0 : minCash,
                    financedDays: financedDays
                ))
            }

            print("APP_CC_DAILY_FACTOR_DERISK_DELAY_BASE")
            print(String(format: "%.6f,%.6f,%.6f,%d", (baseRun.report.annualizedReturn ?? 0) * 100, baseRun.report.maxDrawdown * 100, baseRun.report.sharpeRatio ?? 0, baseRun.report.trades.count))
            candidates.sort { lhs, rhs in
                let lhsScore = lhs.annualized - max(lhs.maxDrawdown - 0.08, 0) * 4
                let rhsScore = rhs.annualized - max(rhs.maxDrawdown - 0.08, 0) * 4
                if lhsScore == rhsScore { return lhs.sharpe > rhs.sharpe }
                return lhsScore > rhsScore
            }
            printSliceRows(candidates.flatMap(\.sliceRows), header: "APP_CC_DAILY_FACTOR_DERISK_DELAY_GRID")
            print("APP_CC_DAILY_FACTOR_DERISK_DELAY_DIAGNOSTICS")
            print("title,retention,hold,activation,events,trades,average_cash,max_target_gross,max_actual_gross,min_cash,financed_days")
            for c in candidates {
                print([
                    c.title, String(format: "%.3f", c.retention), String(c.holdSessions), c.activationDate,
                    String(c.events), String(c.trades), String(format: "%.6f", c.averageCash),
                    String(format: "%.9f", c.maxTargetGross), String(format: "%.9f", c.maxActualGross),
                    String(format: "%.9f", c.minCash), String(c.financedDays)
                ].joined(separator: ","))
            }
            return
        }
