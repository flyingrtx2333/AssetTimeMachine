        if ProcessInfo.processInfo.environment["ATM_CC_NFCI_C3_L3_RAM_SELECTOR_GRID"] == "1" {
            struct C3L3RAMSelectorCandidate {
                let title: String
                let mode: Int
                let annualized: Double
                let maxDrawdown: Double
                let volatility: Double
                let sharpe: Double
                let sliceRows: [SliceMetricRow]
                let trades: Int
                let averageCash: Double
                let nfciEvents: Int
                let selectiveEvents: Int
                let residualEvents: Int
                let eventDates: [String]
                let maxTargetGross: Double
                let maxActualGross: Double
                let minCash: Double
                let financedDays: Int
            }

            func loadC3L3RAMSeries(_ path: String) -> [(releaseDate: String, value: Double)] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [] }
                return text.split(whereSeparator: \.isNewline).dropFirst().compactMap { line in
                    let fields = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard fields.count >= 3, let value = Double(fields[2]), value.isFinite else { return nil }
                    return (String(fields[0]), value)
                }.sorted { $0.0 < $1.0 }
            }
            func c3L3RAMChange(_ series: [(releaseDate: String, value: Double)], on signalDate: String, lookback: Int) -> Double? {
                var latest: Int?
                for index in series.indices {
                    if series[index].releaseDate <= signalDate { latest = index } else { break }
                }
                guard let latest, latest >= lookback else { return nil }
                return series[latest].value - series[latest - lookback].value
            }

            let creditSeries = loadC3L3RAMSeries("tools/research-results/NFCICREDIT_initial_release.csv")
            let leverageSeries = loadC3L3RAMSeries("tools/research-results/NFCILEVERAGE_initial_release.csv")
            guard creditSeries.count >= 700, leverageSeries.count >= 700 else {
                print("APP_CC_NFCI_C3_L3_RAM_SELECTOR_GRID\nseries_missing")
                return
            }

            let strategyMode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceLowNoise
            let optionsBySymbol = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = strategyMode.requiredSignalAssetSymbols.compactMap { optionsBySymbol[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }
            guard let baseRun = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                assetInputs: inputs, initialCash: 100_000, settings: settings, mode: strategyMode
            ), let baseStartDate = baseRun.report.points.first?.date else {
                print("APP_CC_NFCI_C3_L3_RAM_SELECTOR_GRID\nbase_missing")
                return
            }
            let dates = baseRun.dailyStates.map(\.date)
            let baseTargets = Dictionary(uniqueKeysWithValues: baseRun.dailyStates.map { ($0.date.recordDateString, $0.targetWeights) })
            let baseTradeDates = Set(baseRun.report.trades.map { $0.date.recordDateString })
            let dateIndex = Dictionary(uniqueKeysWithValues: dates.enumerated().map { ($0.element.recordDateString, $0.offset) })
            let symbols = ["gold_cny", "nasdaq", "sp500", "csi300", "shanghai_composite"]
            let usSymbols: Set<String> = ["nasdaq", "sp500"]

            func c3L3RAMBlankMA(_ values: [Double], _ period: Int) -> [Double?] { Array(repeating: nil, count: values.count) }
            func c3L3RAMBlankBoll(_ values: [Double], _ period: Int, _ multiplier: Double) -> [(middle: Double, lower: Double, upper: Double)?] {
                Array(repeating: nil, count: values.count)
            }
            func c3L3RAMAlignedPrices(_ symbol: String) -> [Double]? {
                guard let input = inputs.first(where: { $0.assetOption.symbol == symbol }),
                      let prepared = BacktestAdvancedSeriesPreparer.preparedAdvancedSeries(
                        assetSeries: input.assetSeries,
                        assetOption: input.assetOption,
                        fxSeries: input.fxSeries,
                        movingAverage: c3L3RAMBlankMA,
                        bollingerBands: c3L3RAMBlankBoll
                      ) else { return nil }
                let map = Dictionary(uniqueKeysWithValues: prepared.pricePoints.map { ($0.date.recordDateString, $0.cnyPrice) })
                var output: [Double] = []
                output.reserveCapacity(dates.count)
                var last: Double?
                for date in dates {
                    if let value = map[date.recordDateString], value.isFinite, value > 0 { last = value }
                    guard let value = last else { return nil }
                    output.append(value)
                }
                return output
            }
            var prices: [String: [Double]] = [:]
            for symbol in symbols {
                guard let aligned = c3L3RAMAlignedPrices(symbol) else {
                    print("APP_CC_NFCI_C3_L3_RAM_SELECTOR_GRID\nprice_missing_\(symbol)")
                    return
                }
                prices[symbol] = aligned
            }
            func c3L3RAMMomentum(_ values: [Double], at index: Int, lookback: Int) -> Double? {
                guard index >= lookback, values[index - lookback] > 0 else { return nil }
                return values[index] / values[index - lookback] - 1
            }
            func c3L3RAMVol(_ values: [Double], at index: Int, lookback: Int) -> Double? {
                guard index >= lookback else { return nil }
                var returns: [Double] = []
                returns.reserveCapacity(lookback)
                for i in (index - lookback + 1)...index {
                    guard values[i - 1] > 0 else { return nil }
                    returns.append(values[i] / values[i - 1] - 1)
                }
                let mean = returns.reduce(0, +) / Double(returns.count)
                let variance = returns.reduce(0.0) { $0 + ($1 - mean) * ($1 - mean) } / Double(max(returns.count - 1, 1))
                return sqrt(max(variance, 0))
            }
            func c3L3RAMRanks(_ raw: [String: Double]) -> [String: Double] {
                let ordered = raw.sorted { lhs, rhs in lhs.value == rhs.value ? lhs.key < rhs.key : lhs.value < rhs.value }
                var result: [String: Double] = [:]
                for (i, item) in ordered.enumerated() { result[item.key] = Double(i) / Double(max(ordered.count - 1, 1)) }
                return result
            }
            struct C3L3RAMSignal {
                let shortTop: Set<String>
                let longTop: Set<String>
                let compositeTop: Set<String>
                let m60: [String: Double]
                let m252: [String: Double]
            }
            func c3L3RAMSignal(at signalIndex: Int) -> C3L3RAMSignal? {
                guard signalIndex >= 252 else { return nil }
                var shortScore: [String: Double] = [:]
                var longScore: [String: Double] = [:]
                var m60Map: [String: Double] = [:]
                var m252Map: [String: Double] = [:]
                for symbol in symbols {
                    guard let values = prices[symbol],
                          let m60 = c3L3RAMMomentum(values, at: signalIndex, lookback: 60),
                          let m252 = c3L3RAMMomentum(values, at: signalIndex, lookback: 252),
                          let v20 = c3L3RAMVol(values, at: signalIndex, lookback: 20),
                          let v60 = c3L3RAMVol(values, at: signalIndex, lookback: 60),
                          v20 > 1e-8, v60 > 1e-8 else { return nil }
                    m60Map[symbol] = m60
                    m252Map[symbol] = m252
                    shortScore[symbol] = m60 / v20
                    longScore[symbol] = m252 / v60
                }
                let shortRanks = c3L3RAMRanks(shortScore)
                let longRanks = c3L3RAMRanks(longScore)
                let compositeOrder = symbols.sorted { lhs, rhs in
                    let a = 0.5 * (shortRanks[lhs] ?? 0.5) + 0.5 * (longRanks[lhs] ?? 0.5)
                    let b = 0.5 * (shortRanks[rhs] ?? 0.5) + 0.5 * (longRanks[rhs] ?? 0.5)
                    if a == b { return lhs < rhs }
                    return a > b
                }
                return .init(
                    shortTop: Set(shortScore.sorted { $0.value == $1.value ? $0.key < $1.key : $0.value > $1.value }.prefix(2).map { $0.key }),
                    longTop: Set(longScore.sorted { $0.value == $1.value ? $0.key < $1.key : $0.value > $1.value }.prefix(2).map { $0.key }),
                    compositeTop: Set(compositeOrder.prefix(2)),
                    m60: m60Map,
                    m252: m252Map
                )
            }

            // mode:
            // 0 = exact C3/L3 Generic100 control
            // 1 = broad NFCI derisk retains only composite RAM Top2 reductions
            // 2 = broad NFCI derisk retains only long RAM Top2 reductions
            // 3 = C3/L3 control + residual long RAM Top2 25% sell protection when NFCI is absent
            // 4 = C3/L3 control + residual short/long consensus Top2 25% protection
            // 5 = composite selective Generic + residual long RAM Top2 25%
            // 6/7 = long RAM Top2 retain 100%, other reductions retain 75% / 50%
            // 8/9 = composite RAM Top2 retain 100%, other reductions retain 75% / 50%
            // 10/11 = residual long/consensus RAM protection only when 252d breadth >= 4/5
            // 12/13 = residual long/consensus RAM protection only when 252d breadth = 5/5
            let configurations: [(String, Int)] = [
                ("C3L3 Generic100 基准", 0),
                ("C3L3 Generic只保留RAM复合Top2", 1),
                ("C3L3 Generic只保留RAM长周期Top2", 2),
                ("C3L3 + residual RAM长周期Top2 25%", 3),
                ("C3L3 + residual RAM双周期共识25%", 4),
                ("C3L3 RAM复合选择 + residual长周期25%", 5),
                ("C3L3 RAM长Top2全保留+其他75%", 6),
                ("C3L3 RAM长Top2全保留+其他50%", 7),
                ("C3L3 RAM复合Top2全保留+其他75%", 8),
                ("C3L3 RAM复合Top2全保留+其他50%", 9),
                ("C3L3 + RAM长Top2 25% · breadth4/5", 10),
                ("C3L3 + RAM共识Top2 25% · breadth4/5", 11),
                ("C3L3 + RAM长Top2 25% · breadth5/5", 12),
                ("C3L3 + RAM共识Top2 25% · breadth5/5", 13),
            ]
            var candidates: [C3L3RAMSelectorCandidate] = []

            for (title, selectorMode) in configurations {
                let config = ResearchTargetStrategyConfig(
                    symbol: "cc_nfci_c3_l3_ram_selector",
                    title: title,
                    warmupSessions: 21,
                    rebalanceSessions: 1,
                    rebalanceBand: 0.244,
                    maxGrossExposure: 1.0,
                    allowsFinancedExposure: false,
                    financingAnnualRate: 0,
                    buyReason: "C3L3 RAM选择性减仓保留"
                )
                var previousBase: [String: Double] = [:]
                var pending: [String: Double] = [:]
                var nfciEvents = 0
                var selectiveEvents = 0
                var residualEvents = 0
                var eventDates: [String] = []

                guard let run = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                    assetInputs: inputs,
                    initialCash: 100_000,
                    settings: settings,
                    config: config,
                    rebalanceDecision: { index, signalIndex, data in
                        guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let executionKey = data.dates[index].recordDateString
                        guard baseTradeDates.contains(executionKey), var target = baseTargets[executionKey] else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let prior = previousBase
                        previousBase = target
                        guard !prior.isEmpty else {
                            pending = target
                            return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                        }
                        let signalKey = data.dates[signalIndex].recordDateString
                        let alignedSignal = dateIndex[signalKey]
                        let ram = alignedSignal.flatMap { c3L3RAMSignal(at: $0) }
                        let creditTrigger = c3L3RAMChange(creditSeries, on: signalKey, lookback: 8).map { $0 <= -0.03 } ?? false
                        let leverageTrigger = c3L3RAMChange(leverageSeries, on: signalKey, lookback: 4).map { $0 <= -0.03 } ?? false
                        let priorGross = prior.values.reduce(0, +)
                        let proposedGross = target.values.reduce(0, +)
                        let priorUS = prior.reduce(0.0) { $0 + (usSymbols.contains($1.key) ? $1.value : 0) }
                        let proposedUS = target.reduce(0.0) { $0 + (usSymbols.contains($1.key) ? $1.value : 0) }
                        let usDecrease = priorUS - proposedUS
                        let grossDecrease = priorGross - proposedGross
                        var extras: [String: Double] = [:]
                        var tag: String?

                        if creditTrigger || leverageTrigger {
                            if usDecrease >= 0.05, grossDecrease >= 0.03 {
                                let retention = creditTrigger && leverageTrigger ? 1.00 : 0.50
                                for symbol in usSymbols {
                                    let reduction = max((prior[symbol] ?? 0) - (target[symbol] ?? 0), 0)
                                    if reduction > 0 { extras[symbol] = retention * reduction }
                                }
                            } else if grossDecrease >= 0.05 {
                                let selection: Set<String>?
                                let fallbackRetention: Double
                                switch selectorMode {
                                case 1, 5, 8, 9:
                                    selection = ram?.compositeTop
                                    fallbackRetention = selectorMode == 8 ? 0.75 : (selectorMode == 9 ? 0.50 : 0.0)
                                case 2, 6, 7:
                                    selection = ram?.longTop
                                    fallbackRetention = selectorMode == 6 ? 0.75 : (selectorMode == 7 ? 0.50 : 0.0)
                                default:
                                    selection = nil
                                    fallbackRetention = 1.0
                                }
                                for (symbol, priorWeight) in prior {
                                    let reduction = max(priorWeight - (target[symbol] ?? 0), 0)
                                    guard reduction > 0 else { continue }
                                    if let selection {
                                        let positiveTrend = (ram?.m60[symbol] ?? -1) > 0 && (ram?.m252[symbol] ?? -1) > 0
                                        if selection.contains(symbol) && positiveTrend {
                                            extras[symbol] = reduction
                                        } else if fallbackRetention > 0 {
                                            extras[symbol] = fallbackRetention * reduction
                                        }
                                    } else {
                                        extras[symbol] = reduction
                                    }
                                }
                                if selection != nil, !extras.isEmpty { selectiveEvents += 1 }
                            }
                            if !extras.isEmpty {
                                nfciEvents += 1
                                tag = creditTrigger && leverageTrigger ? "CL" : (creditTrigger ? "C" : "L")
                            }
                        } else if grossDecrease >= 0.05, let ram,
                                  [3, 4, 5, 10, 11, 12, 13].contains(selectorMode) {
                            let breadth252 = Double(ram.m252.values.filter { $0 > 0 }.count) / Double(symbols.count)
                            let breadthGate: Bool
                            switch selectorMode {
                            case 10, 11: breadthGate = breadth252 >= 0.80
                            case 12, 13: breadthGate = breadth252 >= 0.999
                            default: breadthGate = true
                            }
                            var applied = false
                            if breadthGate {
                                for (symbol, priorWeight) in prior {
                                    let reduction = max(priorWeight - (target[symbol] ?? 0), 0)
                                    guard reduction > 0 else { continue }
                                    let positiveTrend = (ram.m60[symbol] ?? -1) > 0 && (ram.m252[symbol] ?? -1) > 0
                                    let consensusMode = selectorMode == 4 || selectorMode == 11 || selectorMode == 13
                                    let qualifies = consensusMode
                                        ? ram.longTop.contains(symbol) && ram.shortTop.contains(symbol) && positiveTrend
                                        : ram.longTop.contains(symbol) && positiveTrend
                                    if qualifies {
                                        extras[symbol] = 0.25 * reduction
                                        applied = true
                                    }
                                }
                            }
                            if applied {
                                residualEvents += 1
                                let consensusMode = selectorMode == 4 || selectorMode == 11 || selectorMode == 13
                                tag = consensusMode ? "RC" : "RL"
                            }
                        }

                        let desired = extras.values.reduce(0, +)
                        if desired > 0 {
                            let cash = max(1.0 - proposedGross, 0)
                            let scale = min(1.0, cash / desired)
                            for (symbol, extra) in extras { target[symbol, default: 0] += extra * scale }
                            eventDates.append((tag ?? "?") + ":" + signalKey)
                        }
                        let gross = target.values.reduce(0, +)
                        if gross > 1.0, gross > 0 { target = target.mapValues { max($0, 0) / gross } }
                        pending = target
                        return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                    },
                    targetWeights: { _, _ in pending }
                ) else { continue }

                let points = run.report.points.filter { $0.date >= baseStartDate }
                guard let metrics = BacktestMetricsCalculator.performanceMetrics(from: points) else { continue }
                let fullRow = MetricRow(
                    title: title,
                    id: "cc_nfci_c3_l3_ram_selector",
                    annualized: metrics.annualizedReturn,
                    maxDrawdown: metrics.maxDrawdown,
                    volatility: metrics.annualizedVolatility,
                    sharpe: metrics.sharpeRatio,
                    start: points.first?.date.recordDateString ?? "n/a",
                    end: points.last?.date.recordDateString ?? "n/a",
                    pointCount: points.count
                )
                var maxTargetGross = 0.0
                var maxActualGross = 0.0
                var minCash = Double.greatestFiniteMagnitude
                var financedDays = 0
                for state in run.dailyStates where state.portfolioValue > 0 && state.date >= baseStartDate {
                    maxTargetGross = max(maxTargetGross, state.targetWeights.values.reduce(0, +))
                    maxActualGross = max(maxActualGross, state.holdingsBySymbol.values.reduce(0, +) / state.portfolioValue)
                    minCash = min(minCash, state.cash / state.portfolioValue)
                    if state.cash < -0.0001 { financedDays += 1 }
                }
                candidates.append(.init(
                    title: title,
                    mode: selectorMode,
                    annualized: metrics.annualizedReturn ?? -1,
                    maxDrawdown: metrics.maxDrawdown,
                    volatility: metrics.annualizedVolatility ?? -1,
                    sharpe: metrics.sharpeRatio ?? -1,
                    sliceRows: metricRowsForSlices(title: title, id: "cc_nfci_c3_l3_ram_selector", points: points, fullRow: fullRow),
                    trades: run.report.trades.filter { $0.date >= baseStartDate }.count,
                    averageCash: run.report.averageCashRatio,
                    nfciEvents: nfciEvents,
                    selectiveEvents: selectiveEvents,
                    residualEvents: residualEvents,
                    eventDates: eventDates,
                    maxTargetGross: maxTargetGross,
                    maxActualGross: maxActualGross,
                    minCash: minCash == Double.greatestFiniteMagnitude ? 0 : minCash,
                    financedDays: financedDays
                ))
            }

            print("APP_CC_NFCI_C3_L3_RAM_SELECTOR_BASE")
            print(String(format: "%.6f,%.6f,%.6f,%d", (baseRun.report.annualizedReturn ?? 0) * 100, baseRun.report.maxDrawdown * 100, baseRun.report.sharpeRatio ?? 0, baseRun.report.trades.count))
            candidates.sort { lhs, rhs in
                if lhs.sharpe == rhs.sharpe { return lhs.annualized > rhs.annualized }
                return lhs.sharpe > rhs.sharpe
            }
            printSliceRows(candidates.flatMap(\.sliceRows), header: "APP_CC_NFCI_C3_L3_RAM_SELECTOR_GRID")
            print("APP_CC_NFCI_C3_L3_RAM_SELECTOR_DIAGNOSTICS")
            print("title,mode,nfci_events,selective_events,residual_events,trades,average_cash,max_target_gross,max_actual_gross,min_cash,financed_days,event_dates")
            for candidate in candidates {
                print([
                    candidate.title,
                    String(candidate.mode),
                    String(candidate.nfciEvents),
                    String(candidate.selectiveEvents),
                    String(candidate.residualEvents),
                    String(candidate.trades),
                    String(format: "%.6f", candidate.averageCash),
                    String(format: "%.9f", candidate.maxTargetGross),
                    String(format: "%.9f", candidate.maxActualGross),
                    String(format: "%.9f", candidate.minCash),
                    String(candidate.financedDays),
                    candidate.eventDates.joined(separator: "|")
                ].joined(separator: ","))
            }
            return
        }
