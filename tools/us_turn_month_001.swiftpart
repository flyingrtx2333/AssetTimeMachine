        if ProcessInfo.processInfo.environment["ATM_US_TURN_MONTH_001"] == "1" {
            let formal = ProcessInfo.processInfo.environment["ATM_US_TURN_MONTH_001_FORMAL"] == "1"
            let outputDir = ProcessInfo.processInfo.environment["ATM_US_TURN_MONTH_001_OUTPUT_DIR"]
            let tradeSymbols = ["nasdaq", "sp500"]
            let options = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = tradeSymbols.compactMap { options[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }
            guard inputs.count == tradeSymbols.count,
                  let calendarSeries = seriesBySymbol["sp500"] else {
                print("US_TURN_MONTH_001_INPUTS_MISSING")
                return
            }

            let evaluationStart = "2000-01-04"
            let evaluationEnd = "2026-08-20"
            let validTradingDates = calendarSeries.dates.filter { $0 >= evaluationStart && $0 <= evaluationEnd }
            let activeExecutionDates = USTurnMonth001Logic.activeExecutionDates(tradingDates: validTradingDates)
            guard !activeExecutionDates.isEmpty else {
                print("US_TURN_MONTH_001_CALENDAR_FAILED")
                return
            }

            let primarySettings = AdvancedBacktestRiskSettings(
                feeRate: 0.005,
                slippageRate: 0,
                maxPositionRatio: 100,
                cooldownDays: 0,
                stopLossRatio: 0,
                takeProfitRatio: 0
            )
            let stressSettings = AdvancedBacktestRiskSettings(
                feeRate: 0.005,
                slippageRate: 0.05,
                maxPositionRatio: 100,
                cooldownDays: 0,
                stopLossRatio: 0,
                takeProfitRatio: 0
            )

            func config(_ id: String) -> ResearchTargetStrategyConfig {
                ResearchTargetStrategyConfig(
                    symbol: id,
                    title: "美股月末月初001",
                    warmupSessions: 2,
                    rebalanceSessions: 1,
                    rebalanceBand: 0,
                    maxGrossExposure: 1,
                    allowsFinancedExposure: false,
                    financingAnnualRate: 0,
                    buyReason: "经典月末月初四收益日窗口"
                )
            }

            enum PathMode { case turnMonth, restMonth, cash }

            func targetFor(_ context: StrategyTargetContext, mode: PathMode) -> [String: Double] {
                guard mode != .cash else { return [:] }
                let isTurnMonth = activeExecutionDates.contains(context.date.recordDateString)
                if mode == .turnMonth && !isTurnMonth { return [:] }
                if mode == .restMonth && isTurnMonth { return [:] }
                return ["nasdaq": 0.5, "sp500": 0.5]
            }

            func runPath(_ id: String, _ mode: PathMode, _ settings: AdvancedBacktestRiskSettings) -> ResearchTargetStrategyRun? {
                var firstDecision = true
                return BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                    assetInputs: inputs,
                    initialCash: 100_000,
                    settings: settings,
                    config: config(id),
                    rebalanceDecision: { index, signalIndex, data in
                        guard data.dates.indices.contains(index) else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        if firstDecision {
                            firstDecision = false
                            return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                        }
                        guard data.dates.indices.contains(signalIndex) else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let currentTurn = activeExecutionDates.contains(data.dates[index].recordDateString)
                        let priorTurn = activeExecutionDates.contains(data.dates[signalIndex].recordDateString)
                        let currentActive: Bool
                        let priorActive: Bool
                        switch mode {
                        case .turnMonth:
                            currentActive = currentTurn
                            priorActive = priorTurn
                        case .restMonth:
                            currentActive = !currentTurn
                            priorActive = !priorTurn
                        case .cash:
                            currentActive = false
                            priorActive = false
                        }
                        return BacktestRebalanceDecision(
                            shouldRebalance: currentActive != priorActive,
                            refreshOverlay: false
                        )
                    },
                    targetWeights: { context, _ in targetFor(context, mode: mode) }
                )
            }

            guard let candidate = runPath("USTOM001-COMBINED", .turnMonth, primarySettings),
                  let restControl = runPath("C-REST-OF-MONTH", .restMonth, primarySettings),
                  let cash = runPath("C-CASH-COMBINED", .cash, primarySettings),
                  let stress = runPath("USTOM001-COMBINED-SLIP005", .turnMonth, stressSettings) else {
                print("US_TURN_MONTH_001_RUN_FAILED")
                return
            }

            let folds: [(String, String, String)] = [
                ("2000-2003", "2000-01-04", "2003-12-31"),
                ("2004-2007", "2004-01-01", "2007-12-31"),
                ("2008-2011", "2008-01-01", "2011-12-31"),
                ("2012-2015", "2012-01-01", "2015-12-31"),
                ("2016-2019", "2016-01-01", "2019-12-31"),
                ("2020-2022", "2020-01-01", "2022-12-31"),
                ("2023-latest", "2023-01-01", "9999-12-31")
            ]

            func filteredPoints(_ report: AdvancedBacktestReport) -> [BacktestSeriesPoint] {
                report.points.filter {
                    let key = $0.date.recordDateString
                    return key >= evaluationStart && key <= evaluationEnd
                }
            }

            func filteredStates(_ states: [BacktestDailyState]) -> [BacktestDailyState] {
                states.filter {
                    let key = $0.date.recordDateString
                    return key >= evaluationStart && key <= evaluationEnd
                }
            }

            func targetFingerprint(_ states: [BacktestDailyState]) -> String {
                var hash: UInt64 = 1469598103934665603
                for state in states {
                    for symbol in tradeSymbols {
                        var value = UInt64(bitPattern: Int64(((state.targetWeights[symbol] ?? 0) * 1_000_000).rounded()))
                        for _ in 0..<8 {
                            hash ^= value & UInt64(0xff)
                            hash &*= UInt64(1099511628211)
                            value >>= 8
                        }
                    }
                }
                return String(format: "%016llx", hash)
            }

            func foldMetrics(_ points: [BacktestSeriesPoint]) -> [[String: Any]] {
                folds.map { name, start, end in
                    let slice = points.filter {
                        let key = $0.date.recordDateString
                        return key >= start && key <= end
                    }
                    let metrics = BacktestMetricsCalculator.performanceMetrics(from: slice)
                    return [
                        "name": name,
                        "sessions": slice.count,
                        "cagr_percent": (metrics?.annualizedReturn ?? 0) * 100,
                        "mdd_percent": (metrics?.maxDrawdown ?? 0) * 100,
                        "sharpe": metrics?.sharpeRatio ?? 0
                    ]
                }
            }

            func pathDocument(_ id: String, _ run: ResearchTargetStrategyRun) -> [String: Any] {
                let points = filteredPoints(run.report)
                let states = filteredStates(run.dailyStates)
                let metrics = BacktestMetricsCalculator.performanceMetrics(from: points)
                let since2020 = BacktestMetricsCalculator.performanceMetrics(from: points.filter { $0.date.recordDateString >= "2020-01-01" })
                let since2022 = BacktestMetricsCalculator.performanceMetrics(from: points.filter { $0.date.recordDateString >= "2022-01-01" })
                let grosses = states.map { state in
                    guard state.portfolioValue > 0 else { return 0.0 }
                    return state.holdingsBySymbol.values.reduce(0, +) / state.portfolioValue
                }
                let activeDates = states.filter { state in tradeSymbols.contains { (state.targetWeights[$0] ?? 0) > 0 } }.map { $0.date.recordDateString }
                let startValue = points.first?.portfolioValue ?? 0
                let endValue = points.last?.portfolioValue ?? 0
                return [
                    "id": id,
                    "start": points.first?.date.recordDateString ?? "",
                    "end": points.last?.date.recordDateString ?? "",
                    "sessions": points.count,
                    "active_target_sessions": activeDates.count,
                    "first_active_target_dates": Array(activeDates.prefix(8)),
                    "cagr_percent": (metrics?.annualizedReturn ?? 0) * 100,
                    "mdd_percent": (metrics?.maxDrawdown ?? 0) * 100,
                    "volatility_percent": (metrics?.annualizedVolatility ?? 0) * 100,
                    "sharpe": metrics?.sharpeRatio ?? 0,
                    "total_return_percent": startValue > 0 ? (endValue / startValue - 1) * 100 : 0,
                    "trades": run.report.trades.filter {
                        let key = $0.date.recordDateString
                        return key >= evaluationStart && key <= evaluationEnd
                    }.count,
                    "first_trade_dates": Array(run.report.trades.filter {
                        let key = $0.date.recordDateString
                        return key >= evaluationStart && key <= evaluationEnd
                    }.prefix(8).map { $0.date.recordDateString }),
                    "average_cash_ratio": states.isEmpty ? 0 : states.reduce(0.0) { partial, state in
                        partial + (state.portfolioValue > 0 ? state.cash / state.portfolioValue : 0)
                    } / Double(states.count),
                    "max_gross": grosses.max() ?? 0,
                    "minimum_cash": states.map(\.cash).min() ?? 0,
                    "target_fingerprint": targetFingerprint(states),
                    "since2020_cagr_percent": (since2020?.annualizedReturn ?? 0) * 100,
                    "since2020_sharpe": since2020?.sharpeRatio ?? 0,
                    "since2022_cagr_percent": (since2022?.annualizedReturn ?? 0) * 100,
                    "since2022_sharpe": since2022?.sharpeRatio ?? 0,
                    "folds": foldMetrics(points)
                ]
            }

            let candidateDoc = pathDocument("USTOM001-COMBINED", candidate)
            let restDoc = pathDocument("C-REST-OF-MONTH", restControl)
            let cashDoc = pathDocument("C-CASH-COMBINED", cash)
            let stressDoc = pathDocument("USTOM001-COMBINED-SLIP005", stress)

            if !formal {
                let actualActive = Set((candidateDoc["first_active_target_dates"] as? [String]) ?? [])
                let expectedFirst = Set(activeExecutionDates.sorted().prefix(8))
                let trades = candidateDoc["trades"] as? Int ?? 0
                let maxGross = candidateDoc["max_gross"] as? Double ?? 0
                let minCash = candidateDoc["minimum_cash"] as? Double ?? -1
                print("US_TURN_MONTH_001_SMOKE_EXPECTED_FIRST_ACTIVE=\(Array(expectedFirst).sorted().joined(separator: ","))")
                print("US_TURN_MONTH_001_SMOKE_ACTUAL_FIRST_ACTIVE=\(Array(actualActive).sorted().joined(separator: ","))")
                print("US_TURN_MONTH_001_SMOKE_TRADE_COUNT=\(trades)")
                print("US_TURN_MONTH_001_SMOKE_MAX_GROSS=\(String(format: "%.10f", maxGross))")
                print("US_TURN_MONTH_001_SMOKE_MIN_CASH=\(String(format: "%.6f", minCash))")
                guard actualActive == expectedFirst, trades > 0, maxGross <= 1.0000000001, minCash >= -0.000001 else {
                    print("US_TURN_MONTH_001_SMOKE_INVALID")
                    return
                }
                print("US_TURN_MONTH_001_SMOKE_OK")
                return
            }

            if let outputDir {
                try? FileManager.default.createDirectory(atPath: outputDir, withIntermediateDirectories: true)
                for (id, run) in [("USTOM001-COMBINED", candidate), ("C-REST-OF-MONTH", restControl), ("C-CASH-COMBINED", cash), ("USTOM001-COMBINED-SLIP005", stress)] {
                    let points = filteredPoints(run.report)
                    var lines = ["date,portfolio_value"]
                    lines.append(contentsOf: points.map { "\($0.date.recordDateString),\(String(format: "%.10f", $0.portfolioValue))" })
                    let path = URL(fileURLWithPath: outputDir).appendingPathComponent("\(id)-portfolio.csv").path
                    try? (lines.joined(separator: "\n") + "\n").write(toFile: path, atomically: true, encoding: .utf8)
                }
            }

            let document: [String: Any] = [
                "trial_id": "ATM-SVP3-US-TURN-MONTH-001",
                "candidate_id": "S-US-TURN-MONTH-001",
                "candidate": candidateDoc,
                "rest_of_month_control": restDoc,
                "cash_control": cashDoc,
                "slippage_stress": stressDoc,
                "expected_active_execution_dates": activeExecutionDates.sorted(),
                "fee_rate_per_fill": 0.00005,
                "primary_slippage_rate_per_fill": 0.0,
                "stress_slippage_rate_per_fill": 0.0005,
                "evaluation_start": evaluationStart,
                "evaluation_end": evaluationEnd,
                "calendar_rule": "hold after penultimate and last month-end closes plus first two next-month closes; exit at third next-month close to capture canonical last-day + first-three-day close-to-close returns"
            ]
            guard JSONSerialization.isValidJSONObject(document),
                  let json = try? JSONSerialization.data(withJSONObject: document, options: [.sortedKeys]),
                  let text = String(data: json, encoding: .utf8) else {
                print("US_TURN_MONTH_001_JSON_FAILED")
                return
            }
            print("US_TURN_MONTH_001_FORMAL_JSON=" + text)
            print("US_TURN_MONTH_001_FORMAL_OK")
            return
        }
