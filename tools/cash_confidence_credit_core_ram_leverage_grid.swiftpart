        if ProcessInfo.processInfo.environment["ATM_CC_CREDIT_CORE_RAM_LEVERAGE_GRID"] == "1" {
            struct CreditCoreRAMLeverageCandidate {
                let title: String
                let leverageRetention: Double
                let ramMode: Int
                let bothBoost: Double
                let annualized: Double
                let maxDrawdown: Double
                let volatility: Double
                let sharpe: Double
                let sliceRows: [SliceMetricRow]
                let trades: Int
                let creditEvents: Int
                let leverageAddedEvents: Int
                let bothBoostEvents: Int
                let eventDates: [String]
                let averageCash: Double
                let maxTargetGross: Double
                let maxActualGross: Double
                let minCash: Double
                let financedDays: Int
            }

            func loadCreditCoreSeries(_ path: String) -> [(releaseDate: String, value: Double)] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [] }
                return text.split(whereSeparator: \.isNewline).dropFirst().compactMap { line in
                    let fields = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard fields.count >= 3, let value = Double(fields[2]), value.isFinite else { return nil }
                    return (String(fields[0]), value)
                }.sorted { $0.0 < $1.0 }
            }
            let creditSeries = loadCreditCoreSeries("tools/research-results/NFCICREDIT_initial_release.csv")
            let leverageSeries = loadCreditCoreSeries("tools/research-results/NFCILEVERAGE_initial_release.csv")
            guard creditSeries.count >= 700, leverageSeries.count >= 700 else {
                print("APP_CC_CREDIT_CORE_RAM_LEVERAGE_GRID\nseries_missing")
                return
            }
            func creditCoreChange(_ series: [(releaseDate: String, value: Double)], on signalDate: String, lookback: Int) -> Double? {
                var latest: Int?
                for index in series.indices {
                    if series[index].releaseDate <= signalDate { latest = index } else { break }
                }
                guard let latest, latest >= lookback else { return nil }
                return series[latest].value - series[latest - lookback].value
            }

            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceLowNoise
            let optionsBySymbol = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { optionsBySymbol[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }
            guard let baseRun = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                assetInputs: inputs,
                initialCash: 100_000,
                settings: settings,
                mode: mode
            ), let baseStartDate = baseRun.report.points.first?.date else {
                print("APP_CC_CREDIT_CORE_RAM_LEVERAGE_GRID\nbase_missing")
                return
            }
            let dates = baseRun.dailyStates.map(\.date)
            let baseTargets = Dictionary(uniqueKeysWithValues: baseRun.dailyStates.map { ($0.date.recordDateString, $0.targetWeights) })
            let baseTradeDates = Set(baseRun.report.trades.map { $0.date.recordDateString })
            let dateIndex = Dictionary(uniqueKeysWithValues: dates.enumerated().map { ($0.element.recordDateString, $0.offset) })
            let symbols = ["gold_cny", "nasdaq", "sp500", "csi300", "shanghai_composite"]
            let usSymbols: Set<String> = ["nasdaq", "sp500"]

            func creditCoreBlankMA(_ values: [Double], _ period: Int) -> [Double?] { Array(repeating: nil, count: values.count) }
            func creditCoreBlankBoll(_ values: [Double], _ period: Int, _ multiplier: Double) -> [(middle: Double, lower: Double, upper: Double)?] {
                Array(repeating: nil, count: values.count)
            }
            func alignedCreditCorePrices(_ symbol: String) -> [Double]? {
                guard let input = inputs.first(where: { $0.assetOption.symbol == symbol }),
                      let prepared = BacktestAdvancedSeriesPreparer.preparedAdvancedSeries(
                        assetSeries: input.assetSeries,
                        assetOption: input.assetOption,
                        fxSeries: input.fxSeries,
                        movingAverage: creditCoreBlankMA,
                        bollingerBands: creditCoreBlankBoll
                      ) else { return nil }
                let map = Dictionary(uniqueKeysWithValues: prepared.pricePoints.map { ($0.date.recordDateString, $0.cnyPrice) })
                var output: [Double] = []
                var last: Double?
                for date in dates {
                    if let value = map[date.recordDateString], value.isFinite, value > 0 { last = value }
                    guard let value = last else { return nil }
                    output.append(value)
                }
                return output
            }
            var prices: [String: [Double]] = [:]
            for symbol in symbols {
                guard let aligned = alignedCreditCorePrices(symbol) else { return }
                prices[symbol] = aligned
            }
            func creditCoreMomentum(_ values: [Double], at index: Int, lookback: Int) -> Double? {
                guard index >= lookback, values[index - lookback] > 0 else { return nil }
                return values[index] / values[index - lookback] - 1
            }
            func creditCoreVol(_ values: [Double], at index: Int, lookback: Int) -> Double? {
                guard index >= lookback else { return nil }
                var rs: [Double] = []
                for i in (index - lookback + 1)...index {
                    guard values[i - 1] > 0 else { return nil }
                    rs.append(values[i] / values[i - 1] - 1)
                }
                let mean = rs.reduce(0, +) / Double(rs.count)
                let variance = rs.reduce(0.0) { $0 + ($1 - mean) * ($1 - mean) } / Double(max(rs.count - 1, 1))
                return sqrt(max(variance, 0))
            }
            func creditCoreRanks(_ raw: [String: Double]) -> [String: Double] {
                let ordered = raw.sorted { lhs, rhs in lhs.value == rhs.value ? lhs.key < rhs.key : lhs.value < rhs.value }
                var result: [String: Double] = [:]
                for (i, item) in ordered.enumerated() { result[item.key] = Double(i) / Double(max(ordered.count - 1, 1)) }
                return result
            }
            struct CreditCoreRAMSignal {
                let longTop: Set<String>
                let compositeTop: Set<String>
                let consensusTop: Set<String>
                let m60: [String: Double]
                let m252: [String: Double]
            }
            func creditCoreRAMSignal(at signalIndex: Int) -> CreditCoreRAMSignal? {
                guard signalIndex >= 252 else { return nil }
                var shortScore: [String: Double] = [:]
                var longScore: [String: Double] = [:]
                var m60Map: [String: Double] = [:]
                var m252Map: [String: Double] = [:]
                for symbol in symbols {
                    guard let values = prices[symbol],
                          let m60 = creditCoreMomentum(values, at: signalIndex, lookback: 60),
                          let m252 = creditCoreMomentum(values, at: signalIndex, lookback: 252),
                          let v20 = creditCoreVol(values, at: signalIndex, lookback: 20),
                          let v60 = creditCoreVol(values, at: signalIndex, lookback: 60),
                          v20 > 1e-8, v60 > 1e-8 else { return nil }
                    m60Map[symbol] = m60
                    m252Map[symbol] = m252
                    shortScore[symbol] = m60 / v20
                    longScore[symbol] = m252 / v60
                }
                let shortRank = creditCoreRanks(shortScore)
                let longRank = creditCoreRanks(longScore)
                let composite = symbols.sorted { lhs, rhs in
                    let a = 0.5 * (shortRank[lhs] ?? 0.5) + 0.5 * (longRank[lhs] ?? 0.5)
                    let b = 0.5 * (shortRank[rhs] ?? 0.5) + 0.5 * (longRank[rhs] ?? 0.5)
                    if a == b { return lhs < rhs }
                    return a > b
                }
                let shortTop = Set(shortScore.sorted { $0.value == $1.value ? $0.key < $1.key : $0.value > $1.value }.prefix(2).map { $0.key })
                let longTop = Set(longScore.sorted { $0.value == $1.value ? $0.key < $1.key : $0.value > $1.value }.prefix(2).map { $0.key })
                return .init(
                    longTop: longTop,
                    compositeTop: Set(composite.prefix(2)),
                    consensusTop: shortTop.intersection(longTop),
                    m60: m60Map,
                    m252: m252Map
                )
            }

            // RAM mode: 0 longTop + both positive; 1 compositeTop + both positive;
            // 2 short/long consensus + both positive; 3 longTop + m252>0 + m60>=-2%.
            var configs: [(String, Double, Int, Double)] = [
                ("生产冠军重放控制组", 0.00, -1, 0.00),
                ("Credit50控制", 0.00, 0, 0.00),
                ("Credit50+双触发RAM75", 0.00, 0, 0.75),
                ("Credit50+双触发RAM100", 0.00, 0, 1.00),
            ]
            for retention in [0.25, 0.50, 0.75, 1.00] {
                for ramMode in [0, 1, 2, 3] {
                    configs.append(("Credit50+L-only-RAM r\(Int(retention*100))-m\(ramMode)", retention, ramMode, 0.00))
                }
            }
            for leverageRetention in [0.25, 0.50, 0.75] {
                configs.append(("Credit50+L-RAM长+双触发75 l\(Int(leverageRetention*100))", leverageRetention, 0, 0.75))
            }

            var candidates: [CreditCoreRAMLeverageCandidate] = []
            for (title, leverageRetention, ramMode, bothBoost) in configs {
                let config = ResearchTargetStrategyConfig(
                    symbol: "cc_credit_core_ram_leverage",
                    title: title,
                    warmupSessions: 21,
                    rebalanceSessions: 1,
                    rebalanceBand: 0.244,
                    maxGrossExposure: 1.0,
                    allowsFinancedExposure: false,
                    financingAnnualRate: 0,
                    buyReason: "Credit核心+RAM确认Leverage"
                )
                var previousBase: [String: Double] = [:]
                var pending: [String: Double] = [:]
                var creditEvents = 0
                var leverageAddedEvents = 0
                var bothBoostEvents = 0
                var eventDates: [String] = []
                guard let run = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                    assetInputs: inputs,
                    initialCash: 100_000,
                    settings: settings,
                    config: config,
                    rebalanceDecision: { index, signalIndex, data in
                        guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let executionKey = data.dates[index].recordDateString
                        guard baseTradeDates.contains(executionKey), var target = baseTargets[executionKey] else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let prior = previousBase
                        previousBase = target
                        guard !prior.isEmpty else {
                            pending = target
                            return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                        }
                        if ramMode == -1 {
                            pending = target
                            return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                        }
                        let signalKey = data.dates[signalIndex].recordDateString
                        let creditTrigger = creditCoreChange(creditSeries, on: signalKey, lookback: 8).map { $0 <= -0.03 } ?? false
                        let leverageTrigger = creditCoreChange(leverageSeries, on: signalKey, lookback: 4).map { $0 <= -0.05 } ?? false
                        let priorGross = prior.values.reduce(0, +)
                        let proposedGross = target.values.reduce(0, +)
                        let priorUS = prior.reduce(0.0) { $0 + (usSymbols.contains($1.key) ? $1.value : 0) }
                        let proposedUS = target.reduce(0.0) { $0 + (usSymbols.contains($1.key) ? $1.value : 0) }
                        let usDecrease = priorUS - proposedUS
                        let grossDecrease = priorGross - proposedGross
                        if usDecrease >= 0.05, grossDecrease >= 0.03, creditTrigger || leverageTrigger {
                            let ram = dateIndex[signalKey].flatMap { creditCoreRAMSignal(at: $0) }
                            var extras: [String: Double] = [:]
                            var credited = false
                            var leverageAdded = false
                            var bothBoosted = false
                            for symbol in usSymbols {
                                let reduction = max((prior[symbol] ?? 0) - (target[symbol] ?? 0), 0)
                                guard reduction > 0 else { continue }
                                var retention = creditTrigger ? 0.50 : 0.0
                                if creditTrigger { credited = true }
                                if let ram {
                                    let m60 = ram.m60[symbol] ?? -1
                                    let m252 = ram.m252[symbol] ?? -1
                                    let positive = m60 > 0 && m252 > 0
                                    let confirms: Bool
                                    switch ramMode {
                                    case 1: confirms = ram.compositeTop.contains(symbol) && positive
                                    case 2: confirms = ram.consensusTop.contains(symbol) && positive
                                    case 3: confirms = ram.longTop.contains(symbol) && m252 > 0 && m60 >= -0.02
                                    default: confirms = ram.longTop.contains(symbol) && positive
                                    }
                                    if leverageTrigger && !creditTrigger && leverageRetention > 0 && confirms {
                                        retention = max(retention, leverageRetention)
                                        leverageAdded = true
                                    }
                                    if creditTrigger && leverageTrigger && bothBoost > 0.50 && confirms {
                                        retention = max(retention, bothBoost)
                                        bothBoosted = true
                                    }
                                }
                                if retention > 0 { extras[symbol] = retention * reduction }
                            }
                            let desired = extras.values.reduce(0, +)
                            if desired > 0 {
                                let cash = max(1.0 - proposedGross, 0)
                                let scale = min(1.0, cash / desired)
                                for (symbol, extra) in extras { target[symbol, default: 0] += extra * scale }
                                if credited { creditEvents += 1 }
                                if leverageAdded { leverageAddedEvents += 1 }
                                if bothBoosted { bothBoostEvents += 1 }
                                let tags = (credited ? "C" : "") + (leverageAdded ? "L" : "") + (bothBoosted ? "B" : "")
                                eventDates.append(tags + ":" + signalKey)
                            }
                        }
                        let gross = target.values.reduce(0, +)
                        if gross > 1, gross > 0 { target = target.mapValues { max($0, 0) / gross } }
                        pending = target
                        return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                    },
                    targetWeights: { _, _ in pending }
                ) else { continue }

                let points = run.report.points.filter { $0.date >= baseStartDate }
                guard let metrics = BacktestMetricsCalculator.performanceMetrics(from: points) else { continue }
                let fullRow = MetricRow(
                    title: title,
                    id: "cc_credit_core_ram_leverage",
                    annualized: metrics.annualizedReturn,
                    maxDrawdown: metrics.maxDrawdown,
                    volatility: metrics.annualizedVolatility,
                    sharpe: metrics.sharpeRatio,
                    start: points.first?.date.recordDateString ?? "n/a",
                    end: points.last?.date.recordDateString ?? "n/a",
                    pointCount: points.count
                )
                var maxTargetGross = 0.0
                var maxActualGross = 0.0
                var minCash = Double.greatestFiniteMagnitude
                var financedDays = 0
                for state in run.dailyStates where state.portfolioValue > 0 && state.date >= baseStartDate {
                    maxTargetGross = max(maxTargetGross, state.targetWeights.values.reduce(0, +))
                    maxActualGross = max(maxActualGross, state.holdingsBySymbol.values.reduce(0, +) / state.portfolioValue)
                    minCash = min(minCash, state.cash / state.portfolioValue)
                    if state.cash < -0.0001 { financedDays += 1 }
                }
                candidates.append(.init(
                    title: title,
                    leverageRetention: leverageRetention,
                    ramMode: ramMode,
                    bothBoost: bothBoost,
                    annualized: metrics.annualizedReturn ?? -1,
                    maxDrawdown: metrics.maxDrawdown,
                    volatility: metrics.annualizedVolatility ?? -1,
                    sharpe: metrics.sharpeRatio ?? -1,
                    sliceRows: metricRowsForSlices(title: title, id: "cc_credit_core_ram_leverage", points: points, fullRow: fullRow),
                    trades: run.report.trades.filter { $0.date >= baseStartDate }.count,
                    creditEvents: creditEvents,
                    leverageAddedEvents: leverageAddedEvents,
                    bothBoostEvents: bothBoostEvents,
                    eventDates: eventDates,
                    averageCash: run.report.averageCashRatio,
                    maxTargetGross: maxTargetGross,
                    maxActualGross: maxActualGross,
                    minCash: minCash == Double.greatestFiniteMagnitude ? 0 : minCash,
                    financedDays: financedDays
                ))
            }

            print("APP_CC_CREDIT_CORE_RAM_LEVERAGE_BASE")
            print(String(format: "%.6f,%.6f,%.6f,%d", (baseRun.report.annualizedReturn ?? 0)*100, baseRun.report.maxDrawdown*100, baseRun.report.sharpeRatio ?? 0, baseRun.report.trades.count))
            candidates.sort { lhs, rhs in
                let lhsPenalty = max(lhs.maxDrawdown - 0.08, 0) * 8
                let rhsPenalty = max(rhs.maxDrawdown - 0.08, 0) * 8
                let lhsScore = lhs.sharpe + 0.25 * lhs.annualized - lhsPenalty
                let rhsScore = rhs.sharpe + 0.25 * rhs.annualized - rhsPenalty
                if lhsScore == rhsScore { return lhs.annualized > rhs.annualized }
                return lhsScore > rhsScore
            }
            printSliceRows(candidates.flatMap(\.sliceRows), header: "APP_CC_CREDIT_CORE_RAM_LEVERAGE_GRID")
            print("APP_CC_CREDIT_CORE_RAM_LEVERAGE_DIAGNOSTICS")
            print("title,lret,mode,both_boost,credit_events,leverage_added,both_boosted,trades,average_cash,max_target_gross,max_actual_gross,min_cash,financed_days,event_dates")
            for c in candidates {
                print([
                    c.title,
                    String(format: "%.2f", c.leverageRetention),
                    String(c.ramMode),
                    String(format: "%.2f", c.bothBoost),
                    String(c.creditEvents),
                    String(c.leverageAddedEvents),
                    String(c.bothBoostEvents),
                    String(c.trades),
                    String(format: "%.6f", c.averageCash),
                    String(format: "%.9f", c.maxTargetGross),
                    String(format: "%.9f", c.maxActualGross),
                    String(format: "%.9f", c.minCash),
                    String(c.financedDays),
                    c.eventDates.joined(separator: "|")
                ].joined(separator: ","))
            }
            return
        }
