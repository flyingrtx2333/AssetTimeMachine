        if ProcessInfo.processInfo.environment["ATM_CASH_CONFIDENCE_JOINT_ADAPTIVE_REVIEW_GRID"] == "1" {
            struct JointAdaptiveReviewCandidate {
                let title: String
                let volatilityThreshold: Double
                let qualityGapThreshold: Double
                let fastReviewSessions: Int
                let annualized: Double
                let maxDrawdown: Double
                let sharpe: Double
                let trades: Int
                let averageCashRatio: Double
                let sliceRows: [SliceMetricRow]
            }

            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceRouter
            let optionsBySymbol = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { optionsBySymbol[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }
            let parameterSets: [(String, Double, Double, Int)] = [
                ("发布基线", 99.0, 0.0, 60),
                ("V8-G2-R30", 0.08, 0.02, 30),
                ("V8-G3.5-R30", 0.08, 0.035, 30),
                ("V8-G5-R30", 0.08, 0.05, 30),
                ("V8-G7-R30", 0.08, 0.07, 30),
                ("V6-G3.5-R40", 0.06, 0.035, 40),
                ("V6-G5-R40", 0.06, 0.05, 40),
            ]

            var candidates: [JointAdaptiveReviewCandidate] = []
            Darwin.setenv("ATM_CC_RECOVERY_REVIEW_SESSIONS", "60", 1)
            Darwin.setenv("ATM_CC_RECOVERY_LEADER_SHARE_CAP", "1", 1)
            for parameters in parameterSets {
                Darwin.setenv("ATM_CC_RECOVERY_FAST_REVIEW_VOL_THRESHOLD", String(parameters.1), 1)
                Darwin.setenv("ATM_CC_RECOVERY_FAST_REVIEW_QUALITY_GAP_THRESHOLD", String(parameters.2), 1)
                Darwin.setenv("ATM_CC_RECOVERY_FAST_REVIEW_SESSIONS", String(parameters.3), 1)
                guard let report = BacktestEngine.runAdvancedRotationStrategy(
                    assetInputs: inputs,
                    initialCash: 100_000,
                    settings: settings,
                    mode: mode
                ) else { continue }
                let fullRow = MetricRow(
                    title: parameters.0,
                    id: "cash_confidence_joint_adaptive_review_grid",
                    annualized: report.annualizedReturn,
                    maxDrawdown: report.maxDrawdown,
                    volatility: report.annualizedVolatility,
                    sharpe: report.sharpeRatio,
                    start: report.points.first?.date.recordDateString ?? "n/a",
                    end: report.points.last?.date.recordDateString ?? "n/a",
                    pointCount: report.points.count
                )
                candidates.append(JointAdaptiveReviewCandidate(
                    title: parameters.0,
                    volatilityThreshold: parameters.1,
                    qualityGapThreshold: parameters.2,
                    fastReviewSessions: parameters.3,
                    annualized: report.annualizedReturn ?? -1,
                    maxDrawdown: report.maxDrawdown,
                    sharpe: report.sharpeRatio ?? -1,
                    trades: report.trades.count,
                    averageCashRatio: report.averageCashRatio,
                    sliceRows: metricRowsForSlices(
                        title: parameters.0,
                        id: "cash_confidence_joint_adaptive_review_grid",
                        points: report.points,
                        fullRow: fullRow
                    )
                ))
            }

            let ranked = candidates.sorted { lhs, rhs in
                let lhsScore = lhs.sharpe + 0.5 * lhs.annualized - 0.75 * lhs.maxDrawdown
                let rhsScore = rhs.sharpe + 0.5 * rhs.annualized - 0.75 * rhs.maxDrawdown
                if lhsScore == rhsScore { return lhs.annualized > rhs.annualized }
                return lhsScore > rhsScore
            }
            printSliceRows(ranked.flatMap(\.sliceRows), header: "APP_CASH_CONFIDENCE_JOINT_ADAPTIVE_REVIEW_GRID")
            print("APP_CASH_CONFIDENCE_JOINT_ADAPTIVE_REVIEW_DIAGNOSTICS")
            print("title,volatility_threshold,quality_gap_threshold,fast_review_sessions,annualized,max_drawdown,sharpe,trades,average_cash_ratio")
            for candidate in ranked {
                print([
                    candidate.title,
                    String(format: "%.4f", candidate.volatilityThreshold),
                    String(format: "%.4f", candidate.qualityGapThreshold),
                    String(candidate.fastReviewSessions),
                    String(format: "%.6f", candidate.annualized * 100),
                    String(format: "%.6f", candidate.maxDrawdown * 100),
                    String(format: "%.6f", candidate.sharpe),
                    String(candidate.trades),
                    String(format: "%.6f", candidate.averageCashRatio)
                ].joined(separator: ","))
            }
            return
        }
