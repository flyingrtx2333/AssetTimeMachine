        if ProcessInfo.processInfo.environment["ATM_C3L3_SIMPLE_RISK_SCALE_FRONTIER"] == "1" {
            func loadSimpleScaleSeries(_ path: String) -> [(releaseDate: String, value: Double)] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [] }
                return text.split(whereSeparator: \.isNewline).dropFirst().compactMap { line in
                    let f = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard f.count >= 3, let v = Double(f[2]), v.isFinite else { return nil }
                    return (String(f[0]), v)
                }.sorted { $0.0 < $1.0 }
            }
            func simpleScaleChange(_ s: [(releaseDate: String, value: Double)], _ d: String, _ n: Int) -> Double? {
                var latest: Int?
                for i in s.indices { if s[i].releaseDate <= d { latest = i } else { break } }
                guard let i = latest, i >= n else { return nil }
                return s[i].value - s[i-n].value
            }
            let credit = loadSimpleScaleSeries("tools/research-results/NFCICREDIT_initial_release.csv")
            let leverage = loadSimpleScaleSeries("tools/research-results/NFCILEVERAGE_initial_release.csv")
            guard credit.count >= 700, leverage.count >= 700 else { return }
            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceRouter
            let options = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { options[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { seriesBySymbol[normalizedHistorySymbol($0)] }
            }
            // Freeze the internal shadow engine at the same research cost assumptions as the product candidates.
            let frozenSettings = AdvancedBacktestRiskSettings(
                feeRate: 1.00, slippageRate: 0.05, maxPositionRatio: 100,
                cooldownDays: 0, stopLossRatio: 0, takeProfitRatio: 0
            )
            guard let base = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                assetInputs: inputs, initialCash: 100_000, settings: frozenSettings, mode: mode
            ) else { return }
            let baseTargets = Dictionary(uniqueKeysWithValues: base.dailyStates.map { ($0.date.recordDateString, $0.targetWeights) })
            let baseTradeDates = Set(base.report.trades.map { $0.date.recordDateString })
            let us: Set<String> = ["nasdaq", "sp500"]
            let scales: [Double] = [1.00, 1.10, 1.20, 1.30, 1.40, 1.50]
            print("APP_C3L3_SIMPLE_RISK_SCALE_FRONTIER")
            print("scale,cagr,mdd,vol,sharpe,trades,average_cash,events,since2020_cagr,since2020_sharpe,since2022_cagr,since2022_sharpe")
            for riskScale in scales {
                let config = ResearchTargetStrategyConfig(
                    symbol: "c3l3_simple_scale", title: "C3L3 simple scale",
                    warmupSessions: 21, rebalanceSessions: 1, rebalanceBand: 0.20,
                    maxGrossExposure: 1, allowsFinancedExposure: false, financingAnnualRate: 0,
                    buyReason: "C3L3 simple scale"
                )
                var priorBase: [String: Double] = [:]
                var pending: [String: Double] = [:]
                var events = 0
                guard let run = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                    assetInputs: inputs, initialCash: 100_000, settings: frozenSettings, config: config,
                    rebalanceDecision: { index, signalIndex, data in
                        guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let execution = data.dates[index].recordDateString
                        guard baseTradeDates.contains(execution), var target = baseTargets[execution] else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let prior = priorBase; priorBase = target
                        if !prior.isEmpty {
                            let signal = data.dates[signalIndex].recordDateString
                            let c = simpleScaleChange(credit, signal, 8).map { $0 <= -0.03 } ?? false
                            let l = simpleScaleChange(leverage, signal, 4).map { $0 <= -0.03 } ?? false
                            let priorGross = prior.values.reduce(0,+), proposedGross = target.values.reduce(0,+)
                            let priorUS = prior.reduce(0.0) { $0 + (us.contains($1.key) ? $1.value : 0) }
                            let proposedUS = target.reduce(0.0) { $0 + (us.contains($1.key) ? $1.value : 0) }
                            let usDrop = priorUS - proposedUS, grossDrop = priorGross - proposedGross
                            var extras: [String: Double] = [:]
                            if c || l {
                                if usDrop >= 0.05, grossDrop >= 0.03 {
                                    let retention = c && l ? 1.0 : 0.5
                                    for symbol in us {
                                        let reduction = max((prior[symbol] ?? 0) - (target[symbol] ?? 0), 0)
                                        if reduction > 0 { extras[symbol] = retention * reduction }
                                    }
                                } else if grossDrop >= 0.05 {
                                    for (symbol, weight) in prior {
                                        let reduction = max(weight - (target[symbol] ?? 0), 0)
                                        if reduction > 0 { extras[symbol] = reduction }
                                    }
                                }
                            }
                            let desired = extras.values.reduce(0,+)
                            if desired > 0 {
                                let scale = min(1.0, max(1.0 - proposedGross, 0) / desired)
                                for (symbol, extra) in extras { target[symbol, default: 0] += extra * scale }
                                events += 1
                            }
                        }
                        target = target.mapValues { max($0,0) * riskScale }
                        let gross = target.values.reduce(0,+)
                        if gross > 1, gross > 0 { target = target.mapValues { $0 / gross } }
                        pending = target
                        return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                    }, targetWeights: { _, _ in pending }
                ) else { continue }
                if abs(riskScale - 1.30) < 0.000001 {
                    var lines = ["date,portfolio_value"]
                    lines.append(contentsOf: run.report.points.map { point in
                        let value = String(format: "%.10f", point.portfolioValue)
                        return "\(point.date.recordDateString),\(value)"
                    })
                    try? (lines.joined(separator: "\n") + "\n").write(
                        toFile: "/private/tmp/c3l3_simple_130_panel.csv",
                        atomically: true,
                        encoding: .utf8
                    )
                }
                let m2020 = BacktestMetricsCalculator.performanceMetrics(from: run.report.points.filter { $0.date.recordDateString >= "2020-01-01" })
                let m2022 = BacktestMetricsCalculator.performanceMetrics(from: run.report.points.filter { $0.date.recordDateString >= "2022-01-01" })
                print([
                    String(format:"%.2f",riskScale), String(format:"%.6f",(run.report.annualizedReturn ?? 0)*100),
                    String(format:"%.6f",run.report.maxDrawdown*100), String(format:"%.6f",(run.report.annualizedVolatility ?? 0)*100),
                    String(format:"%.6f",run.report.sharpeRatio ?? 0), String(run.report.trades.count), String(format:"%.6f",run.report.averageCashRatio),
                    String(events), String(format:"%.6f",(m2020?.annualizedReturn ?? 0)*100), String(format:"%.6f",m2020?.sharpeRatio ?? 0),
                    String(format:"%.6f",(m2022?.annualizedReturn ?? 0)*100), String(format:"%.6f",m2022?.sharpeRatio ?? 0)
                ].joined(separator:","))
            }
            return
        }
