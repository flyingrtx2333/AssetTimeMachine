                .init(id: "ts_trend_equal_252", title: "绝对趋势等权252", family: .timeSeriesTrendEqual, rebalanceSessions: 63, rebalanceBand: 0.08, p1: 252, p2: 200, p3: 0.95, intParam: 0),
                .init(id: "ts_trend_iv_252", title: "绝对趋势逆波动252", family: .timeSeriesTrendInverseVol, rebalanceSessions: 63, rebalanceBand: 0.08, p1: 252, p2: 200, p3: 0.95, intParam: 0),

