                .init(id: "xmom_top2_126", title: "横截面动量Top2-126", family: .crossSectionMomentum, rebalanceSessions: 63, rebalanceBand: 0.10, p1: 126, p2: 0, p3: 0.95, intParam: 2),
                .init(id: "xmom_top2_blend", title: "横截面动量Top2-126/252", family: .crossSectionMomentum, rebalanceSessions: 63, rebalanceBand: 0.10, p1: 126, p2: 252, p3: 0.95, intParam: 2),

