                .init(id: "meanrev_us_7", title: "美股趋势内逆向抄底7%", family: .meanReversionDip, rebalanceSessions: 21, rebalanceBand: 0.08, p1: -0.07, p2: 0.90, p3: 0, intParam: 0),
                .init(id: "meanrev_global_5_confirm", title: "全球趋势内反转确认抄底5%", family: .meanReversionDip, rebalanceSessions: 21, rebalanceBand: 0.08, p1: -0.05, p2: 0.85, p3: 0, intParam: 2),

