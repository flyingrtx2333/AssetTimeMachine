                .init(id: "vol_contract_breakout_085", title: "波动收缩突破0.85", family: .volatilityContractionBreakout, rebalanceSessions: 21, rebalanceBand: 0.10, p1: 0.85, p2: 126, p3: 0.90, intParam: 0),
                .init(id: "donchian_63", title: "跨资产唐奇安突破63", family: .donchianBreakout, rebalanceSessions: 21, rebalanceBand: 0.10, p1: 63, p2: 0, p3: 0.90, intParam: 0),
                .init(id: "donchian_126", title: "跨资产唐奇安突破126", family: .donchianBreakout, rebalanceSessions: 21, rebalanceBand: 0.10, p1: 126, p2: 0, p3: 0.90, intParam: 0),

                .init(id: "risk_parity_iv63", title: "核心三资产逆波动63", family: .inverseVolRiskParity, rebalanceSessions: 21, rebalanceBand: 0.04, p1: 63, p2: 0.95, p3: 0, intParam: 0),
                .init(id: "risk_parity_iv126", title: "核心三资产逆波动126", family: .inverseVolRiskParity, rebalanceSessions: 63, rebalanceBand: 0.04, p1: 126, p2: 0.95, p3: 0, intParam: 0),
                .init(id: "gmv_63", title: "核心三资产最小方差63", family: .minimumVariance, rebalanceSessions: 21, rebalanceBand: 0.04, p1: 63, p2: 0.95, p3: 0, intParam: 0),
                .init(id: "gmv_126", title: "核心三资产最小方差126", family: .minimumVariance, rebalanceSessions: 63, rebalanceBand: 0.04, p1: 126, p2: 0.95, p3: 0, intParam: 0),

                .init(id: "breadth_150", title: "全球宽度状态150", family: .globalBreadthRegime, rebalanceSessions: 21, rebalanceBand: 0.08, p1: 150, p2: 0.95, p3: 0.55, intParam: 0),
