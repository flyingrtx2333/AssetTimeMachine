        if ProcessInfo.processInfo.environment["ATM_CASH_CONFIDENCE_EQUITY_CURVE_STATE_GRID"] == "1" {
            struct EquityCurveStateCandidate {
                let title: String
                let maPeriod: Int
                let momentumLookback: Int
                let riskScale: Double
                let confirmationSessions: Int
                let annualized: Double
                let maxDrawdown: Double
                let sharpe: Double
                let trades: Int
                let averageCashRatio: Double
                let sliceRows: [SliceMetricRow]
            }

            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceRouter
            let optionsBySymbol = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { optionsBySymbol[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }
            let parameterSets: [(String, Int, Int, Double, Int)] = [
                ("新冠军基线", 200, 63, 1.00, 5),
                ("MA200-M63-空仓", 200, 63, 0.00, 5),
                ("MA200-M63-半仓", 200, 63, 0.50, 5),
                ("MA200-M63-保留75%", 200, 63, 0.75, 5),
                ("MA126-M63-半仓", 126, 63, 0.50, 5),
                ("MA200-M126-半仓", 200, 126, 0.50, 5),
                ("MA200-M63-确认10", 200, 63, 0.50, 10),
            ]

            Darwin.setenv("ATM_CC_RECOVERY_FAST_BREAK_THRESHOLD", "-0.05", 1)
            Darwin.setenv("ATM_CC_RECOVERY_COOLDOWN_SESSIONS", "150", 1)
            Darwin.setenv("ATM_CC_RECOVERY_MIN_HOLD_SESSIONS", "10", 1)
            Darwin.setenv("ATM_CC_RECOVERY_MIN_WATER_DURATION", "60", 1)
            Darwin.setenv("ATM_CC_RECOVERY_MIN_DRAWDOWN", "0.05", 1)
            Darwin.setenv("ATM_CC_RECOVERY_MAX_ENTRIES", "2", 1)
            Darwin.setenv("ATM_CC_RECOVERY_REVIEW_SESSIONS", "60", 1)
            Darwin.setenv("ATM_CC_RECOVERY_LEADER_SHARE_CAP", "1", 1)
            Darwin.setenv("ATM_CC_RECOVERY_FAST_REVIEW_VOL_THRESHOLD", "99", 1)
            Darwin.setenv("ATM_CC_RECOVERY_FAST_REVIEW_QUALITY_GAP_THRESHOLD", "99", 1)
            Darwin.setenv("ATM_CC_RECOVERY_LEADER_SWITCH_MIN_SESSIONS", "10000", 1)
            Darwin.setenv("ATM_CC_PORTFOLIO_VOL_TARGET", "99", 1)
            Darwin.setenv("ATM_CC_CALM_CARRY_CAP", "0", 1)
            Darwin.setenv("ATM_CC_CALM_RISK_VOL_FLOOR", "0", 1)
            Darwin.setenv("ATM_CC_SECULAR_CARRY_CAP", "0", 1)
            Darwin.setenv("ATM_CC_GOLD_TO_US_SHIFT_FRACTION", "0", 1)

            var candidates: [EquityCurveStateCandidate] = []
            for parameters in parameterSets {
                Darwin.setenv("ATM_CC_EQUITY_CURVE_MA_PERIOD", String(parameters.1), 1)
                Darwin.setenv("ATM_CC_EQUITY_CURVE_MOMENTUM_LOOKBACK", String(parameters.2), 1)
                Darwin.setenv("ATM_CC_EQUITY_CURVE_RISK_SCALE", String(parameters.3), 1)
                Darwin.setenv("ATM_CC_EQUITY_CURVE_CONFIRMATION_SESSIONS", String(parameters.4), 1)
                guard let report = BacktestEngine.runAdvancedRotationStrategy(
                    assetInputs: inputs,
                    initialCash: 100_000,
                    settings: settings,
                    mode: mode
                ) else { continue }
                let fullRow = MetricRow(
                    title: parameters.0,
                    id: "cash_confidence_equity_curve_state_grid",
                    annualized: report.annualizedReturn,
                    maxDrawdown: report.maxDrawdown,
                    volatility: report.annualizedVolatility,
                    sharpe: report.sharpeRatio,
                    start: report.points.first?.date.recordDateString ?? "n/a",
                    end: report.points.last?.date.recordDateString ?? "n/a",
                    pointCount: report.points.count
                )
                candidates.append(EquityCurveStateCandidate(
                    title: parameters.0,
                    maPeriod: parameters.1,
                    momentumLookback: parameters.2,
                    riskScale: parameters.3,
                    confirmationSessions: parameters.4,
                    annualized: report.annualizedReturn ?? -1,
                    maxDrawdown: report.maxDrawdown,
                    sharpe: report.sharpeRatio ?? -1,
                    trades: report.trades.count,
                    averageCashRatio: report.averageCashRatio,
                    sliceRows: metricRowsForSlices(
                        title: parameters.0,
                        id: "cash_confidence_equity_curve_state_grid",
                        points: report.points,
                        fullRow: fullRow
                    )
                ))
            }

            let ranked = candidates.sorted { lhs, rhs in
                let lhsScore = lhs.sharpe + 0.5 * lhs.annualized - 0.75 * lhs.maxDrawdown
                let rhsScore = rhs.sharpe + 0.5 * rhs.annualized - 0.75 * rhs.maxDrawdown
                if lhsScore == rhsScore { return lhs.annualized > rhs.annualized }
                return lhsScore > rhsScore
            }
            printSliceRows(ranked.flatMap(\.sliceRows), header: "APP_CASH_CONFIDENCE_EQUITY_CURVE_STATE_GRID")
            print("APP_CASH_CONFIDENCE_EQUITY_CURVE_STATE_DIAGNOSTICS")
            print("title,ma_period,momentum_lookback,risk_scale,confirmation_sessions,annualized,max_drawdown,sharpe,trades,average_cash_ratio")
            for candidate in ranked {
                print([
                    candidate.title,
                    String(candidate.maPeriod),
                    String(candidate.momentumLookback),
                    String(format: "%.4f", candidate.riskScale),
                    String(candidate.confirmationSessions),
                    String(format: "%.6f", candidate.annualized * 100),
                    String(format: "%.6f", candidate.maxDrawdown * 100),
                    String(format: "%.6f", candidate.sharpe),
                    String(candidate.trades),
                    String(format: "%.6f", candidate.averageCashRatio)
                ].joined(separator: ","))
            }
            return
        }
