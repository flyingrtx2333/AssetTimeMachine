        if ProcessInfo.processInfo.environment["ATM_CC_NFCI_C3_L3_STATE_DUMP"] == "1" {
            func loadC3L3StateSeries(_ path: String) -> [(releaseDate: String, value: Double)] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [] }
                return text.split(whereSeparator: \.isNewline).dropFirst().compactMap { line in
                    let fields = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard fields.count >= 3, let value = Double(fields[2]), value.isFinite else { return nil }
                    return (String(fields[0]), value)
                }.sorted { $0.0 < $1.0 }
            }
            func c3L3StateChange(_ series: [(releaseDate: String, value: Double)], on date: String, lookback: Int) -> Double? {
                var latest: Int?
                for index in series.indices {
                    if series[index].releaseDate <= date { latest = index } else { break }
                }
                guard let latest, latest >= lookback else { return nil }
                return series[latest].value - series[latest - lookback].value
            }

            let creditSeries = loadC3L3StateSeries("tools/research-results/NFCICREDIT_initial_release.csv")
            let leverageSeries = loadC3L3StateSeries("tools/research-results/NFCILEVERAGE_initial_release.csv")
            guard creditSeries.count >= 700, leverageSeries.count >= 700 else {
                print("APP_CC_NFCI_C3_L3_STATE_DUMP\nseries_missing")
                return
            }

            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceLowNoise
            let optionsBySymbol = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { optionsBySymbol[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }
            guard let baseRun = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                assetInputs: inputs,
                initialCash: 100_000,
                settings: settings,
                mode: mode
            ) else {
                print("APP_CC_NFCI_C3_L3_STATE_DUMP\nbase_missing")
                return
            }

            let baseTargets = Dictionary(uniqueKeysWithValues: baseRun.dailyStates.map { ($0.date.recordDateString, $0.targetWeights) })
            let baseTradeDates = Set(baseRun.report.trades.map { $0.date.recordDateString })
            let usSymbols: Set<String> = ["nasdaq", "sp500"]
            let researchConfig = ResearchTargetStrategyConfig(
                symbol: "cc_nfci_c3_l3_state_dump",
                title: "C3L3 Generic100 state dump",
                warmupSessions: 21,
                rebalanceSessions: 1,
                rebalanceBand: 0.244,
                maxGrossExposure: 1.0,
                allowsFinancedExposure: false,
                financingAnnualRate: 0,
                buyReason: "C3L3 state dump"
            )
            var previousBase: [String: Double] = [:]
            var pending: [String: Double] = [:]
            var overlayExecutionDates = Set<String>()
            var overlaySignalByExecutionDate: [String: String] = [:]
            guard let run = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                assetInputs: inputs,
                initialCash: 100_000,
                settings: settings,
                config: researchConfig,
                rebalanceDecision: { index, signalIndex, data in
                    guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else {
                        return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                    }
                    let executionKey = data.dates[index].recordDateString
                    guard baseTradeDates.contains(executionKey), var target = baseTargets[executionKey] else {
                        return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                    }
                    let prior = previousBase
                    previousBase = target
                    guard !prior.isEmpty else {
                        pending = target
                        return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                    }
                    let signalKey = data.dates[signalIndex].recordDateString
                    let credit = c3L3StateChange(creditSeries, on: signalKey, lookback: 8).map { $0 <= -0.03 } ?? false
                    let leverage = c3L3StateChange(leverageSeries, on: signalKey, lookback: 4).map { $0 <= -0.03 } ?? false
                    let priorGross = prior.values.reduce(0, +)
                    let proposedGross = target.values.reduce(0, +)
                    let priorUS = prior.reduce(0.0) { $0 + (usSymbols.contains($1.key) ? $1.value : 0) }
                    let proposedUS = target.reduce(0.0) { $0 + (usSymbols.contains($1.key) ? $1.value : 0) }
                    let usDecrease = priorUS - proposedUS
                    let grossDecrease = priorGross - proposedGross
                    var extras: [String: Double] = [:]
                    if credit || leverage {
                        if usDecrease >= 0.05, grossDecrease >= 0.03 {
                            let retention = credit && leverage ? 1.00 : 0.50
                            for symbol in usSymbols {
                                let reduction = max((prior[symbol] ?? 0) - (target[symbol] ?? 0), 0)
                                if reduction > 0 { extras[symbol] = retention * reduction }
                            }
                        } else if grossDecrease >= 0.05 {
                            for (symbol, priorWeight) in prior {
                                let reduction = max(priorWeight - (target[symbol] ?? 0), 0)
                                if reduction > 0 { extras[symbol] = reduction }
                            }
                        }
                    }
                    let desired = extras.values.reduce(0, +)
                    if desired > 0 {
                        let cash = max(1.0 - proposedGross, 0)
                        let scale = min(1.0, cash / desired)
                        for (symbol, extra) in extras { target[symbol, default: 0] += extra * scale }
                        overlayExecutionDates.insert(executionKey)
                        overlaySignalByExecutionDate[executionKey] = signalKey
                    }
                    let gross = target.values.reduce(0, +)
                    if gross > 1.0, gross > 0 { target = target.mapValues { max($0, 0) / gross } }
                    pending = target
                    return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                },
                targetWeights: { _, _ in pending }
            ) else {
                print("APP_CC_NFCI_C3_L3_STATE_DUMP\nresearch_run_missing")
                return
            }

            func blankC3L3StateMA(_ values: [Double], _ period: Int) -> [Double?] {
                Array(repeating: nil, count: values.count)
            }
            func blankC3L3StateBoll(_ values: [Double], _ period: Int, _ multiplier: Double) -> [(middle: Double, lower: Double, upper: Double)?] {
                Array(repeating: nil, count: values.count)
            }
            let symbols = ["gold_cny", "nasdaq", "sp500", "csi300", "shanghai_composite"]
            var priceMaps: [String: [String: Double]] = [:]
            for symbol in symbols {
                guard let input = inputs.first(where: { $0.assetOption.symbol == symbol }),
                      let prepared = BacktestAdvancedSeriesPreparer.preparedAdvancedSeries(
                        assetSeries: input.assetSeries,
                        assetOption: input.assetOption,
                        fxSeries: input.fxSeries,
                        movingAverage: blankC3L3StateMA,
                        bollingerBands: blankC3L3StateBoll
                      ) else {
                    print("APP_CC_NFCI_C3_L3_STATE_DUMP\nprice_missing_\(symbol)")
                    return
                }
                priceMaps[symbol] = Dictionary(uniqueKeysWithValues: prepared.pricePoints.map { ($0.date.recordDateString, $0.cnyPrice) })
            }

            var lastPrices: [String: Double] = [:]
            var lines: [String] = []
            lines.reserveCapacity(run.dailyStates.count + 1)
            lines.append([
                "date", "portfolio_value", "cash_ratio", "target_gross", "actual_gross",
                "overlay_event", "overlay_signal_date",
                "target_gold", "target_nasdaq", "target_sp500", "target_csi300", "target_shanghai",
                "price_gold", "price_nasdaq", "price_sp500", "price_csi300", "price_shanghai"
            ].joined(separator: ","))
            for state in run.dailyStates where state.portfolioValue > 0 {
                let dateKey = state.date.recordDateString
                for symbol in symbols {
                    if let value = priceMaps[symbol]?[dateKey], value.isFinite, value > 0 { lastPrices[symbol] = value }
                }
                guard symbols.allSatisfy({ lastPrices[$0] != nil }) else { continue }
                let targetGross = state.targetWeights.values.reduce(0, +)
                let actualGross = state.holdingsBySymbol.values.reduce(0, +) / state.portfolioValue
                let row: [String] = [
                    dateKey,
                    String(format: "%.10f", state.portfolioValue),
                    String(format: "%.10f", state.cash / state.portfolioValue),
                    String(format: "%.10f", targetGross),
                    String(format: "%.10f", actualGross),
                    overlayExecutionDates.contains(dateKey) ? "1" : "0",
                    overlaySignalByExecutionDate[dateKey] ?? "",
                    String(format: "%.10f", state.targetWeights["gold_cny"] ?? 0),
                    String(format: "%.10f", state.targetWeights["nasdaq"] ?? 0),
                    String(format: "%.10f", state.targetWeights["sp500"] ?? 0),
                    String(format: "%.10f", state.targetWeights["csi300"] ?? 0),
                    String(format: "%.10f", state.targetWeights["shanghai_composite"] ?? 0),
                    String(format: "%.10f", lastPrices["gold_cny"] ?? 0),
                    String(format: "%.10f", lastPrices["nasdaq"] ?? 0),
                    String(format: "%.10f", lastPrices["sp500"] ?? 0),
                    String(format: "%.10f", lastPrices["csi300"] ?? 0),
                    String(format: "%.10f", lastPrices["shanghai_composite"] ?? 0)
                ]
                lines.append(row.joined(separator: ","))
            }
            let outputPath = ProcessInfo.processInfo.environment["ATM_CC_NFCI_C3_L3_STATE_DUMP_PATH"] ?? "/private/tmp/c3l3_state_panel.csv"
            do {
                try (lines.joined(separator: "\n") + "\n").write(toFile: outputPath, atomically: true, encoding: .utf8)
                print("APP_CC_NFCI_C3_L3_STATE_DUMP")
                print("path=\(outputPath),rows=\(max(lines.count - 1, 0)),events=\(overlayExecutionDates.count),annualized=\(String(format: "%.6f", (run.report.annualizedReturn ?? 0) * 100)),mdd=\(String(format: "%.6f", run.report.maxDrawdown * 100)),sharpe=\(String(format: "%.6f", run.report.sharpeRatio ?? 0)),trades=\(run.report.trades.count)")
            } catch {
                print("APP_CC_NFCI_C3_L3_STATE_DUMP\nwrite_failed=\(error)")
            }
            return
        }
