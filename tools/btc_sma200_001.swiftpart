        if ProcessInfo.processInfo.environment["ATM_BTC_SMA200_001"] == "1" {
            let formal = ProcessInfo.processInfo.environment["ATM_BTC_SMA200_001_FORMAL"] == "1"
            let outputDir = ProcessInfo.processInfo.environment["ATM_BTC_SMA200_001_OUTPUT_DIR"]
            let accountingSymbols = ["btc_cny"]

            func loadBTCCNY(path: String, fx: PublicHistorySeries) -> PublicHistorySeries? {
                guard let data = FileManager.default.contents(atPath: path),
                      let rows = try? JSONSerialization.jsonObject(with: data) as? [[Any]] else { return nil }
                let fxPairs = Array(zip(fx.dates, fx.prices)).sorted { $0.0 < $1.0 }
                guard !fxPairs.isEmpty else { return nil }
                var dates: [String] = []
                var prices: [Double] = []
                var fxIndex = 0
                var latestFX: Double? = nil
                let formatter = DateFormatter(); formatter.calendar = Calendar(identifier: .gregorian); formatter.locale = Locale(identifier: "en_US_POSIX"); formatter.timeZone = TimeZone(secondsFromGMT: 0); formatter.dateFormat = "yyyy-MM-dd"
                for row in rows {
                    guard row.count >= 5,
                          let ts = (row[0] as? NSNumber)?.doubleValue,
                          let closeText = row[4] as? String,
                          let usdtClose = Double(closeText), usdtClose.isFinite, usdtClose > 0 else { continue }
                    let dateKey = formatter.string(from: Date(timeIntervalSince1970: ts / 1000.0))
                    while fxIndex < fxPairs.count, fxPairs[fxIndex].0 <= dateKey {
                        let value = fxPairs[fxIndex].1
                        if value.isFinite, value > 0 { latestFX = value }
                        fxIndex += 1
                    }
                    guard let latestFX else { continue }
                    dates.append(dateKey)
                    prices.append(usdtClose / latestFX)
                }
                guard dates.count >= 2000, dates.count == prices.count else { return nil }
                return PublicHistorySeries(symbol: "btc_cny", category: "crypto", label: "Bitcoin CNY proxy", currency: "CNY", unit: "BTC", source: "Binance official BTCUSDT daily close · USDT treated as USD-equivalent · historical USD/CNY conversion", dates: dates, prices: prices, hasOHLC: false, ohlcSource: nil, ohlcCoverageRatio: nil, openPrices: nil, highPrices: nil, lowPrices: nil, closePrices: nil, volumes: nil)
            }

            guard let fx = seriesBySymbol["usd_per_cny"],
                  let btc = loadBTCCNY(path: "tools/research-results/strategy-validation/factor-data/BTCUSDT-BINANCE-2026-08-23/BTCUSDT-1d.json", fx: fx),
                  let supportOption = BacktestDefaults.strategyAssetOptions.first(where: { $0.symbol == "sp500" }) else { print("BTC_SMA200_001_INPUTS_MISSING"); return }
            let btcOption = BacktestAssetOption(symbol: "btc_cny", title: "Bitcoin", color: AssetTheme.accentOrange, requiresHistoricalFX: false, historicalFXSymbol: nil, category: "crypto", currency: "CNY")
            var inputs = [(assetSeries: Optional(btc), assetOption: btcOption, fxSeries: Optional<PublicHistorySeries>.none)]
            inputs.append(BacktestEngine.advancedAssetInput(for: supportOption) { symbol in seriesBySymbol[normalizedHistorySymbol(symbol)] })

            let settings = AdvancedBacktestRiskSettings(feeRate: 1.00, slippageRate: 0.05, maxPositionRatio: 100, cooldownDays: 0, stopLossRatio: 0, takeProfitRatio: 0)
            let formatter = DateFormatter(); formatter.calendar = BacktestSeriesAlignment.historicalSeriesCalendar; formatter.locale = Locale(identifier: "en_US_POSIX"); formatter.timeZone = BacktestSeriesAlignment.historicalSeriesCalendar.timeZone; formatter.dateFormat = "yyyy-MM-dd"
            guard let start = formatter.date(from: "2018-06-05"), let end = formatter.date(from: "2026-08-20") else { print("BTC_SMA200_001_DATE_FAILED"); return }
            let bounds = start...end
            let folds: [(String,String,String)] = [
                ("2018-2019","2018-06-05","2019-12-31"), ("2020","2020-01-01","2020-12-31"), ("2021","2021-01-01","2021-12-31"),
                ("2022","2022-01-01","2022-12-31"), ("2023","2023-01-01","2023-12-31"), ("2024","2024-01-01","2024-12-31"), ("2025-latest","2025-01-01","9999-12-31")
            ]
            enum Mode { case trend, buyHold, cash }
            func config(_ id: String) -> ResearchTargetStrategyConfig { ResearchTargetStrategyConfig(symbol: id, title: "BTC SMA200 001", warmupSessions: 200, rebalanceSessions: 1, rebalanceBand: 0, maxGrossExposure: 1, allowsFinancedExposure: false, financingAnnualRate: 0, buyReason: "T-1 BTC close > trailing 200 common-session SMA") }
            func runPath(_ id: String, _ mode: Mode) -> ResearchTargetStrategyRun? {
                var firstDecision = true
                return BacktestEngine.runResearchTargetProviderStrategyWithTrace(assetInputs: inputs, initialCash: 100_000, settings: settings, config: config(id), dateBounds: bounds, rebalanceDecision: { index, signalIndex, data in
                    guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else { return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false) }
                    if firstDecision { firstDecision = false; return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false) }
                    guard mode == .trend, let prices = data.pricesBySymbol["btc_cny"] else { return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false) }
                    let now = BTCSMA200001Logic.active(signalIndex: signalIndex, prices: prices)
                    let prior = BTCSMA200001Logic.active(signalIndex: signalIndex - 1, prices: prices)
                    return BacktestRebalanceDecision(shouldRebalance: now != prior, refreshOverlay: false)
                }, targetWeights: { context, data in
                    switch mode {
                    case .cash: return [:]
                    case .buyHold: return ["btc_cny": 1.0]
                    case .trend:
                        guard let prices = data.pricesBySymbol["btc_cny"], BTCSMA200001Logic.active(signalIndex: context.signalIndex, prices: prices) == true else { return [:] }
                        return ["btc_cny": 1.0]
                    }
                })
            }
            guard let candidate = runPath("BTCSMA001", .trend), let control = runPath("C-BTC-BUYHOLD", .buyHold), let cash = runPath("C-CASH", .cash) else { print("BTC_SMA200_001_RUN_FAILED"); return }
            func pts(_ r: ResearchTargetStrategyRun) -> [BacktestSeriesPoint] { r.report.points.filter { $0.date >= start && $0.date <= end } }
            func sts(_ r: ResearchTargetStrategyRun) -> [BacktestDailyState] { r.dailyStates.filter { $0.date >= start && $0.date <= end } }
            func fp(_ ss:[BacktestDailyState]) -> String { var h:UInt64=1469598103934665603; for s in ss { for sym in accountingSymbols { var v=UInt64(bitPattern:Int64(((s.targetWeights[sym] ?? 0)*1_000_000).rounded())); for _ in 0..<8 { h ^= v & UInt64(0xff); h &*= UInt64(1099511628211); v >>= 8 } } }; return String(format:"%016llx",h) }
            func foldMetrics(_ p:[BacktestSeriesPoint])->[[String:Any]] { folds.map { name,a,b in let x=p.filter{$0.date.recordDateString>=a && $0.date.recordDateString<=b}; let m=BacktestMetricsCalculator.performanceMetrics(from:x); return ["name":name,"sessions":x.count,"cagr_percent":(m?.annualizedReturn ?? 0)*100,"mdd_percent":(m?.maxDrawdown ?? 0)*100,"sharpe":m?.sharpeRatio ?? 0] } }
            func doc(_ id:String,_ r:ResearchTargetStrategyRun)->[String:Any] { let p=pts(r),s=sts(r),m=BacktestMetricsCalculator.performanceMetrics(from:p),m20=BacktestMetricsCalculator.performanceMetrics(from:p.filter{$0.date.recordDateString>="2020-01-01"}),m22=BacktestMetricsCalculator.performanceMetrics(from:p.filter{$0.date.recordDateString>="2022-01-01"}); let g=s.map{x in x.portfolioValue>0 ? x.holdingsBySymbol.values.reduce(0,+)/x.portfolioValue:0}; return ["id":id,"start":p.first?.date.recordDateString ?? "","end":p.last?.date.recordDateString ?? "","sessions":p.count,"cagr_percent":(m?.annualizedReturn ?? 0)*100,"mdd_percent":(m?.maxDrawdown ?? 0)*100,"volatility_percent":(m?.annualizedVolatility ?? 0)*100,"sharpe":m?.sharpeRatio ?? 0,"trades":r.report.trades.count,"average_cash_ratio":r.report.averageCashRatio,"max_gross":g.max() ?? 0,"minimum_cash":s.map(\.cash).min() ?? 0,"target_fingerprint":fp(s),"since2020_cagr_percent":(m20?.annualizedReturn ?? 0)*100,"since2020_sharpe":m20?.sharpeRatio ?? 0,"since2022_cagr_percent":(m22?.annualizedReturn ?? 0)*100,"since2022_sharpe":m22?.sharpeRatio ?? 0,"folds":foldMetrics(p)] }
            let cdoc=doc("BTCSMA001",candidate), bdoc=doc("C-BTC-BUYHOLD",control), cashdoc=doc("C-CASH",cash)
            if !formal { let t=cdoc["trades"] as? Int ?? 0,g=cdoc["max_gross"] as? Double ?? 0,mc=cdoc["minimum_cash"] as? Double ?? -1; print("BTC_SMA200_001_SMOKE_TRADES=\(t)"); print("BTC_SMA200_001_SMOKE_MAX_GROSS=\(g)"); print("BTC_SMA200_001_SMOKE_MIN_CASH=\(mc)"); guard t>0,g<=1.000000001,mc >= -1e-6 else { print("BTC_SMA200_001_SMOKE_INVALID"); return }; print("BTC_SMA200_001_SMOKE_OK"); return }
            if let outputDir { try? FileManager.default.createDirectory(atPath:outputDir,withIntermediateDirectories:true); for (id,r) in [("BTCSMA001",candidate),("C-BTC-BUYHOLD",control),("C-CASH",cash)] { var lines=["date,portfolio_value"]; lines.append(contentsOf:pts(r).map{"\($0.date.recordDateString),\(String(format:"%.10f",$0.portfolioValue))"}); let path=URL(fileURLWithPath:outputDir).appendingPathComponent("\(id)-portfolio.csv").path; try?(lines.joined(separator:"\n")+"\n").write(toFile:path,atomically:true,encoding:.utf8) } }
            let out:[String:Any]=["trial_id":"ATM-SVP3-BTC-SMA200-001","candidate_id":"S-BTC-SMA200-001","candidate":cdoc,"btc_buy_hold_control":bdoc,"cash_control":cashdoc,"lookback_common_sessions":200,"fee_percent_per_trade":1.0,"slippage_percent_per_trade":0.05,"evaluation_start":"2018-06-05","evaluation_end":"2026-08-20","measurement":"Binance BTCUSDT daily close treated as USD-equivalent then converted with latest available historical USD/CNY; execution calendar restricted by SP500 common sessions","rule":"hold 100% BTC only when T-1 BTC/CNY close is strictly above the SMA of the latest 200 completed common execution-session closes; otherwise CNY cash"]
            guard JSONSerialization.isValidJSONObject(out),let json=try?JSONSerialization.data(withJSONObject:out,options:[.sortedKeys]),let text=String(data:json,encoding:.utf8) else { print("BTC_SMA200_001_JSON_FAILED"); return }; print("BTC_SMA200_001_FORMAL_JSON="+text); print("BTC_SMA200_001_FORMAL_OK"); return
        }
