        if ProcessInfo.processInfo.environment["ATM_CASH_CONFIDENCE_LEADER_CONTINUATION_VALIDATION"] == "1" {
            struct LeaderContinuationRun {
                let title: String
                let points: [BacktestSeriesPoint]
                let report: AdvancedBacktestReport
            }

            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceRouter
            let optionsBySymbol = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { optionsBySymbol[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }

            Darwin.setenv("ATM_CC_RECOVERY_FAST_BREAK_THRESHOLD", "-0.05", 1)
            Darwin.setenv("ATM_CC_RECOVERY_COOLDOWN_SESSIONS", "150", 1)
            Darwin.setenv("ATM_CC_RECOVERY_MIN_HOLD_SESSIONS", "10", 1)
            Darwin.setenv("ATM_CC_RECOVERY_MIN_WATER_DURATION", "60", 1)
            Darwin.setenv("ATM_CC_RECOVERY_MIN_DRAWDOWN", "0.05", 1)
            Darwin.setenv("ATM_CC_RECOVERY_MAX_ENTRIES", "2", 1)
            Darwin.setenv("ATM_CC_RECOVERY_REVIEW_SESSIONS", "60", 1)
            Darwin.setenv("ATM_CC_RECOVERY_LEADER_SHARE_CAP", "1", 1)
            Darwin.setenv("ATM_CC_RECOVERY_FAST_REVIEW_VOL_THRESHOLD", "99", 1)
            Darwin.setenv("ATM_CC_RECOVERY_FAST_REVIEW_QUALITY_GAP_THRESHOLD", "99", 1)
            Darwin.setenv("ATM_CC_RECOVERY_LEADER_SWITCH_MIN_SESSIONS", "10000", 1)
            Darwin.setenv("ATM_CC_PORTFOLIO_VOL_TARGET", "99", 1)
            Darwin.setenv("ATM_CC_CALM_CARRY_CAP", "0", 1)
            Darwin.setenv("ATM_CC_CALM_RISK_VOL_FLOOR", "0", 1)
            Darwin.setenv("ATM_CC_SECULAR_CARRY_CAP", "0", 1)
            Darwin.setenv("ATM_CC_GOLD_TO_US_SHIFT_FRACTION", "0", 1)
            Darwin.setenv("ATM_CC_EQUITY_CURVE_RISK_SCALE", "1", 1)
            Darwin.setenv("ATM_CC_USD_CASH_CAP", "0", 1)
            Darwin.setenv("ATM_CC_US_RISK_ALLOCATION_MODE", "0", 1)
            Darwin.setenv("ATM_CC_GLOBAL_RISK_PARITY_BLEND", "0", 1)
            Darwin.setenv("ATM_CC_DISABLE_MID_GROSS_CLIFFS", "0", 1)
            Darwin.setenv("ATM_CC_DISABLE_BREADTH_MICRO_BRAKES", "0", 1)
            Darwin.setenv("ATM_CC_DISABLE_HOLD_HYSTERESIS", "0", 1)
            Darwin.setenv("ATM_CC_DISABLE_MATURE_NASDAQ_BRAKE", "0", 1)
            Darwin.setenv("ATM_CC_DISABLE_CHINA_PURGE", "0", 1)
            Darwin.setenv("ATM_CC_COST_AWARE_REBALANCE", "0", 1)
            Darwin.setenv("ATM_CC_SLOW_ADD_FRACTION", "1", 1)
            Darwin.setenv("ATM_CC_GROSS_CONFIDENCE_SHAPE", "0", 1)
            Darwin.setenv("ATM_CC_STAGED_HANDOFF_MODE", "0", 1)
            Darwin.setenv("ATM_CC_COMPONENT_REBALANCE_MODE", "0", 1)
            Darwin.setenv("ATM_CC_COMPONENT_REBALANCE_BAND", "0", 1)
            Darwin.setenv("ATM_CC_COMPONENT_REBALANCE_VOL_CEILING", "99", 1)
            Darwin.setenv("ATM_CC_BUY_CONFIRMATION_SESSIONS", "1", 1)
            Darwin.setenv("ATM_CC_REBALANCE_TRIGGER_MODE", "0", 1)
            Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_GROSS_DROP_THRESHOLD", "0.02", 1)
            Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_SEVERITY_MODE", "5", 1)
            Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_MAX_RETENTION", "0.25", 1)
            Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_LEADER_SALE_CAP", "0", 1)
            Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_BROAD_UNWIND_TURNOVER_THRESHOLD", "0.60", 1)
            Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_SCOPE", "0", 1)
            Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_TREND_GATE", "0", 1)
            Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_LEADER_GATE", "0", 1)
            Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_HIGH_VOL_THRESHOLD", "99", 1)
            Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_HIGH_VOL_FRACTION", "0.875", 1)
            Darwin.setenv("ATM_CC_RISK_INCREASE_MIGRATION_FLOOR", "0", 1)
            Darwin.setenv("ATM_CC_RISK_INCREASE_GROSS_COMPLETION_MODE", "0", 1)
            Darwin.setenv("ATM_CC_DERISK_CALIBRATION_MODE", "0", 1)

            var runs: [LeaderContinuationRun] = []
            let settingsList: [(String, Int, Double, Double, Bool)] = [
                ("宽容退出基线", 1, 1.0, 0.0, false),
                ("广泛减仓分散缓冲", 11, 0.875, 0.04, false),
            ]
            for item in settingsList {
                Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_MODE", String(item.1), 1)
                Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_FRACTION", String(item.2), 1)
                Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_DD_THRESHOLD", String(item.3), 1)
                Darwin.setenv("ATM_CC_NEAR_PEAK_DERISK_INCLUDE_EXIT", item.4 ? "1" : "0", 1)
                guard let report = BacktestEngine.runAdvancedRotationStrategy(
                    assetInputs: inputs,
                    initialCash: 100_000,
                    settings: settings,
                    mode: mode
                ) else { continue }
                runs.append(LeaderContinuationRun(title: item.0, points: report.points, report: report))
            }
            guard runs.count == 2 else { return }

            func metrics(_ points: [BacktestSeriesPoint], start: String, end: String) -> BacktestPerformanceMetrics? {
                BacktestMetricsCalculator.performanceMetrics(from: points.filter {
                    let key = $0.date.recordDateString
                    return key >= start && key <= end
                })
            }
            func printMetricRow(title: String, label: String, result: BacktestPerformanceMetrics, count: Int) {
                print([
                    title,
                    label,
                    String(count),
                    String(format: "%.6f", result.annualizedReturn ?? 0),
                    String(format: "%.6f", result.maxDrawdown),
                    String(format: "%.6f", result.annualizedVolatility ?? 0),
                    String(format: "%.6f", result.sharpeRatio ?? 0)
                ].joined(separator: ","))
            }

            let cutoff = "2026-07-03"
            print("APP_CASH_CONFIDENCE_LEADER_CONTINUATION_FORMAL")
            print("title,label,points,annualized,max_drawdown,volatility,sharpe")
            for run in runs {
                let selected = run.points.filter { $0.date.recordDateString <= cutoff }
                if let result = BacktestMetricsCalculator.performanceMetrics(from: selected) {
                    printMetricRow(title: run.title, label: "formal", result: result, count: selected.count)
                }
            }

            let starts = [
                "2002-02-04", "2004-01-01", "2006-01-01", "2008-01-01",
                "2010-01-01", "2012-01-01", "2014-01-01", "2016-01-01",
                "2018-01-01", "2020-01-01", "2022-01-01",
            ]
            print("APP_CASH_CONFIDENCE_LEADER_CONTINUATION_ROLLING_STARTS")
            print("title,label,points,annualized,max_drawdown,volatility,sharpe")
            for run in runs {
                for start in starts {
                    let selected = run.points.filter {
                        let key = $0.date.recordDateString
                        return key >= start && key <= cutoff
                    }
                    if let result = BacktestMetricsCalculator.performanceMetrics(from: selected) {
                        printMetricRow(title: run.title, label: start, result: result, count: selected.count)
                    }
                }
            }

            let ends = ["2008-12-31", "2012-12-31", "2016-12-31", "2020-12-31", cutoff]
            print("APP_CASH_CONFIDENCE_LEADER_CONTINUATION_ROLLING_ENDS")
            print("title,label,points,annualized,max_drawdown,volatility,sharpe")
            for run in runs {
                for end in ends {
                    let selected = run.points.filter {
                        let key = $0.date.recordDateString
                        return key >= "2002-02-04" && key <= end
                    }
                    if let result = BacktestMetricsCalculator.performanceMetrics(from: selected) {
                        printMetricRow(title: run.title, label: end, result: result, count: selected.count)
                    }
                }
            }

            let eras = [
                ("2002-2006", "2002-01-01", "2006-12-31"),
                ("2007-2011", "2007-01-01", "2011-12-31"),
                ("2012-2016", "2012-01-01", "2016-12-31"),
                ("2017-2021", "2017-01-01", "2021-12-31"),
                ("2022-2026", "2022-01-01", cutoff),
            ]
            print("APP_CASH_CONFIDENCE_LEADER_CONTINUATION_ERAS")
            print("title,label,points,annualized,max_drawdown,volatility,sharpe")
            for run in runs {
                for era in eras {
                    let selected = run.points.filter {
                        let key = $0.date.recordDateString
                        return key >= era.1 && key <= era.2
                    }
                    if let result = BacktestMetricsCalculator.performanceMetrics(from: selected) {
                        printMetricRow(title: run.title, label: era.0, result: result, count: selected.count)
                    }
                }
            }
            return
        }
