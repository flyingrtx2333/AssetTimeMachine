        if ProcessInfo.processInfo.environment["ATM_US_VALUE_PRODUCTION_ROLE_V1"] == "1" {
            struct MQPricePoint {
                let date: String
                let price: Double
            }

            func loadMQPricePoints(_ path: String) -> [MQPricePoint] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [] }
                return text.split(whereSeparator: \.isNewline).dropFirst().compactMap { line in
                    let fields = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard fields.count >= 2, let value = Double(fields[1]), value.isFinite, value > 0 else { return nil }
                    return MQPricePoint(date: String(fields[0]), price: value)
                }.sorted { $0.date < $1.date }
            }

            func loadMQNFCI(_ path: String) -> [BacktestNFCIPoint] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [] }
                return text.split(whereSeparator: \.isNewline).dropFirst().compactMap { line in
                    let fields = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard fields.count >= 3, let value = Double(fields[2]), value.isFinite else { return nil }
                    return BacktestNFCIPoint(
                        releaseDate: String(fields[0]),
                        referenceDate: String(fields[1]),
                        availableAt: nil,
                        value: value
                    )
                }
            }

            func hybridRoleSeries(
                original: PublicHistorySeries,
                style: [MQPricePoint],
                substitutionStart: String,
                label: String
            ) -> PublicHistorySeries? {
                guard original.dates.count == original.prices.count, !original.dates.isEmpty, style.count >= 2 else { return nil }
                let sortedStyle = style.sorted { $0.date < $1.date }
                var styleIndex = 0
                var lastStylePrice: Double?
                var previousAlignedStylePrice: Double?
                var hybridPrices: [Double] = []
                hybridPrices.reserveCapacity(original.prices.count)
                var previousHybrid: Double?

                for (date, originalPrice) in zip(original.dates, original.prices) {
                    guard originalPrice.isFinite, originalPrice > 0 else { return nil }
                    while styleIndex < sortedStyle.count, sortedStyle[styleIndex].date <= date {
                        let quote = sortedStyle[styleIndex]
                        guard quote.price.isFinite, quote.price > 0 else { return nil }
                        lastStylePrice = quote.price
                        styleIndex += 1
                    }

                    let value: Double
                    if date < substitutionStart {
                        value = originalPrice
                    } else {
                        guard let priorHybrid = previousHybrid,
                              let currentStylePrice = lastStylePrice,
                              let priorStylePrice = previousAlignedStylePrice,
                              priorStylePrice > 0 else { return nil }
                        let styleReturn = currentStylePrice / priorStylePrice
                        guard styleReturn.isFinite, styleReturn > 0 else { return nil }
                        value = priorHybrid * styleReturn
                    }
                    guard value.isFinite, value > 0 else { return nil }
                    hybridPrices.append(value)
                    previousHybrid = value
                    if let lastStylePrice {
                        previousAlignedStylePrice = lastStylePrice
                    }
                }

                return PublicHistorySeries(
                    symbol: original.symbol,
                    category: original.category,
                    label: label,
                    currency: original.currency,
                    unit: original.unit,
                    source: "hybrid: frozen S&P role before substitution start, fixed ETF adjusted-close returns afterward; non-quote union-calendar dates carry the last ETF price forward",
                    dates: original.dates,
                    prices: hybridPrices,
                    hasOHLC: false,
                    ohlcSource: nil,
                    ohlcCoverageRatio: nil,
                    openPrices: nil,
                    highPrices: nil,
                    lowPrices: nil,
                    closePrices: nil,
                    volumes: nil
                )
            }

            let formal = ProcessInfo.processInfo.environment["ATM_US_VALUE_PRODUCTION_ROLE_V1_FORMAL"] == "1"
            let outputDir = ProcessInfo.processInfo.environment["ATM_US_VALUE_PRODUCTION_ROLE_V1_OUTPUT_DIR"]
            let iwdPath = ProcessInfo.processInfo.environment["ATM_US_VALUE_PRODUCTION_ROLE_V1_IWD_PATH"] ?? ""
            let vbrPath = ProcessInfo.processInfo.environment["ATM_US_VALUE_PRODUCTION_ROLE_V1_VBR_PATH"] ?? ""
            let substitutionStart = "2004-02-02"
            let iwdPoints = loadMQPricePoints(iwdPath)
            let vbrPoints = loadMQPricePoints(vbrPath)
            guard !iwdPoints.isEmpty, !vbrPoints.isEmpty else {
                print("US_VALUE_PRODUCTION_ROLE_V1_DATA_MISSING")
                return
            }

            let roleSymbols = ["gold_cny", "nasdaq", "sp500", "csi300", "shanghai_composite"]
            let mode: AdvancedBacktestStrategyMode = .nfciDualCoreSimplifiedV11
            let options = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let calculationOptions = mode.requiredSignalAssetSymbols.compactMap { options[$0] }
            let originalInputs = calculationOptions.map { option in
                BacktestEngine.advancedAssetInput(for: option) { seriesBySymbol[normalizedHistorySymbol($0)] }
            }
            guard let originalSP500 = seriesBySymbol["sp500"],
                  let iwdHybrid = hybridRoleSeries(original: originalSP500, style: iwdPoints, substitutionStart: substitutionStart, label: "IWD role hybrid"),
                  let vbrHybrid = hybridRoleSeries(original: originalSP500, style: vbrPoints, substitutionStart: substitutionStart, label: "VBR role hybrid") else {
                print("US_VALUE_PRODUCTION_ROLE_V1_HYBRID_BUILD_FAILED")
                return
            }

            func candidateInputs(_ replacement: PublicHistorySeries) -> [(assetSeries: PublicHistorySeries?, assetOption: BacktestAssetOption, fxSeries: PublicHistorySeries?)] {
                calculationOptions.map { option in
                    BacktestEngine.advancedAssetInput(for: option) { symbol in
                        if normalizedHistorySymbol(symbol) == "sp500" { return replacement }
                        return seriesBySymbol[normalizedHistorySymbol(symbol)]
                    }
                }
            }

            let settings = AdvancedBacktestRiskSettings(
                feeRate: 1.00,
                slippageRate: 0.05,
                maxPositionRatio: 100,
                cooldownDays: 0,
                stopLossRatio: 0,
                takeProfitRatio: 0
            )
            let nfci = BacktestNFCIAsOfData(
                source: "ALFRED initial-release fixture",
                credit: loadMQNFCI("tools/research-results/NFCICREDIT_initial_release.csv"),
                leverage: loadMQNFCI("tools/research-results/NFCILEVERAGE_initial_release.csv")
            )
            guard let source = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                assetInputs: originalInputs,
                initialCash: 100_000,
                settings: settings,
                mode: mode,
                nfciAsOf: nfci
            ) else {
                print("US_VALUE_PRODUCTION_ROLE_V1_SOURCE_FAILED")
                return
            }
            let sourceTargets = Dictionary(uniqueKeysWithValues: source.dailyStates.map { ($0.date.recordDateString, $0.targetWeights) })
            let sourceTradeDates = Set(source.report.trades.map { $0.date.recordDateString })

            func targetFingerprint(_ states: [BacktestDailyState]) -> String {
                var hash: UInt64 = 1469598103934665603
                for state in states {
                    for symbol in roleSymbols {
                        var value = UInt64(bitPattern: Int64(((state.targetWeights[symbol] ?? 0) * 1_000_000).rounded()))
                        for _ in 0..<8 {
                            hash ^= value & UInt64(0xff)
                            hash &*= UInt64(1099511628211)
                            value >>= 8
                        }
                    }
                }
                return String(format: "%016llx", hash)
            }

            func eventTargetFingerprint(_ states: [BacktestDailyState]) -> String {
                targetFingerprint(states.filter { sourceTradeDates.contains($0.date.recordDateString) })
            }

            func constraints(_ states: [BacktestDailyState]) -> (maxGross: Double, minWeight: Double) {
                let maxGross = states.map { state in roleSymbols.reduce(0.0) { $0 + max(state.targetWeights[$1] ?? 0, 0) } }.max() ?? 0
                let values = states.flatMap { state in roleSymbols.map { state.targetWeights[$0] ?? 0 } }
                return (maxGross, values.min() ?? 0)
            }

            let replayConfig = ResearchTargetStrategyConfig(
                symbol: "us_value_production_role_v1",
                title: "U.S. Value Production Role V1",
                warmupSessions: 21,
                rebalanceSessions: 1,
                rebalanceBand: 0.25,
                maxGrossExposure: 1,
                allowsFinancedExposure: false,
                financingAnnualRate: 0,
                buyReason: "Frozen production V11 target-path role substitution"
            )
            func runReplay(_ assetInputs: [(assetSeries: PublicHistorySeries?, assetOption: BacktestAssetOption, fxSeries: PublicHistorySeries?)]) -> ResearchTargetStrategyRun? {
                var pending: [String: Double] = [:]
                return BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                    assetInputs: assetInputs,
                    initialCash: 100_000,
                    settings: settings,
                    config: replayConfig,
                    rebalanceDecision: { index, _, data in
                        guard data.dates.indices.contains(index) else { return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false) }
                        let day = data.dates[index].recordDateString
                        guard sourceTradeDates.contains(day), let target = sourceTargets[day] else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        pending = target
                        return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                    },
                    targetWeights: { _, _ in pending }
                )
            }
            guard let identity = runReplay(originalInputs) else {
                print("US_VALUE_PRODUCTION_ROLE_V1_IDENTITY_FAILED")
                return
            }
            let identityMatch = abs((identity.report.annualizedReturn ?? 0) - (source.report.annualizedReturn ?? 0)) <= 0.0002
                && abs(identity.report.maxDrawdown - source.report.maxDrawdown) <= 0.0002
                && abs((identity.report.sharpeRatio ?? 0) - (source.report.sharpeRatio ?? 0)) <= 0.002
            print("US_VALUE_PRODUCTION_ROLE_V1")
            print("source_target_fingerprint=\(targetFingerprint(source.dailyStates))")
            print("source_event_target_fingerprint=\(eventTargetFingerprint(source.dailyStates))")
            print("source_event_count=\(sourceTradeDates.count)")
            print("substitution_start=\(substitutionStart)")
            print("SMOKE_IDENTITY_MATCH=\(identityMatch ? "true" : "false")")
            if !identityMatch {
                print("US_VALUE_PRODUCTION_ROLE_V1_IDENTITY_MISMATCH")
                return
            }

            guard let mtumRun = runReplay(candidateInputs(iwdHybrid)), let qualRun = runReplay(candidateInputs(vbrHybrid)) else {
                print("US_VALUE_PRODUCTION_ROLE_V1_CANDIDATE_FAILED")
                return
            }

            if !formal {
                for (id, run) in [("S-IWD-PROD-SP500-ROLE", mtumRun), ("S-VBR-PROD-SP500-ROLE", qualRun)] {
                    let c = constraints(run.dailyStates)
                    print("SMOKE_MQ_ROLE_PATH=\(id)")
                    print("SMOKE_MAX_GROSS=\(String(format: "%.10f", c.maxGross))")
                    print("SMOKE_MIN_WEIGHT=\(String(format: "%.10f", c.minWeight))")
                    print("SMOKE_TARGET_FINGERPRINT=\(eventTargetFingerprint(run.dailyStates))")
                    print("SMOKE_END")
                }
                print("US_VALUE_PRODUCTION_ROLE_V1_COMPLETE")
                return
            }

            let folds: [(String, String, String)] = [
                ("2004-2006", "2004-02-02", "2006-12-31"),
                ("2007-2009", "2007-01-01", "2009-12-31"),
                ("2010-2012", "2010-01-01", "2012-12-31"),
                ("2013-2015", "2013-01-01", "2015-12-31"),
                ("2016-2018", "2016-01-01", "2018-12-31"),
                ("2019-2021", "2019-01-01", "2021-12-31"),
                ("2022-latest", "2022-01-01", "9999-12-31")
            ]
            func foldMetrics(_ points: [BacktestSeriesPoint]) -> [(String, Double, Double, Double)] {
                folds.map { name, start, end in
                    let slice = points.filter { $0.date.recordDateString >= start && $0.date.recordDateString <= end }
                    let metrics = BacktestMetricsCalculator.performanceMetrics(from: slice)
                    return (name, metrics?.annualizedReturn ?? 0, metrics?.maxDrawdown ?? 0, metrics?.sharpeRatio ?? 0)
                }
            }
            func writePortfolio(_ id: String, _ points: [BacktestSeriesPoint]) {
                guard let outputDir else { return }
                try? FileManager.default.createDirectory(atPath: outputDir, withIntermediateDirectories: true)
                let path = URL(fileURLWithPath: outputDir).appendingPathComponent("\(id)-portfolio.csv").path
                var lines = ["date,portfolio_value"]
                lines.append(contentsOf: points.map { "\($0.date.recordDateString),\(String(format: "%.10f", $0.portfolioValue))" })
                try? (lines.joined(separator: "\n") + "\n").write(toFile: path, atomically: true, encoding: .utf8)
            }
            func printPath(_ id: String, _ run: ResearchTargetStrategyRun) {
                let c = constraints(run.dailyStates)
                let evaluation = BacktestMetricsCalculator.performanceMetrics(from: run.report.points.filter { $0.date.recordDateString >= substitutionStart })
                let fs = foldMetrics(run.report.points)
                let m2020 = BacktestMetricsCalculator.performanceMetrics(from: run.report.points.filter { $0.date.recordDateString >= "2020-01-01" })
                let m2022 = BacktestMetricsCalculator.performanceMetrics(from: run.report.points.filter { $0.date.recordDateString >= "2022-01-01" })
                print("candidate_id=\(id)")
                print("full_cagr=\(String(format: "%.6f", (run.report.annualizedReturn ?? 0) * 100))")
                print("full_mdd=\(String(format: "%.6f", run.report.maxDrawdown * 100))")
                print("full_sharpe=\(String(format: "%.6f", run.report.sharpeRatio ?? 0))")
                print("evaluation_cagr=\(String(format: "%.6f", (evaluation?.annualizedReturn ?? 0) * 100))")
                print("evaluation_mdd=\(String(format: "%.6f", (evaluation?.maxDrawdown ?? 0) * 100))")
                print("evaluation_sharpe=\(String(format: "%.6f", evaluation?.sharpeRatio ?? 0))")
                print("trades=\(run.report.trades.count)")
                print("average_cash=\(String(format: "%.6f", run.report.averageCashRatio))")
                print("max_gross=\(String(format: "%.10f", c.maxGross))")
                print("min_weight=\(String(format: "%.10f", c.minWeight))")
                print("fingerprint=\(eventTargetFingerprint(run.dailyStates))")
                print("since2020_cagr=\(String(format: "%.6f", (m2020?.annualizedReturn ?? 0) * 100))")
                print("since2020_sharpe=\(String(format: "%.6f", m2020?.sharpeRatio ?? 0))")
                print("since2022_cagr=\(String(format: "%.6f", (m2022?.annualizedReturn ?? 0) * 100))")
                print("since2022_sharpe=\(String(format: "%.6f", m2022?.sharpeRatio ?? 0))")
                print("fold_names=\(fs.map { $0.0 }.joined(separator: ";"))")
                print("fold_sharpes=\(fs.map { String(format: "%.6f", $0.3) }.joined(separator: ";"))")
                print("fold_cagrs=\(fs.map { String(format: "%.6f", $0.1 * 100) }.joined(separator: ";"))")
                print("fold_mdds=\(fs.map { String(format: "%.6f", $0.2 * 100) }.joined(separator: ";"))")
                print("END_CANDIDATE")
                writePortfolio(id, run.report.points)
            }
            printPath("V11-CONTROL", ResearchTargetStrategyRun(report: source.report, dailyStates: source.dailyStates))
            printPath("S-IWD-PROD-SP500-ROLE", mtumRun)
            printPath("S-VBR-PROD-SP500-ROLE", qualRun)
            print("US_VALUE_PRODUCTION_ROLE_V1_COMPLETE")
            return
        }
