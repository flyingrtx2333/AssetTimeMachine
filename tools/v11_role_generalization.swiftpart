        if ProcessInfo.processInfo.environment["ATM_V11_ROLE_GENERALIZATION"] == "1" {
            func loadRoleGeneralizationNFCIPoints(_ path: String) -> [BacktestNFCIPoint] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [] }
                return text.split(whereSeparator: \.isNewline).dropFirst().compactMap { line in
                    let fields = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard fields.count >= 3, let value = Double(fields[2]), value.isFinite else { return nil }
                    return BacktestNFCIPoint(
                        releaseDate: String(fields[0]),
                        referenceDate: String(fields[1]),
                        availableAt: nil,
                        value: value
                    )
                }
            }

            func loadRoleMapping(_ path: String) -> [String: String]? {
                guard let data = FileManager.default.contents(atPath: path),
                      let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
                      let slots = root["role_slots"] as? [[String: Any]] else { return nil }
                var result: [String: String] = [:]
                for slot in slots {
                    guard let role = slot["role"] as? String,
                          let alternate = slot["normalized_fixture_symbol"] as? String else { continue }
                    let current: String
                    switch role {
                    case "gold_safe_haven": current = "gold_cny"
                    case "us_growth_equity": current = "nasdaq"
                    case "us_broad_equity": current = "sp500"
                    case "china_large_equity": current = "csi300"
                    case "china_broad_equity": current = "shanghai_composite"
                    default: continue
                    }
                    result[current] = alternate
                }
                return result.count == 5 ? result : nil
            }

            func historySeries(_ raw: String) -> PublicHistorySeries? {
                seriesBySymbol[raw]
                    ?? seriesBySymbol[normalizedHistorySymbol(raw)]
                    ?? seriesBySymbol[raw.lowercased()]
            }

            let manifestPath = ProcessInfo.processInfo.environment["ATM_V11_ROLE_MANIFEST"] ?? ""
            guard let roleMapping = loadRoleMapping(manifestPath) else {
                print("V11_ROLE_GENERALIZATION_MANIFEST_INVALID")
                return
            }
            let expectedRoles = ["gold_cny", "nasdaq", "sp500", "csi300", "shanghai_composite"]
            let requestedCandidate = ProcessInfo.processInfo.environment["ATM_V11_ROLE_CANDIDATE"] ?? ""
            guard Set(roleMapping.keys) == Set(expectedRoles) else {
                print("V11_ROLE_GENERALIZATION_ROLE_MAPPING_INVALID")
                return
            }
            if requestedCandidate != "baseline_identity",
               !expectedRoles.allSatisfy({ historySeries(roleMapping[$0] ?? "") != nil }) {
                print("V11_ROLE_GENERALIZATION_SERIES_MISSING")
                return
            }

            let nfci = BacktestNFCIAsOfData(
                source: "ALFRED initial-release fixture",
                credit: loadRoleGeneralizationNFCIPoints("tools/research-results/NFCICREDIT_initial_release.csv"),
                leverage: loadRoleGeneralizationNFCIPoints("tools/research-results/NFCILEVERAGE_initial_release.csv")
            )
            let mode: AdvancedBacktestStrategyMode = .nfciDualCoreSimplifiedV11
            let settings = AdvancedBacktestRiskSettings(
                feeRate: 1.00,
                slippageRate: 0.05,
                maxPositionRatio: 100,
                cooldownDays: 0,
                stopLossRatio: 0,
                takeProfitRatio: 0
            )
            let options = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })

            func inputs(replacedRoles: Set<String>) -> [(assetSeries: PublicHistorySeries?, assetOption: BacktestAssetOption, fxSeries: PublicHistorySeries?)] {
                expectedRoles.compactMap { role in
                    guard let option = options[role] else { return nil }
                    let alternate = roleMapping[role]
                    return BacktestEngine.advancedAssetInput(for: option) { requested in
                        if requested == role, replacedRoles.contains(role), let alternate {
                            return historySeries(alternate)
                        }
                        return historySeries(requested)
                    }
                }
            }

            func fingerprint(_ states: [BacktestDailyState]) -> String {
                var h: UInt64 = 1469598103934665603
                for state in states {
                    for symbol in expectedRoles {
                        var value = UInt64(bitPattern: Int64(((state.targetWeights[symbol] ?? 0) * 1_000_000).rounded()))
                        for _ in 0..<8 {
                            h ^= value & UInt64(0xff)
                            h &*= UInt64(1099511628211)
                            value >>= 8
                        }
                    }
                }
                return String(format: "%016llx", h)
            }

            func runCase(_ candidateID: String, replacedRoles: Set<String>) -> AdvancedRotationStrategyRun? {
                guard let run = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                    assetInputs: inputs(replacedRoles: replacedRoles),
                    initialCash: 100_000,
                    settings: settings,
                    mode: mode,
                    nfciAsOf: nfci
                ) else { return nil }
                print("candidate_id=\(candidateID)")
                print("replaced_roles=\(replacedRoles.sorted().joined(separator: ";"))")
                print("cagr=\(String(format: "%.6f", (run.report.annualizedReturn ?? 0) * 100))")
                print("mdd=\(String(format: "%.6f", run.report.maxDrawdown * 100))")
                print("vol=\(String(format: "%.6f", (run.report.annualizedVolatility ?? 0) * 100))")
                print("sharpe=\(String(format: "%.6f", run.report.sharpeRatio ?? 0))")
                print("trades=\(run.report.trades.count)")
                let maxGross = run.dailyStates.map { $0.targetWeights.values.reduce(0, +) }.max() ?? 0
                let minWeight = run.dailyStates.flatMap { $0.targetWeights.values }.min() ?? 0
                print("max_gross=\(String(format: "%.10f", maxGross))")
                print("min_weight=\(String(format: "%.10f", minWeight))")
                print("fingerprint=\(fingerprint(run.dailyStates))")
                if let outputDir = ProcessInfo.processInfo.environment["ATM_V11_ROLE_OUTPUT_DIR"] {
                    let output = URL(fileURLWithPath: outputDir).appendingPathComponent("\(candidateID)-portfolio.csv").path
                    var lines = ["date,portfolio_value"]
                    lines.append(contentsOf: run.report.points.map { "\($0.date.recordDateString),\(String(format: "%.10f", $0.portfolioValue))" })
                    try? (lines.joined(separator: "\n") + "\n").write(toFile: output, atomically: true, encoding: .utf8)
                }
                print("END_CANDIDATE")
                return run
            }

            let candidateRoles: [String: Set<String>] = [
                "baseline_identity": [],
                "baseline_common_window": [],
                "one_slot_gold_safe_haven": ["gold_cny"],
                "one_slot_us_growth_equity": ["nasdaq"],
                "one_slot_us_broad_equity": ["sp500"],
                "one_slot_china_large_equity": ["csi300"],
                "one_slot_china_broad_equity": ["shanghai_composite"],
                "all_alternate": Set(expectedRoles)
            ]
            guard let replacedRoles = candidateRoles[requestedCandidate] else {
                print("V11_ROLE_GENERALIZATION_CANDIDATE_INVALID=\(requestedCandidate)")
                return
            }
            print("V11_ROLE_GENERALIZATION")
            guard runCase(requestedCandidate, replacedRoles: replacedRoles) != nil else {
                print("V11_ROLE_GENERALIZATION_CASE_FAILED=\(requestedCandidate)")
                return
            }
            print("V11_ROLE_GENERALIZATION_COMPLETE")
            return
        }
