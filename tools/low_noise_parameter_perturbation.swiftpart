        if ProcessInfo.processInfo.environment["ATM_LOW_NOISE_PARAMETER_PERTURBATION"] == "1" {
            let parameter = ProcessInfo.processInfo.environment["ATM_LOW_NOISE_PERTURB_PARAM"] ?? "trade_band"
            let factors: [Double] = [0.80, 0.90, 1.00, 1.10, 1.20]
            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceLowNoise
            let options = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { options[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { seriesBySymbol[normalizedHistorySymbol($0)] }
            }
            func resetLowNoiseOverrides() {
                BacktestResearchOverrides.lowNoiseTradeBand = nil
                BacktestResearchOverrides.lowNoiseNearPeakExecutionFraction = nil
                BacktestResearchOverrides.lowNoiseBroadUnwindTurnoverThreshold = nil
                BacktestResearchOverrides.lowNoiseVolatilityTarget = nil
                BacktestResearchOverrides.lowNoiseActiveReturnScale = nil
                BacktestResearchOverrides.lowNoiseChinaActiveReturnScale = nil
                BacktestResearchOverrides.lowNoiseConfirmedUSActiveReturnScale = nil
            }
            func excessScaled(_ base: Double, factor: Double) -> Double { 1 + (base - 1) * factor }
            print("APP_LOW_NOISE_PARAMETER_PERTURBATION")
            print("parameter,factor,resolved,cagr,mdd,vol,sharpe,trades,average_cash,since2020_cagr,since2020_sharpe,since2022_cagr,since2022_sharpe")
            for factor in factors {
                resetLowNoiseOverrides()
                var resolved = 0.0
                switch parameter {
                case "trade_band":
                    resolved = 0.244 * factor
                    BacktestResearchOverrides.lowNoiseTradeBand = resolved
                case "near_peak_execution":
                    resolved = 0.80 * factor
                    BacktestResearchOverrides.lowNoiseNearPeakExecutionFraction = resolved
                case "broad_unwind":
                    resolved = 0.40 * factor
                    BacktestResearchOverrides.lowNoiseBroadUnwindTurnoverThreshold = resolved
                case "vol_target":
                    resolved = 0.09 * factor
                    BacktestResearchOverrides.lowNoiseVolatilityTarget = resolved
                case "active_scale_cluster":
                    resolved = factor
                    BacktestResearchOverrides.lowNoiseActiveReturnScale = excessScaled(1.22, factor: factor)
                    BacktestResearchOverrides.lowNoiseChinaActiveReturnScale = excessScaled(1.30, factor: factor)
                    BacktestResearchOverrides.lowNoiseConfirmedUSActiveReturnScale = excessScaled(1.24, factor: factor)
                default:
                    print("unknown_parameter=\(parameter)")
                    resetLowNoiseOverrides()
                    return
                }
                guard let report = BacktestEngine.runAdvancedRotationStrategy(
                    assetInputs: inputs, initialCash: 100_000, settings: settings, mode: mode
                ) else { continue }
                let m2020 = BacktestMetricsCalculator.performanceMetrics(from: report.points.filter { $0.date.recordDateString >= "2020-01-01" })
                let m2022 = BacktestMetricsCalculator.performanceMetrics(from: report.points.filter { $0.date.recordDateString >= "2022-01-01" })
                print([
                    parameter, String(format:"%.2f",factor), String(format:"%.6f",resolved),
                    String(format:"%.6f",(report.annualizedReturn ?? 0)*100),
                    String(format:"%.6f",report.maxDrawdown*100),
                    String(format:"%.6f",(report.annualizedVolatility ?? 0)*100),
                    String(format:"%.6f",report.sharpeRatio ?? 0), String(report.trades.count),
                    String(format:"%.6f",report.averageCashRatio),
                    String(format:"%.6f",(m2020?.annualizedReturn ?? 0)*100), String(format:"%.6f",m2020?.sharpeRatio ?? 0),
                    String(format:"%.6f",(m2022?.annualizedReturn ?? 0)*100), String(format:"%.6f",m2022?.sharpeRatio ?? 0)
                ].joined(separator:","))
            }
            resetLowNoiseOverrides()
            return
        }
