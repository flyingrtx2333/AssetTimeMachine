        if ProcessInfo.processInfo.environment["ATM_CASH_CONFIDENCE_DUAL_CURRENCY_CASH_GRID"] == "1" {
            struct DualCurrencyCashCandidate {
                let title: String
                let cap: Double
                let maPeriod: Int
                let momentumLookback: Int
                let entrySessions: Int
                let exitSessions: Int
                let annualized: Double
                let maxDrawdown: Double
                let sharpe: Double
                let trades: Int
                let averageCashRatio: Double
                let sliceRows: [SliceMetricRow]
            }

            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceRouter
            let optionsBySymbol = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let baseInputs = mode.requiredSignalAssetSymbols.compactMap { optionsBySymbol[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }
            let inputs: [(assetSeries: PublicHistorySeries?, assetOption: BacktestAssetOption, fxSeries: PublicHistorySeries?)] = {
                guard let usdOption = optionsBySymbol["usd_cash"],
                      let nasdaqSeries = seriesBySymbol[normalizedHistorySymbol("nasdaq")] else {
                    return baseInputs
                }
                let rawUsdInput = BacktestEngine.advancedAssetInput(for: usdOption) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
                guard let rawUsdSeries = rawUsdInput.assetSeries else {
                    return baseInputs
                }
                let allowedDates = Set(nasdaqSeries.dates)
                var dates: [String] = []
                var prices: [Double] = []
                for (date, price) in zip(rawUsdSeries.dates, rawUsdSeries.prices)
                    where allowedDates.contains(date) {
                    dates.append(date)
                    prices.append(price)
                }
                let alignedUsdSeries = PublicHistorySeries(
                    symbol: rawUsdSeries.symbol,
                    category: rawUsdSeries.category,
                    label: rawUsdSeries.label,
                    currency: rawUsdSeries.currency,
                    unit: rawUsdSeries.unit,
                    source: rawUsdSeries.source,
                    dates: dates,
                    prices: prices,
                    hasOHLC: false,
                    ohlcSource: nil,
                    ohlcCoverageRatio: nil,
                    openPrices: nil,
                    highPrices: nil,
                    lowPrices: nil,
                    closePrices: nil,
                    volumes: nil
                )
                return baseInputs + [(
                    assetSeries: alignedUsdSeries,
                    assetOption: usdOption,
                    fxSeries: nil
                )]
            }()
            let parameterSets: [(String, Double, Int, Int, Int, Int)] = [
                ("新冠军基线", 0.00, 126, 126, 10, 10),
                ("美元现金10%-MA126", 0.10, 126, 126, 10, 10),
                ("美元现金20%-MA126", 0.20, 126, 126, 10, 10),
                ("美元现金30%-MA126", 0.30, 126, 126, 10, 10),
                ("美元现金20%-MA200", 0.20, 200, 126, 10, 10),
                ("美元现金20%-确认20", 0.20, 126, 126, 20, 10),
                ("美元现金20%-慢退出", 0.20, 126, 126, 10, 20),
            ]

            Darwin.setenv("ATM_CC_RECOVERY_FAST_BREAK_THRESHOLD", "-0.05", 1)
            Darwin.setenv("ATM_CC_RECOVERY_COOLDOWN_SESSIONS", "150", 1)
            Darwin.setenv("ATM_CC_RECOVERY_MIN_HOLD_SESSIONS", "10", 1)
            Darwin.setenv("ATM_CC_RECOVERY_MIN_WATER_DURATION", "60", 1)
            Darwin.setenv("ATM_CC_RECOVERY_MIN_DRAWDOWN", "0.05", 1)
            Darwin.setenv("ATM_CC_RECOVERY_MAX_ENTRIES", "2", 1)
            Darwin.setenv("ATM_CC_RECOVERY_REVIEW_SESSIONS", "60", 1)
            Darwin.setenv("ATM_CC_RECOVERY_LEADER_SHARE_CAP", "1", 1)
            Darwin.setenv("ATM_CC_RECOVERY_FAST_REVIEW_VOL_THRESHOLD", "99", 1)
            Darwin.setenv("ATM_CC_RECOVERY_FAST_REVIEW_QUALITY_GAP_THRESHOLD", "99", 1)
            Darwin.setenv("ATM_CC_RECOVERY_LEADER_SWITCH_MIN_SESSIONS", "10000", 1)
            Darwin.setenv("ATM_CC_PORTFOLIO_VOL_TARGET", "99", 1)
            Darwin.setenv("ATM_CC_CALM_CARRY_CAP", "0", 1)
            Darwin.setenv("ATM_CC_CALM_RISK_VOL_FLOOR", "0", 1)
            Darwin.setenv("ATM_CC_SECULAR_CARRY_CAP", "0", 1)
            Darwin.setenv("ATM_CC_GOLD_TO_US_SHIFT_FRACTION", "0", 1)
            Darwin.setenv("ATM_CC_EQUITY_CURVE_RISK_SCALE", "1", 1)

            var candidates: [DualCurrencyCashCandidate] = []
            for parameters in parameterSets {
                Darwin.setenv("ATM_CC_USD_CASH_CAP", String(parameters.1), 1)
                Darwin.setenv("ATM_CC_USD_CASH_MA_PERIOD", String(parameters.2), 1)
                Darwin.setenv("ATM_CC_USD_CASH_MOMENTUM_LOOKBACK", String(parameters.3), 1)
                Darwin.setenv("ATM_CC_USD_CASH_ENTRY_SESSIONS", String(parameters.4), 1)
                Darwin.setenv("ATM_CC_USD_CASH_EXIT_SESSIONS", String(parameters.5), 1)
                guard let report = BacktestEngine.runAdvancedRotationStrategy(
                    assetInputs: inputs,
                    initialCash: 100_000,
                    settings: settings,
                    mode: mode
                ) else { continue }
                let fullRow = MetricRow(
                    title: parameters.0,
                    id: "cash_confidence_dual_currency_cash_grid",
                    annualized: report.annualizedReturn,
                    maxDrawdown: report.maxDrawdown,
                    volatility: report.annualizedVolatility,
                    sharpe: report.sharpeRatio,
                    start: report.points.first?.date.recordDateString ?? "n/a",
                    end: report.points.last?.date.recordDateString ?? "n/a",
                    pointCount: report.points.count
                )
                candidates.append(DualCurrencyCashCandidate(
                    title: parameters.0,
                    cap: parameters.1,
                    maPeriod: parameters.2,
                    momentumLookback: parameters.3,
                    entrySessions: parameters.4,
                    exitSessions: parameters.5,
                    annualized: report.annualizedReturn ?? -1,
                    maxDrawdown: report.maxDrawdown,
                    sharpe: report.sharpeRatio ?? -1,
                    trades: report.trades.count,
                    averageCashRatio: report.averageCashRatio,
                    sliceRows: metricRowsForSlices(
                        title: parameters.0,
                        id: "cash_confidence_dual_currency_cash_grid",
                        points: report.points,
                        fullRow: fullRow
                    )
                ))
            }

            let ranked = candidates.sorted { lhs, rhs in
                let lhsScore = lhs.sharpe + 0.5 * lhs.annualized - 0.75 * lhs.maxDrawdown
                let rhsScore = rhs.sharpe + 0.5 * rhs.annualized - 0.75 * rhs.maxDrawdown
                if lhsScore == rhsScore { return lhs.annualized > rhs.annualized }
                return lhsScore > rhsScore
            }
            printSliceRows(ranked.flatMap(\.sliceRows), header: "APP_CASH_CONFIDENCE_DUAL_CURRENCY_CASH_GRID")
            print("APP_CASH_CONFIDENCE_DUAL_CURRENCY_CASH_DIAGNOSTICS")
            print("title,cap,ma_period,momentum_lookback,entry_sessions,exit_sessions,annualized,max_drawdown,sharpe,trades,average_cash_ratio")
            for candidate in ranked {
                print([
                    candidate.title,
                    String(format: "%.4f", candidate.cap),
                    String(candidate.maPeriod),
                    String(candidate.momentumLookback),
                    String(candidate.entrySessions),
                    String(candidate.exitSessions),
                    String(format: "%.6f", candidate.annualized * 100),
                    String(format: "%.6f", candidate.maxDrawdown * 100),
                    String(format: "%.6f", candidate.sharpe),
                    String(candidate.trades),
                    String(format: "%.6f", candidate.averageCashRatio)
                ].joined(separator: ","))
            }
            return
        }
