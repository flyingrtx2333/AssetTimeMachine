        if ProcessInfo.processInfo.environment["ATM_ORTHOGONAL_STRATEGY_ZOO4"] == "1" {
            enum Zoo4Family: String {
                case tippStatic
                case tippInverseVol
                case cppiFixedFloor
                case cvarOptimizer
                case cappedKelly
                case hierarchicalRiskParity
            }

            struct Zoo4Variant {
                let id: String
                let title: String
                let family: Zoo4Family
                let rebalanceSessions: Int
                let rebalanceBand: Double
                let p1: Double
                let p2: Double
                let p3: Double
                let intParam: Int
            }

            struct Zoo4Metrics {
                let annualized: Double
                let maxDrawdown: Double
                let volatility: Double
                let sharpe: Double
            }

            struct Zoo4Result {
                let variant: Zoo4Variant
                let full: Zoo4Metrics
                let last10y: Zoo4Metrics
                let since2020: Zoo4Metrics
                let since2022: Zoo4Metrics
                let trades: Int
                let averageCashRatio: Double
                let maxTargetGross: Double
                let maxActualGross: Double
                let minCashRatio: Double
                let financedDays: Int
            }

            let coreSymbols = ["gold_cny", "nasdaq", "sp500"]
            let optionsBySymbol = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = coreSymbols.compactMap { optionsBySymbol[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }

            let variants: [Zoo4Variant] = [
                .init(id: "tipp_gn50_f90_m4", title: "TIPP金纳50/50-F90-M4", family: .tippStatic, rebalanceSessions: 5, rebalanceBand: 0.06, p1: 0.90, p2: 4, p3: 0.50, intParam: 0),
                .init(id: "tipp_gn50_f90_m6", title: "TIPP金纳50/50-F90-M6", family: .tippStatic, rebalanceSessions: 5, rebalanceBand: 0.06, p1: 0.90, p2: 6, p3: 0.50, intParam: 0),
                .init(id: "tipp_gn50_f90_m8", title: "TIPP金纳50/50-F90-M8", family: .tippStatic, rebalanceSessions: 5, rebalanceBand: 0.06, p1: 0.90, p2: 8, p3: 0.50, intParam: 0),
                .init(id: "tipp_gn40_f92_m6", title: "TIPP黄金40/纳指60-F92-M6", family: .tippStatic, rebalanceSessions: 5, rebalanceBand: 0.06, p1: 0.92, p2: 6, p3: 0.40, intParam: 0),
                .init(id: "tipp_gn40_f92_m8", title: "TIPP黄金40/纳指60-F92-M8", family: .tippStatic, rebalanceSessions: 5, rebalanceBand: 0.06, p1: 0.92, p2: 8, p3: 0.40, intParam: 0),
                .init(id: "tipp_gn40_f85_m4", title: "TIPP黄金40/纳指60-F85-M4", family: .tippStatic, rebalanceSessions: 5, rebalanceBand: 0.06, p1: 0.85, p2: 4, p3: 0.40, intParam: 0),

                .init(id: "tipp_iv_f90_m6", title: "TIPP逆波动核心-F90-M6", family: .tippInverseVol, rebalanceSessions: 5, rebalanceBand: 0.06, p1: 0.90, p2: 6, p3: 63, intParam: 0),
                .init(id: "tipp_iv_f90_m8", title: "TIPP逆波动核心-F90-M8", family: .tippInverseVol, rebalanceSessions: 5, rebalanceBand: 0.06, p1: 0.90, p2: 8, p3: 63, intParam: 0),
                .init(id: "tipp_iv_f92_m8", title: "TIPP逆波动核心-F92-M8", family: .tippInverseVol, rebalanceSessions: 5, rebalanceBand: 0.06, p1: 0.92, p2: 8, p3: 126, intParam: 0),

                .init(id: "cppi_gn50_floor80_m3", title: "CPPI固定底线80%-M3", family: .cppiFixedFloor, rebalanceSessions: 5, rebalanceBand: 0.06, p1: 0.80, p2: 3, p3: 0.50, intParam: 0),
                .init(id: "cppi_gn50_floor80_m5", title: "CPPI固定底线80%-M5", family: .cppiFixedFloor, rebalanceSessions: 5, rebalanceBand: 0.06, p1: 0.80, p2: 5, p3: 0.50, intParam: 0),

                .init(id: "cvar_126_l2", title: "CVaR优化126-λ2", family: .cvarOptimizer, rebalanceSessions: 63, rebalanceBand: 0.06, p1: 126, p2: 2, p3: 0, intParam: 0),
                .init(id: "cvar_126_l4", title: "CVaR优化126-λ4", family: .cvarOptimizer, rebalanceSessions: 63, rebalanceBand: 0.06, p1: 126, p2: 4, p3: 0, intParam: 0),
                .init(id: "cvar_252_l4", title: "CVaR优化252-λ4", family: .cvarOptimizer, rebalanceSessions: 63, rebalanceBand: 0.06, p1: 252, p2: 4, p3: 0, intParam: 0),

                .init(id: "kelly_126_half", title: "半Kelly核心126", family: .cappedKelly, rebalanceSessions: 63, rebalanceBand: 0.08, p1: 126, p2: 0.50, p3: 0, intParam: 0),
                .init(id: "kelly_252_half", title: "半Kelly核心252", family: .cappedKelly, rebalanceSessions: 63, rebalanceBand: 0.08, p1: 252, p2: 0.50, p3: 0, intParam: 0),
                .init(id: "kelly_252_quarter", title: "四分之一Kelly核心252", family: .cappedKelly, rebalanceSessions: 63, rebalanceBand: 0.08, p1: 252, p2: 0.25, p3: 0, intParam: 0),

                .init(id: "hrp_63", title: "层次风险平价HRP63", family: .hierarchicalRiskParity, rebalanceSessions: 63, rebalanceBand: 0.04, p1: 63, p2: 0.95, p3: 0, intParam: 0),
                .init(id: "hrp_126", title: "层次风险平价HRP126", family: .hierarchicalRiskParity, rebalanceSessions: 63, rebalanceBand: 0.04, p1: 126, p2: 0.95, p3: 0, intParam: 0),
            ]

            func price(_ symbol: String, _ index: Int, _ data: ResearchTargetDataContext) -> Double? {
                guard let values = data.pricesBySymbol[symbol], values.indices.contains(index), values[index] > 0 else { return nil }
                return values[index]
            }

            func returns(_ symbol: String, _ index: Int, _ lookback: Int, _ data: ResearchTargetDataContext) -> [Double]? {
                guard lookback > 1, index >= lookback,
                      let values = data.pricesBySymbol[symbol], values.indices.contains(index) else { return nil }
                var result: [Double] = []
                result.reserveCapacity(lookback)
                for cursor in (index - lookback + 1)...index {
                    guard cursor > 0, values[cursor] > 0, values[cursor - 1] > 0 else { return nil }
                    result.append(values[cursor] / values[cursor - 1] - 1)
                }
                return result
            }

            func volatility(_ symbol: String, _ index: Int, _ lookback: Int, _ data: ResearchTargetDataContext) -> Double? {
                guard let r = returns(symbol, index, lookback, data), r.count > 1 else { return nil }
                let mean = r.reduce(0, +) / Double(r.count)
                let variance = r.reduce(0.0) { $0 + pow($1 - mean, 2) } / Double(r.count - 1)
                return sqrt(max(variance, 0)) * sqrt(252)
            }

            func inverseVolSleeve(_ index: Int, _ lookback: Int, gross: Double, _ data: ResearchTargetDataContext) -> [String: Double] {
                let rows = coreSymbols.compactMap { symbol -> (String, Double)? in
                    guard let vol = volatility(symbol, index, lookback, data), vol > 0 else { return nil }
                    return (symbol, 1 / max(vol, 0.04))
                }
                let denominator = rows.reduce(0.0) { $0 + $1.1 }
                guard denominator > 0 else { return [:] }
                return Dictionary(uniqueKeysWithValues: rows.map { ($0.0, gross * $0.1 / denominator) })
            }

            func metrics(_ points: [BacktestSeriesPoint]) -> Zoo4Metrics? {
                guard points.count > 1,
                      let result = BacktestMetricsCalculator.performanceMetrics(from: points) else { return nil }
                return Zoo4Metrics(
                    annualized: result.annualizedReturn ?? -1,
                    maxDrawdown: result.maxDrawdown,
                    volatility: result.annualizedVolatility ?? -1,
                    sharpe: result.sharpeRatio ?? -1
                )
            }

            func cvarOptimal(_ index: Int, _ lookback: Int, lambda: Double, _ data: ResearchTargetDataContext) -> [String: Double] {
                let series = coreSymbols.compactMap { returns($0, index, lookback, data) }
                guard series.count == 3,
                      series[0].count == series[1].count,
                      series[0].count == series[2].count,
                      series[0].count > 20 else { return [:] }
                var bestScore = -Double.infinity
                var best = [0.0, 0.0, 0.0]
                for gi in 0...20 {
                    for ni in 0...(20 - gi) {
                        let si = 20 - gi - ni
                        let w = [Double(gi) / 20, Double(ni) / 20, Double(si) / 20]
                        var portfolioReturns: [Double] = []
                        for cursor in series[0].indices {
                            portfolioReturns.append(w[0] * series[0][cursor] + w[1] * series[1][cursor] + w[2] * series[2][cursor])
                        }
                        let meanAnnual = portfolioReturns.reduce(0, +) / Double(portfolioReturns.count) * 252
                        let sorted = portfolioReturns.sorted()
                        let tailCount = max(Int(Double(sorted.count) * 0.05), 1)
                        let tail = sorted.prefix(tailCount)
                        let cvarAnnual = -tail.reduce(0, +) / Double(tailCount) * sqrt(252)
                        let score = meanAnnual - lambda * max(cvarAnnual, 0)
                        if score > bestScore {
                            bestScore = score
                            best = w
                        }
                    }
                }
                return [
                    "gold_cny": best[0] * 0.95,
                    "nasdaq": best[1] * 0.95,
                    "sp500": best[2] * 0.95,
                ].filter { $0.value > 0.000001 }
            }

            func kellyWeights(_ index: Int, _ lookback: Int, fraction: Double, _ data: ResearchTargetDataContext) -> [String: Double] {
                var raw: [(String, Double)] = []
                for symbol in coreSymbols {
                    guard let r = returns(symbol, index, lookback, data), r.count > 2 else { continue }
                    let mean = r.reduce(0, +) / Double(r.count)
                    let variance = r.reduce(0.0) { $0 + pow($1 - mean, 2) } / Double(r.count - 1)
                    guard variance > 0 else { continue }
                    let kelly = mean / variance
                    if kelly > 0 { raw.append((symbol, min(kelly * fraction, 1))) }
                }
                let gross = raw.reduce(0.0) { $0 + $1.1 }
                guard gross > 0 else { return [:] }
                let scale = min(1 / gross, 1)
                return Dictionary(uniqueKeysWithValues: raw.map { ($0.0, $0.1 * scale) })
            }

            func correlation(_ lhs: [Double], _ rhs: [Double]) -> Double {
                guard lhs.count == rhs.count, lhs.count > 2 else { return 0 }
                let lm = lhs.reduce(0, +) / Double(lhs.count)
                let rm = rhs.reduce(0, +) / Double(rhs.count)
                var cov = 0.0
                var lv = 0.0
                var rv = 0.0
                for i in lhs.indices {
                    let a = lhs[i] - lm
                    let b = rhs[i] - rm
                    cov += a * b
                    lv += a * a
                    rv += b * b
                }
                guard lv > 0, rv > 0 else { return 0 }
                return cov / sqrt(lv * rv)
            }

            func hrpWeights(_ index: Int, _ lookback: Int, gross: Double, _ data: ResearchTargetDataContext) -> [String: Double] {
                guard let g = returns("gold_cny", index, lookback, data),
                      let n = returns("nasdaq", index, lookback, data),
                      let s = returns("sp500", index, lookback, data),
                      g.count == n.count, g.count == s.count else { return [:] }
                let series = [g, n, s]
                let symbols = coreSymbols
                let pairRows: [(Int, Int, Double)] = [
                    (0, 1, correlation(g, n)),
                    (0, 2, correlation(g, s)),
                    (1, 2, correlation(n, s)),
                ]
                let closest = pairRows.max { lhs, rhs in lhs.2 < rhs.2 } ?? pairRows[0]
                let pair = [closest.0, closest.1]
                let singleton = [0, 1, 2].first { !pair.contains($0) } ?? 0
                func variance(_ values: [Double]) -> Double {
                    let mean = values.reduce(0, +) / Double(values.count)
                    return values.reduce(0.0) { $0 + pow($1 - mean, 2) } / Double(max(values.count - 1, 1))
                }
                let pairVars = pair.map { max(variance(series[$0]), 1e-8) }
                let pairInv = pairVars.map { 1 / $0 }
                let pairDen = pairInv.reduce(0, +)
                let pairWeights = pairInv.map { $0 / pairDen }
                var pairPortfolio: [Double] = Array(repeating: 0, count: g.count)
                for cursor in pairPortfolio.indices {
                    pairPortfolio[cursor] = pairWeights[0] * series[pair[0]][cursor] + pairWeights[1] * series[pair[1]][cursor]
                }
                let pairVariance = max(variance(pairPortfolio), 1e-8)
                let singletonVariance = max(variance(series[singleton]), 1e-8)
                let clusterPairWeight = singletonVariance / (pairVariance + singletonVariance)
                let singletonWeight = 1 - clusterPairWeight
                var result: [String: Double] = [:]
                result[symbols[pair[0]]] = gross * clusterPairWeight * pairWeights[0]
                result[symbols[pair[1]]] = gross * clusterPairWeight * pairWeights[1]
                result[symbols[singleton]] = gross * singletonWeight
                return result
            }

            let commonStart = Calendar(identifier: .gregorian).date(from: DateComponents(year: 2002, month: 2, day: 4))!
            let since2020 = Calendar(identifier: .gregorian).date(from: DateComponents(year: 2020, month: 1, day: 1))!
            let since2022 = Calendar(identifier: .gregorian).date(from: DateComponents(year: 2022, month: 1, day: 1))!
            var results: [Zoo4Result] = []

            for variant in variants {
                let config = ResearchTargetStrategyConfig(
                    symbol: variant.id,
                    title: variant.title,
                    warmupSessions: 21,
                    rebalanceSessions: variant.rebalanceSessions,
                    rebalanceBand: variant.rebalanceBand,
                    maxGrossExposure: 1.0,
                    allowsFinancedExposure: false,
                    financingAnnualRate: 0,
                    buyReason: "组合保险与尾部优化研究"
                )
                var highWater = 100_000.0
                let fixedFloor = 100_000.0 * variant.p1
                guard let run = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                    assetInputs: inputs,
                    initialCash: 100_000,
                    settings: settings,
                    config: config,
                    targetWeights: { context, data in
                        let index = context.signalIndex
                        guard index >= 20 else { return [:] }
                        switch variant.family {
                        case .tippStatic, .tippInverseVol:
                            highWater = max(highWater, context.preRebalanceValue)
                            let floor = highWater * variant.p1
                            let cushion = max(context.preRebalanceValue - floor, 0)
                            let riskyGross = context.preRebalanceValue > 0
                                ? min(max(variant.p2 * cushion / context.preRebalanceValue, 0), 1)
                                : 0
                            guard riskyGross > 0 else { return [:] }
                            if variant.family == .tippInverseVol {
                                return inverseVolSleeve(index, Int(variant.p3), gross: riskyGross, data)
                            }
                            let goldShare = min(max(variant.p3, 0), 1)
                            return [
                                "gold_cny": riskyGross * goldShare,
                                "nasdaq": riskyGross * (1 - goldShare),
                            ]

                        case .cppiFixedFloor:
                            let cushion = max(context.preRebalanceValue - fixedFloor, 0)
                            let riskyGross = context.preRebalanceValue > 0
                                ? min(max(variant.p2 * cushion / context.preRebalanceValue, 0), 1)
                                : 0
                            let goldShare = min(max(variant.p3, 0), 1)
                            return [
                                "gold_cny": riskyGross * goldShare,
                                "nasdaq": riskyGross * (1 - goldShare),
                            ].filter { $0.value > 0.000001 }

                        case .cvarOptimizer:
                            return cvarOptimal(index, Int(variant.p1), lambda: variant.p2, data)

                        case .cappedKelly:
                            return kellyWeights(index, Int(variant.p1), fraction: variant.p2, data)

                        case .hierarchicalRiskParity:
                            return hrpWeights(index, Int(variant.p1), gross: variant.p2, data)
                        }
                    }
                ) else { continue }

                let points = run.report.points.filter { $0.date >= commonStart }
                let lastDate = points.last?.date ?? commonStart
                let last10yStart = Calendar(identifier: .gregorian).date(byAdding: .year, value: -10, to: lastDate) ?? commonStart
                guard let full = metrics(points),
                      let last10y = metrics(points.filter { $0.date >= last10yStart }),
                      let m2020 = metrics(points.filter { $0.date >= since2020 }),
                      let m2022 = metrics(points.filter { $0.date >= since2022 }) else { continue }

                var maxTargetGross = 0.0
                var maxActualGross = 0.0
                var minCashRatio = Double.greatestFiniteMagnitude
                var financedDays = 0
                for state in run.dailyStates where state.portfolioValue > 0 && state.date >= commonStart {
                    let targetGross = state.targetWeights.values.reduce(0, +)
                    let actualGross = state.holdingsBySymbol.values.reduce(0, +) / state.portfolioValue
                    let cashRatio = state.cash / state.portfolioValue
                    maxTargetGross = max(maxTargetGross, targetGross)
                    maxActualGross = max(maxActualGross, actualGross)
                    minCashRatio = min(minCashRatio, cashRatio)
                    if state.cash < -0.0001 { financedDays += 1 }
                }

                results.append(.init(
                    variant: variant,
                    full: full,
                    last10y: last10y,
                    since2020: m2020,
                    since2022: m2022,
                    trades: run.report.trades.count,
                    averageCashRatio: run.report.averageCashRatio,
                    maxTargetGross: maxTargetGross,
                    maxActualGross: maxActualGross,
                    minCashRatio: minCashRatio == Double.greatestFiniteMagnitude ? 0 : minCashRatio,
                    financedDays: financedDays
                ))
            }

            results.sort { lhs, rhs in
                let lhsScore = lhs.full.annualized + 0.40 * lhs.since2020.annualized + 0.20 * lhs.last10y.annualized
                    - 1.20 * max(lhs.full.maxDrawdown - 0.08, 0)
                let rhsScore = rhs.full.annualized + 0.40 * rhs.since2020.annualized + 0.20 * rhs.last10y.annualized
                    - 1.20 * max(rhs.full.maxDrawdown - 0.08, 0)
                if lhsScore == rhsScore { return lhs.full.sharpe > rhs.full.sharpe }
                return lhsScore > rhsScore
            }

            print("APP_ORTHOGONAL_STRATEGY_ZOO4")
            print("title,id,family,annualized,max_drawdown,volatility,sharpe,last10y_annualized,last10y_dd,since2020_annualized,since2020_dd,since2022_annualized,since2022_dd,trades,average_cash_ratio,max_target_gross,max_actual_gross,min_cash_ratio,financed_days")
            for row in results {
                print([
                    row.variant.title,
                    row.variant.id,
                    row.variant.family.rawValue,
                    String(format: "%.6f", row.full.annualized * 100),
                    String(format: "%.6f", row.full.maxDrawdown * 100),
                    String(format: "%.6f", row.full.volatility * 100),
                    String(format: "%.6f", row.full.sharpe),
                    String(format: "%.6f", row.last10y.annualized * 100),
                    String(format: "%.6f", row.last10y.maxDrawdown * 100),
                    String(format: "%.6f", row.since2020.annualized * 100),
                    String(format: "%.6f", row.since2020.maxDrawdown * 100),
                    String(format: "%.6f", row.since2022.annualized * 100),
                    String(format: "%.6f", row.since2022.maxDrawdown * 100),
                    String(row.trades),
                    String(format: "%.6f", row.averageCashRatio),
                    String(format: "%.6f", row.maxTargetGross),
                    String(format: "%.6f", row.maxActualGross),
                    String(format: "%.6f", row.minCashRatio),
                    String(row.financedDays),
                ].joined(separator: ","))
            }

            let championMode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceLowNoise
            let championInputs = championMode.requiredSignalAssetSymbols.compactMap { optionsBySymbol[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in seriesBySymbol[normalizedHistorySymbol(symbol)] }
            }
            if let champion = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                assetInputs: championInputs,
                initialCash: 100_000,
                settings: settings,
                mode: championMode
            ), let comparable = metrics(champion.report.points.filter { $0.date >= commonStart }) {
                print("APP_ORTHOGONAL_ZOO4_CHAMPION")
                print("annualized,max_drawdown,volatility,sharpe,trades,average_cash_ratio")
                print([
                    String(format: "%.6f", comparable.annualized * 100),
                    String(format: "%.6f", comparable.maxDrawdown * 100),
                    String(format: "%.6f", comparable.volatility * 100),
                    String(format: "%.6f", comparable.sharpe),
                    String(champion.report.trades.count),
                    String(format: "%.6f", champion.report.averageCashRatio),
                ].joined(separator: ","))
            }
            return
        }
