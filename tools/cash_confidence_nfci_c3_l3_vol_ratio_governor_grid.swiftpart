                    row.append(contentsOf: [a2020, s2020, a10, s10, a2022, s2022, tradeCount, eventCount])
                    print(row.joined(separator: ","))
                }
                print("vr_cap80_event_dates," + eventDates.joined(separator: "|"))
            }

            if let nearPeakValidation = runFixedVRNearPeakCap80Governor(excludedExecutionDate: nil, activationSignalDate: "0000-01-01"),
               let nearPeakMetrics = fixedVRMetrics(nearPeakValidation.0) {
                let eventDates = nearPeakValidation.1
                print("APP_CC_NFCI_C3_L3_VR80_CAP80_NEARPEAK4_JACKKNIFE")
                print("excluded,annualized,mdd,vol,sharpe,trades,events")
                print((["none"] + fixedVRMetricColumns(nearPeakMetrics.0) + [String(nearPeakValidation.0.report.trades.filter { $0.date >= commonStart }.count), String(eventDates.count)]).joined(separator: ","))
                for excluded in eventDates {
                    guard let result = runFixedVRNearPeakCap80Governor(excludedExecutionDate: excluded, activationSignalDate: "0000-01-01"),
                          let metrics = fixedVRMetrics(result.0) else { continue }
                    print(([excluded] + fixedVRMetricColumns(metrics.0) + [String(result.0.report.trades.filter { $0.date >= commonStart }.count), String(result.1.count)]).joined(separator: ","))
                }

                print("APP_CC_NFCI_C3_L3_VR80_CAP80_NEARPEAK4_ACTIVATION")
                print("activation,annualized,mdd,vol,sharpe,since2020_annualized,since2020_sharpe,last10_annualized,last10_sharpe,since2022_annualized,since2022_sharpe,trades,events")
                for activation in ["2015-01-01", "2017-01-01", "2019-01-01", "2020-01-01", "2021-01-01", "2022-01-01"] {
                    guard let result = runFixedVRNearPeakCap80Governor(excludedExecutionDate: nil, activationSignalDate: activation),
                          let metrics = fixedVRMetrics(result.0) else { continue }
                    let fullColumns = fixedVRMetricColumns(metrics.0)
                    let a2020 = metrics.1?.annualizedReturn.map { String(format: "%.6f", $0 * 100) } ?? "n/a"
                    let s2020 = metrics.1?.sharpeRatio.map { String(format: "%.6f", $0) } ?? "n/a"
                    let a10 = metrics.2?.annualizedReturn.map { String(format: "%.6f", $0 * 100) } ?? "n/a"
                    let s10 = metrics.2?.sharpeRatio.map { String(format: "%.6f", $0) } ?? "n/a"
                    let a2022 = metrics.3?.annualizedReturn.map { String(format: "%.6f", $0 * 100) } ?? "n/a"
                    let s2022 = metrics.3?.sharpeRatio.map { String(format: "%.6f", $0) } ?? "n/a"
                    let tradeCount = String(result.0.report.trades.filter { $0.date >= commonStart }.count)
                    let eventCount = String(result.1.count)
                    var row: [String] = [activation]
                    row.append(contentsOf: fullColumns)
                    row.append(contentsOf: [a2020, s2020, a10, s10, a2022, s2022, tradeCount, eventCount])
                    print(row.joined(separator: ","))
                }
                print("vr_cap80_nearpeak4_event_dates," + eventDates.joined(separator: "|"))
            }
            return
        }
