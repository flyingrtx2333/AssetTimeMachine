                guard let run = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                    assetInputs: inputs,
                    initialCash: 100_000,
                    settings: settings,
                    config: config,
                    rebalanceDecision: { index, signalIndex, data in
                        guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let executionKey = data.dates[index].recordDateString
                        guard productionTradeDates.contains(executionKey), var target = championTargets[executionKey] else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let signalKey = data.dates[signalIndex].recordDateString
                        if signalKey >= activationSignalDate,
                           executionKey != excludedExecutionDate,
                           championDrawdown.indices.contains(signalIndex),
                           championDrawdown[signalIndex] < 0.04,
                           volRatioPct.indices.contains(signalIndex),
                           let percentile = volRatioPct[signalIndex],
                           percentile >= 0.80 {
                            let gross = target.values.reduce(0, +)
                            if gross > 0.80, gross > 0 {
                                let scale = 0.80 / gross
                                target = target.mapValues { max($0, 0) * scale }
                                events.append(executionKey)
                            }
                        }
                        pending = target
                        return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                    },
                    targetWeights: { _, _ in pending }
                ) else { return nil }
                return (run, Array(Set(events)).sorted())
            }

            func fixedVRMetrics(_ run: ResearchTargetStrategyRun) -> (BacktestPerformanceMetrics, BacktestPerformanceMetrics?, BacktestPerformanceMetrics?, BacktestPerformanceMetrics?)? {
                let points = run.report.points.filter { $0.date >= commonStart }
                guard let full = BacktestMetricsCalculator.performanceMetrics(from: points) else { return nil }
                return (
                    full,
                    BacktestMetricsCalculator.performanceMetrics(from: points.filter { $0.date.recordDateString >= "2020-01-01" }),
                    BacktestMetricsCalculator.performanceMetrics(from: points.filter { $0.date.recordDateString >= "2016-08-10" }),
                    BacktestMetricsCalculator.performanceMetrics(from: points.filter { $0.date.recordDateString >= "2022-01-01" })
                )
            }
            func fixedVRMetricColumns(_ metrics: BacktestPerformanceMetrics) -> [String] {
                [
                    metrics.annualizedReturn.map { String(format: "%.6f", $0 * 100) } ?? "n/a",
                    String(format: "%.6f", metrics.maxDrawdown * 100),
                    metrics.annualizedVolatility.map { String(format: "%.6f", $0 * 100) } ?? "n/a",
                    metrics.sharpeRatio.map { String(format: "%.6f", $0) } ?? "n/a"
                ]
            }

            if let baselineValidation = runFixedVRGovernor(excludedExecutionDate: nil, activationSignalDate: "0000-01-01"),
               let baselineMetrics = fixedVRMetrics(baselineValidation.0) {
                let eventDates = baselineValidation.1
                print("APP_CC_NFCI_C3_L3_VR80_G80_JACKKNIFE")
                print("excluded,annualized,mdd,vol,sharpe,trades,events")
                print((["none"] + fixedVRMetricColumns(baselineMetrics.0) + [String(baselineValidation.0.report.trades.filter { $0.date >= commonStart }.count), String(eventDates.count)]).joined(separator: ","))
                for excluded in eventDates {
                    guard let result = runFixedVRGovernor(excludedExecutionDate: excluded, activationSignalDate: "0000-01-01"),
                          let metrics = fixedVRMetrics(result.0) else { continue }
                    print(([excluded] + fixedVRMetricColumns(metrics.0) + [String(result.0.report.trades.filter { $0.date >= commonStart }.count), String(result.1.count)]).joined(separator: ","))
                }

                print("APP_CC_NFCI_C3_L3_VR80_G80_ACTIVATION")
                print("activation,annualized,mdd,vol,sharpe,since2020_annualized,since2020_sharpe,last10_annualized,last10_sharpe,since2022_annualized,since2022_sharpe,trades,events")
                for activation in ["2015-01-01", "2017-01-01", "2019-01-01", "2020-01-01", "2021-01-01", "2022-01-01"] {
                    guard let result = runFixedVRGovernor(excludedExecutionDate: nil, activationSignalDate: activation),
                          let metrics = fixedVRMetrics(result.0) else { continue }
                    let m2020 = metrics.1
                    let m10 = metrics.2
                    let m2022 = metrics.3
                    let fullColumns = fixedVRMetricColumns(metrics.0)
                    let a2020 = m2020?.annualizedReturn.map { String(format: "%.6f", $0 * 100) } ?? "n/a"
                    let s2020 = m2020?.sharpeRatio.map { String(format: "%.6f", $0) } ?? "n/a"
                    let a10 = m10?.annualizedReturn.map { String(format: "%.6f", $0 * 100) } ?? "n/a"
                    let s10 = m10?.sharpeRatio.map { String(format: "%.6f", $0) } ?? "n/a"
                    let a2022 = m2022?.annualizedReturn.map { String(format: "%.6f", $0 * 100) } ?? "n/a"
                    let s2022 = m2022?.sharpeRatio.map { String(format: "%.6f", $0) } ?? "n/a"
                    let tradeCount = String(result.0.report.trades.filter { $0.date >= commonStart }.count)
                    let eventCount = String(result.1.count)
                    var row: [String] = [activation]
                    row.append(contentsOf: fullColumns)
                    row.append(contentsOf: [a2020, s2020, a10, s10, a2022, s2022, tradeCount, eventCount])
                    print(row.joined(separator: ","))
                }
                print("vr_event_dates," + eventDates.joined(separator: "|"))
            }

            if let capValidation = runFixedVRCap80Governor(excludedExecutionDate: nil, activationSignalDate: "0000-01-01"),
               let capMetrics = fixedVRMetrics(capValidation.0) {
                let eventDates = capValidation.1
                print("APP_CC_NFCI_C3_L3_VR80_CAP80_JACKKNIFE")
                print("excluded,annualized,mdd,vol,sharpe,trades,events")
                print((["none"] + fixedVRMetricColumns(capMetrics.0) + [String(capValidation.0.report.trades.filter { $0.date >= commonStart }.count), String(eventDates.count)]).joined(separator: ","))
                for excluded in eventDates {
                    guard let result = runFixedVRCap80Governor(excludedExecutionDate: excluded, activationSignalDate: "0000-01-01"),
                          let metrics = fixedVRMetrics(result.0) else { continue }
                    print(([excluded] + fixedVRMetricColumns(metrics.0) + [String(result.0.report.trades.filter { $0.date >= commonStart }.count), String(result.1.count)]).joined(separator: ","))
                }

                print("APP_CC_NFCI_C3_L3_VR80_CAP80_ACTIVATION")
                print("activation,annualized,mdd,vol,sharpe,since2020_annualized,since2020_sharpe,last10_annualized,last10_sharpe,since2022_annualized,since2022_sharpe,trades,events")
                for activation in ["2015-01-01", "2017-01-01", "2019-01-01", "2020-01-01", "2021-01-01", "2022-01-01"] {
                    guard let result = runFixedVRCap80Governor(excludedExecutionDate: nil, activationSignalDate: activation),
                          let metrics = fixedVRMetrics(result.0) else { continue }
                    let fullColumns = fixedVRMetricColumns(metrics.0)
                    let a2020 = metrics.1?.annualizedReturn.map { String(format: "%.6f", $0 * 100) } ?? "n/a"
                    let s2020 = metrics.1?.sharpeRatio.map { String(format: "%.6f", $0) } ?? "n/a"
                    let a10 = metrics.2?.annualizedReturn.map { String(format: "%.6f", $0 * 100) } ?? "n/a"
                    let s10 = metrics.2?.sharpeRatio.map { String(format: "%.6f", $0) } ?? "n/a"
                    let a2022 = metrics.3?.annualizedReturn.map { String(format: "%.6f", $0 * 100) } ?? "n/a"
                    let s2022 = metrics.3?.sharpeRatio.map { String(format: "%.6f", $0) } ?? "n/a"
                    let tradeCount = String(result.0.report.trades.filter { $0.date >= commonStart }.count)
