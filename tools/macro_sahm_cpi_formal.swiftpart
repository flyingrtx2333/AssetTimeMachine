        if ProcessInfo.processInfo.environment["ATM_MACRO_SAHM_CPI_FORMAL"] == "1" {
            let outputDir = ProcessInfo.processInfo.environment["ATM_MACRO_SAHM_CPI_OUTPUT_DIR"] ?? ""
            let macroDir = ProcessInfo.processInfo.environment["ATM_MACRO_SAHM_CPI_DATA_DIR"] ?? ""
            guard !outputDir.isEmpty, !macroDir.isEmpty,
                  let macroDataset = try? MacroInitialReleaseCSVLoader.load(
                    directory: URL(fileURLWithPath: macroDir, isDirectory: true)
                  ) else {
                print("MACRO_SAHM_CPI_INPUT_MISSING")
                return
            }
            let options = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let tradableInputs = [MacroSahmCPIStrategy.goldSymbol, MacroSahmCPIStrategy.nasdaqSymbol].compactMap { options[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { seriesBySymbol[normalizedHistorySymbol($0)] }
            }
            let fxOption = BacktestAssetOption(
                symbol: MacroSahmCPIStrategy.fxSymbol,
                title: "USD per CNY signal",
                color: .blue,
                requiresHistoricalFX: false,
                historicalFXSymbol: nil
            )
            let inputs = tradableInputs + [(
                assetSeries: seriesBySymbol[normalizedHistorySymbol(MacroSahmCPIStrategy.fxSymbol)],
                assetOption: fxOption,
                fxSeries: nil
            )]
            guard inputs.count == 3 else {
                print("MACRO_SAHM_CPI_MARKET_INPUTS_MISSING")
                return
            }

            func settings(feePercent: Double, slippagePercent: Double) -> AdvancedBacktestRiskSettings {
                AdvancedBacktestRiskSettings(
                    feeRate: feePercent,
                    slippageRate: slippagePercent,
                    maxPositionRatio: 100,
                    cooldownDays: 0,
                    stopLossRatio: 0,
                    takeProfitRatio: 0
                )
            }
            let config = ResearchTargetStrategyConfig(
                symbol: "macro_sahm_cpi_001",
                title: "MACRO-SAHM-CPI-001",
                warmupSessions: 1,
                rebalanceSessions: 1,
                rebalanceBand: 0,
                signalOnlySymbols: [MacroSahmCPIStrategy.fxSymbol],
                maxGrossExposure: 1,
                allowsFinancedExposure: false,
                financingAnnualRate: 0,
                buyReason: "MACRO-SAHM-CPI frozen schedule target"
            )

            var candidateSchedule: FrozenTargetSchedule?
            var appReplaySchedule: FrozenTargetSchedule?
            var equalWeightSchedule: FrozenTargetSchedule?
            var swapPlaceboSchedule: FrozenTargetSchedule?
            guard let bps25 = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                assetInputs: inputs,
                initialCash: 100_000,
                settings: settings(feePercent: 0.025, slippagePercent: 0),
                config: config,
                frozenSchedule: { frame in
                    let value = MacroSahmCPIStrategy.makeSchedule(frame: frame, dataset: macroDataset)
                    candidateSchedule = value
                    return value
                },
                targetWeights: { _, _ in [:] }
            ), let frozenSchedule = candidateSchedule,
            let appCost = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                assetInputs: inputs,
                initialCash: 100_000,
                settings: settings(feePercent: 1.00, slippagePercent: 0.05),
                config: config,
                frozenSchedule: { _ in
                    appReplaySchedule = frozenSchedule
                    return frozenSchedule
                },
                targetWeights: { _, _ in [:] }
            ), let equalWeightControl = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                assetInputs: inputs,
                initialCash: 100_000,
                settings: settings(feePercent: 1.00, slippagePercent: 0.05),
                config: config,
                frozenSchedule: { frame in
                    let value = MacroSahmCPIStrategy.makeSchedule(
                        frame: frame, dataset: macroDataset, variant: .naturallyDrifting5050Control
                    )
                    equalWeightSchedule = value
                    return value
                },
                targetWeights: { _, _ in [:] }
            ), let swapPlacebo = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                assetInputs: inputs,
                initialCash: 100_000,
                settings: settings(feePercent: 1.00, slippagePercent: 0.05),
                config: config,
                frozenSchedule: { frame in
                    let value = MacroSahmCPIStrategy.makeSchedule(
                        frame: frame, dataset: macroDataset, variant: .swapPlacebo
                    )
                    swapPlaceboSchedule = value
                    return value
                },
                targetWeights: { _, _ in [:] }
            ), let replayedSchedule = appReplaySchedule,
            let naturalSchedule = equalWeightSchedule,
            let placeboSchedule = swapPlaceboSchedule,
            let reviewClockFingerprint = frozenSchedule.reviewClockFingerprint,
            reviewClockFingerprint == naturalSchedule.reviewClockFingerprint,
            reviewClockFingerprint == placeboSchedule.reviewClockFingerprint,
            frozenSchedule.fingerprint == replayedSchedule.fingerprint else {
                print("MACRO_SAHM_CPI_RUN_FAILED")
                return
            }

            func metrics(_ points: [BacktestSeriesPoint]) -> [String: Any] {
                guard let value = BacktestMetricsCalculator.performanceMetrics(from: points) else {
                    return ["available": false]
                }
                return [
                    "available": true,
                    "start": points.first?.date.recordDateString ?? "",
                    "end": points.last?.date.recordDateString ?? "",
                    "observations": points.count,
                    "cagr_percent": (value.annualizedReturn ?? 0) * 100,
                    "mdd_percent": value.maxDrawdown * 100,
                    "sharpe": value.sharpeRatio as Any,
                    "total_return": value.totalReturn
                ]
            }
            func sliced(_ points: [BacktestSeriesPoint], start: String) -> [BacktestSeriesPoint] {
                points.filter { $0.date.recordDateString >= start }
            }
            func lastTenYearStart(_ points: [BacktestSeriesPoint]) -> String {
                guard let last = points.last?.date,
                      let start = BacktestSeriesAlignment.historicalSeriesCalendar.date(
                        byAdding: .year, value: -10, to: last
                      ) else { return "" }
                return start.recordDateString
            }
            func windows(_ points: [BacktestSeriesPoint]) -> [String: Any] {
                [
                    "full_history": metrics(points),
                    "last_10_years": metrics(sliced(points, start: lastTenYearStart(points))),
                    "since_2020": metrics(sliced(points, start: "2020-01-01")),
                    "since_2022": metrics(sliced(points, start: "2022-01-01"))
                ]
            }
            func constraints(_ run: ResearchTargetStrategyRun) -> [String: Any] {
                let maxTargetGross = run.dailyStates.map { $0.targetWeights.values.reduce(0, +) }.max() ?? 0
                let minTargetWeight = run.dailyStates.flatMap { $0.targetWeights.values }.min() ?? 0
                let minCash = run.dailyStates.map(\.cash).min() ?? 0
                let maxActualGross = run.dailyStates.map { state -> Double in
                    guard state.portfolioValue > 0 else { return 0 }
                    return max(state.portfolioValue - state.cash, 0) / state.portfolioValue
                }.max() ?? 0
                let tradedSymbols = Set(run.report.trades.map(\.assetSymbol))
                let pass = maxTargetGross <= 1.000000001 && maxActualGross <= 1.000000001
                    && minTargetWeight >= -1e-10 && minCash >= -1e-8
                    && tradedSymbols.isSubset(of: MacroSahmCPIStrategy.tradableSymbols)
                return [
                    "max_target_gross": maxTargetGross,
                    "max_actual_gross": maxActualGross,
                    "min_target_weight": minTargetWeight,
                    "min_cash": minCash,
                    "traded_symbols": tradedSymbols.sorted(),
                    "financing_allowed": false,
                    "shorting_allowed": false,
                    "pass": pass
                ]
            }
            func cagr(_ metric: [String: Any]) -> Double { metric["cagr_percent"] as? Double ?? -.infinity }
            func mdd(_ metric: [String: Any]) -> Double { metric["mdd_percent"] as? Double ?? .infinity }
            func sharpe(_ metric: [String: Any]) -> Double { metric["sharpe"] as? Double ?? -.infinity }

            let bpsWindows = windows(bps25.report.points)
            let appWindows = windows(appCost.report.points)
            let equalWeightWindows = windows(equalWeightControl.report.points)
            let swapWindows = windows(swapPlacebo.report.points)
            let appConstraints = constraints(appCost)
            let full = appWindows["full_history"] as! [String: Any]
            let last10 = appWindows["last_10_years"] as! [String: Any]
            let since2020 = appWindows["since_2020"] as! [String: Any]
            let since2022 = appWindows["since_2022"] as! [String: Any]
            let checks: [String: Bool] = [
                "full_cagr_ge_10pct": cagr(full) >= 10,
                "last10_cagr_ge_10pct": cagr(last10) >= 10,
                "since2020_cagr_ge_10pct": cagr(since2020) >= 10,
                "since2022_cagr_ge_10pct": cagr(since2022) >= 10,
                "full_mdd_le_10pct": mdd(full) <= 10,
                "last10_mdd_le_10pct": mdd(last10) <= 10,
                "since2020_mdd_le_10pct": mdd(since2020) <= 10,
                "since2022_mdd_le_10pct": mdd(since2022) <= 10,
                "full_sharpe_gt_natural_50_50": sharpe(full) > sharpe(equalWeightWindows["full_history"] as! [String: Any]),
                "full_sharpe_gt_swap_placebo": sharpe(full) > sharpe(swapWindows["full_history"] as! [String: Any]),
                "constraints_pass": appConstraints["pass"] as? Bool == true,
                "same_immutable_schedule_at_both_costs": frozenSchedule.fingerprint == replayedSchedule.fingerprint,
                "same_macro_review_clock_for_candidate_and_controls": reviewClockFingerprint == naturalSchedule.reviewClockFingerprint
                    && reviewClockFingerprint == placeboSchedule.reviewClockFingerprint
            ]
            let gate: [String: Any] = ["checks": checks, "pass": checks.values.allSatisfy { $0 }]
            let decision = checks.values.allSatisfy { $0 } ? "PASS" : "REJECTED"
            let result: [String: Any] = [
                "protocol_id": ProcessInfo.processInfo.environment["ATM_SVP_PROTOCOL_ID"] ?? "ATM-SVP-2",
                "trial_id": ProcessInfo.processInfo.environment["ATM_SVP_TRIAL_ID"] ?? MacroSahmCPIStrategy.trialID,
                "candidate_id": MacroSahmCPIStrategy.candidateID,
                "engine_version": BacktestEngine.defaultEngineVersion,
                "same_schedule_replayed_at_both_costs": frozenSchedule.fingerprint == replayedSchedule.fingerprint,
                "macro_review_clock_fingerprint": reviewClockFingerprint,
                "formal_bps25": [
                    "metrics": bpsWindows,
                    "constraints": constraints(bps25),
                    "schedule_fingerprint": frozenSchedule.fingerprint,
                    "schedule_event_count": frozenSchedule.events.count,
                    "review_clock_fingerprint": reviewClockFingerprint
                ],
                "app_product_cost": [
                    "metrics": appWindows,
                    "constraints": appConstraints,
                    "schedule_fingerprint": replayedSchedule.fingerprint,
                    "schedule_event_count": replayedSchedule.events.count,
                    "review_clock_fingerprint": reviewClockFingerprint,
                    "mechanical_product_gate": gate
                ],
                "controls": [
                    "naturally_drifting_50_50": [
                        "metrics": equalWeightWindows,
                        "constraints": constraints(equalWeightControl),
                        "schedule_fingerprint": naturalSchedule.fingerprint,
                        "schedule_event_count": naturalSchedule.events.count,
                        "review_clock_fingerprint": reviewClockFingerprint,
                        "role": "fixed control; cannot rescue candidate"
                    ],
                    "swap_placebo": [
                        "metrics": swapWindows,
                        "constraints": constraints(swapPlacebo),
                        "schedule_fingerprint": placeboSchedule.fingerprint,
                        "schedule_event_count": placeboSchedule.events.count,
                        "review_clock_fingerprint": reviewClockFingerprint,
                        "role": "falsification control; cannot replace candidate"
                    ]
                ],
                "decision": decision,
                "no_parameter_rescue": true
            ]

            func writePortfolio(_ root: URL, _ name: String, _ points: [BacktestSeriesPoint]) throws {
                let rows = ["date,portfolio_value"] + points.map { "\($0.date.recordDateString),\($0.portfolioValue)" }
                try (rows.joined(separator: "\n") + "\n").write(
                    to: root.appendingPathComponent("\(name)-portfolio.csv"), atomically: true, encoding: .utf8
                )
            }
            func writeSchedule(_ root: URL, _ name: String, _ schedule: FrozenTargetSchedule) throws {
                let rows = ["signal_index,signal_date,gold_target,nasdaq_target,reason,reference_month,unrate_row_hash,cpi_row_hash"] + schedule.events.map {
                    "\($0.signalIndex),\($0.signalDate.recordDateString),\($0.targetWeights[MacroSahmCPIStrategy.goldSymbol] ?? 0),\($0.targetWeights[MacroSahmCPIStrategy.nasdaqSymbol] ?? 0),\($0.reason),\($0.referenceMonth ?? ""),\($0.macroRowHashes["UNRATE"] ?? ""),\($0.macroRowHashes["CPIAUCSL"] ?? "")"
                }
                try (rows.joined(separator: "\n") + "\n").write(
                    to: root.appendingPathComponent("\(name)-schedule.csv"), atomically: true, encoding: .utf8
                )
            }
            do {
                let manager = FileManager.default
                try manager.createDirectory(atPath: outputDir, withIntermediateDirectories: true)
                let root = URL(fileURLWithPath: outputDir)
                let data = try JSONSerialization.data(withJSONObject: result, options: [.prettyPrinted, .sortedKeys])
                try data.write(to: root.appendingPathComponent("candidate-metrics.json"))
                try writeSchedule(root, "MACRO-SAHM-CPI-001", frozenSchedule)
                try writeSchedule(root, "CONTROL-NATURAL-50-50", naturalSchedule)
                try writeSchedule(root, "CONTROL-SWAP-PLACEBO", placeboSchedule)
                try writePortfolio(root, "MACRO-SAHM-CPI-001-BPS25", bps25.report.points)
                try writePortfolio(root, "MACRO-SAHM-CPI-001-APP", appCost.report.points)
                try writePortfolio(root, "CONTROL-NATURAL-50-50", equalWeightControl.report.points)
                try writePortfolio(root, "CONTROL-SWAP-PLACEBO", swapPlacebo.report.points)
            } catch {
                print("MACRO_SAHM_CPI_OUTPUT_FAILED \(error)")
                return
            }
            print("MACRO_SAHM_CPI_FORMAL_COMPLETE trial_id=\(MacroSahmCPIStrategy.trialID) decision=\(decision) schedule_fingerprint=\(frozenSchedule.fingerprint)")
            return
        }
