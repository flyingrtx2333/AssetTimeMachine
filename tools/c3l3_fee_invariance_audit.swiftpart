        if ProcessInfo.processInfo.environment["ATM_C3L3_FEE_INVARIANCE_AUDIT"] == "1" {
            func loadAuditSeries(_ path: String) -> [(releaseDate: String, value: Double)] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [] }
                return text.split(whereSeparator: \.isNewline).dropFirst().compactMap { line in
                    let f = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard f.count >= 3, let v = Double(f[2]), v.isFinite else { return nil }
                    return (String(f[0]), v)
                }.sorted { $0.0 < $1.0 }
            }
            func auditChange(_ s: [(releaseDate: String, value: Double)], _ d: String, _ n: Int) -> Double? {
                var latest: Int?
                for i in s.indices { if s[i].releaseDate <= d { latest = i } else { break } }
                guard let i = latest, i >= n else { return nil }
                return s[i].value - s[i-n].value
            }
            func targetFingerprint(_ run: ResearchTargetStrategyRun) -> String {
                var h: UInt64 = 1469598103934665603
                let symbols = ["gold_cny", "nasdaq", "sp500", "csi300", "shanghai_composite"]
                for state in run.dailyStates {
                    for symbol in symbols {
                        var x = UInt64(bitPattern: Int64(((state.targetWeights[symbol] ?? 0) * 1_000_000).rounded()))
                        for _ in 0..<8 {
                            h ^= x & UInt64(0xff)
                            h &*= UInt64(1099511628211)
                            x = x >> 8
                        }
                    }
                }
                return String(format: "%016llx", h)
            }
            let creditSeries = loadAuditSeries("tools/research-results/NFCICREDIT_initial_release.csv")
            let leverageSeries = loadAuditSeries("tools/research-results/NFCILEVERAGE_initial_release.csv")
            guard creditSeries.count >= 700, leverageSeries.count >= 700 else { return }
            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceLowNoise
            let options = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { options[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { seriesBySymbol[normalizedHistorySymbol($0)] }
            }
            let fees: [Double] = [1.0, 0.75, 0.50, 0.25, 0.10, 0.03, 0.0]
            let us: Set<String> = ["nasdaq", "sp500"]
            print("APP_C3L3_FEE_INVARIANCE_AUDIT")
            print("fee,cagr,mdd,vol,sharpe,trades,events,target_fingerprint")
            for fee in fees {
                let localSettings = AdvancedBacktestRiskSettings(
                    feeRate: fee, slippageRate: 0.05, maxPositionRatio: 100,
                    cooldownDays: 0, stopLossRatio: 0, takeProfitRatio: 0
                )
                guard let base = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                    assetInputs: inputs, initialCash: 100_000, settings: localSettings, mode: mode
                ) else { continue }
                let baseTargets = Dictionary(uniqueKeysWithValues: base.dailyStates.map { ($0.date.recordDateString, $0.targetWeights) })
                let baseTrades = Set(base.report.trades.map { $0.date.recordDateString })
                let config = ResearchTargetStrategyConfig(
                    symbol: "c3l3_fee_invariance", title: "C3L3 fee invariance",
                    warmupSessions: 21, rebalanceSessions: 1, rebalanceBand: 0.244,
                    maxGrossExposure: 1, allowsFinancedExposure: false, financingAnnualRate: 0,
                    buyReason: "C3L3 fee invariance"
                )
                var previousBase: [String: Double] = [:]
                var pending: [String: Double] = [:]
                var events = 0
                guard let run = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                    assetInputs: inputs, initialCash: 100_000, settings: localSettings, config: config,
                    rebalanceDecision: { index, signalIndex, data in
                        guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let execution = data.dates[index].recordDateString
                        guard baseTrades.contains(execution), var target = baseTargets[execution] else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let prior = previousBase; previousBase = target
                        guard !prior.isEmpty else { pending = target; return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false) }
                        let signal = data.dates[signalIndex].recordDateString
                        let c = auditChange(creditSeries, signal, 8).map { $0 <= -0.03 } ?? false
                        let l = auditChange(leverageSeries, signal, 4).map { $0 <= -0.03 } ?? false
                        let priorGross = prior.values.reduce(0,+), proposedGross = target.values.reduce(0,+)
                        let priorUS = prior.reduce(0.0) { $0 + (us.contains($1.key) ? $1.value : 0) }
                        let proposedUS = target.reduce(0.0) { $0 + (us.contains($1.key) ? $1.value : 0) }
                        let usDrop = priorUS - proposedUS, grossDrop = priorGross - proposedGross
                        var extras: [String: Double] = [:]
                        if c || l {
                            if usDrop >= 0.05, grossDrop >= 0.03 {
                                let retention = c && l ? 1.0 : 0.5
                                for symbol in us {
                                    let reduction = max((prior[symbol] ?? 0) - (target[symbol] ?? 0), 0)
                                    if reduction > 0 { extras[symbol] = retention * reduction }
                                }
                            } else if grossDrop >= 0.05 {
                                for (symbol, weight) in prior {
                                    let reduction = max(weight - (target[symbol] ?? 0), 0)
                                    if reduction > 0 { extras[symbol] = reduction }
                                }
                            }
                        }
                        let desired = extras.values.reduce(0,+)
                        if desired > 0 {
                            let scale = min(1.0, max(1.0 - proposedGross, 0) / desired)
                            for (symbol, extra) in extras { target[symbol, default: 0] += extra * scale }
                            events += 1
                        }
                        let gross = target.values.reduce(0,+)
                        if gross > 1, gross > 0 { target = target.mapValues { max($0,0) / gross } }
                        pending = target
                        return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                    },
                    targetWeights: { _, _ in pending }
                ) else { continue }
                print([
                    String(format:"%.4f",fee),
                    String(format:"%.6f",(run.report.annualizedReturn ?? 0)*100),
                    String(format:"%.6f",run.report.maxDrawdown*100),
                    String(format:"%.6f",(run.report.annualizedVolatility ?? 0)*100),
                    String(format:"%.6f",run.report.sharpeRatio ?? 0),
                    String(run.report.trades.count), String(events), targetFingerprint(run)
                ].joined(separator:","))
            }
            return
        }
