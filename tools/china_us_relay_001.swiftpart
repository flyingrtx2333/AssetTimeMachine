        if ProcessInfo.processInfo.environment["ATM_CHINA_US_RELAY_001"] == "1" {
            let formal = ProcessInfo.processInfo.environment["ATM_CHINA_US_RELAY_001_FORMAL"] == "1"
            let outputDir = ProcessInfo.processInfo.environment["ATM_CHINA_US_RELAY_001_OUTPUT_DIR"]
            let tradeSymbols = ["nasdaq", "sp500"]
            let signalSymbols = ["csi300", "shanghai_composite"]
            let requiredSymbols = tradeSymbols + signalSymbols
            let options = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let allInputs = requiredSymbols.compactMap { options[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }
            guard allInputs.count == requiredSymbols.count else {
                print("CHINA_US_RELAY_001_INPUTS_MISSING")
                return
            }

            let dateFormatter = DateFormatter()
            dateFormatter.calendar = BacktestSeriesAlignment.historicalSeriesCalendar
            dateFormatter.locale = Locale(identifier: "en_US_POSIX")
            dateFormatter.timeZone = BacktestSeriesAlignment.historicalSeriesCalendar.timeZone
            dateFormatter.dateFormat = "yyyy-MM-dd"
            guard let evaluationStart = dateFormatter.date(from: "2005-01-05"),
                  let evaluationEnd = dateFormatter.date(from: "2026-08-20") else {
                print("CHINA_US_RELAY_001_DATE_PARSE_FAILED")
                return
            }
            let evaluationBounds = evaluationStart...evaluationEnd
            let folds: [(String, String, String)] = [
                ("2005-2008", "2005-01-05", "2008-12-31"),
                ("2009-2012", "2009-01-01", "2012-12-31"),
                ("2013-2016", "2013-01-01", "2016-12-31"),
                ("2017-2020", "2017-01-01", "2020-12-31"),
                ("2021-2022", "2021-01-01", "2022-12-31"),
                ("2023-2024", "2023-01-01", "2024-12-31"),
                ("2025-latest", "2025-01-01", "9999-12-31")
            ]

            enum RelayPathMode {
                case candidate
                case matchedAvailabilityControl
                case cash
            }

            func makeSettings(slippagePercent: Double) -> AdvancedBacktestRiskSettings {
                AdvancedBacktestRiskSettings(
                    feeRate: 0.005,
                    slippageRate: slippagePercent,
                    maxPositionRatio: 100,
                    cooldownDays: 0,
                    stopLossRatio: 0,
                    takeProfitRatio: 0
                )
            }

            func runPath(
                id: String,
                selectedTradeSymbols: [String],
                mode: RelayPathMode,
                slippagePercent: Double
            ) -> ResearchIntradayRoundTripRun? {
                let fixedSleeveWeight = 1.0 / Double(max(1, selectedTradeSymbols.count))
                var csiBarsCache: [ChinaUSRelay001Bar]?
                var shanghaiBarsCache: [ChinaUSRelay001Bar]?
                let config = ResearchTargetStrategyConfig(
                    symbol: id,
                    title: "中美接力001",
                    warmupSessions: 2,
                    rebalanceSessions: 1,
                    maxGrossExposure: 1,
                    allowsFinancedExposure: false,
                    financingAnnualRate: 0,
                    buyReason: "中国收盘风险偏好 -> 美股开盘"
                )
                return BacktestEngine.runResearchIntradayRoundTripStrategyWithTrace(
                    assetInputs: allInputs,
                    initialCash: 100_000,
                    settings: makeSettings(slippagePercent: slippagePercent),
                    config: config,
                    dateBounds: evaluationBounds,
                    targetWeights: { context, data in
                        guard mode != .cash else { return [:] }
                        guard let csiSource = data.barsBySymbol["csi300"],
                              let shSource = data.barsBySymbol["shanghai_composite"],
                              let csiIndex = data.barIndexByDateBySymbol["csi300"]?[context.date],
                              let shIndex = data.barIndexByDateBySymbol["shanghai_composite"]?[context.date] else {
                            return [:]
                        }
                        let csiBars: [ChinaUSRelay001Bar]
                        if let cached = csiBarsCache {
                            csiBars = cached
                        } else {
                            let converted = csiSource.map { ChinaUSRelay001Bar(close: $0.close) }
                            csiBarsCache = converted
                            csiBars = converted
                        }
                        let shBars: [ChinaUSRelay001Bar]
                        if let cached = shanghaiBarsCache {
                            shBars = cached
                        } else {
                            let converted = shSource.map { ChinaUSRelay001Bar(close: $0.close) }
                            shanghaiBarsCache = converted
                            shBars = converted
                        }
                        guard let chinaRiskOn = ChinaUSRelay001Logic.chinaRiskOn(
                            csi300: csiBars,
                            csiIndex: csiIndex,
                            shanghai: shBars,
                            shanghaiIndex: shIndex
                        ) else { return [:] }
                        if mode == .candidate && !chinaRiskOn { return [:] }

                        var weights: [String: Double] = [:]
                        for symbol in selectedTradeSymbols {
                            guard data.barIndexByDateBySymbol[symbol]?[context.date] != nil else { continue }
                            weights[symbol] = fixedSleeveWeight
                        }
                        guard weights.count == selectedTradeSymbols.count else { return [:] }
                        return weights
                    },
                    takeProfitPrice: { _, _, _ in nil }
                )
            }

            func foldMetrics(_ points: [BacktestSeriesPoint]) -> [[String: Any]] {
                folds.map { name, start, end in
                    let slice = points.filter {
                        let key = $0.date.recordDateString
                        return key >= start && key <= end
                    }
                    let metrics = BacktestMetricsCalculator.performanceMetrics(from: slice)
                    return [
                        "name": name,
                        "cagr_percent": (metrics?.annualizedReturn ?? 0) * 100,
                        "mdd_percent": (metrics?.maxDrawdown ?? 0) * 100,
                        "sharpe": metrics?.sharpeRatio ?? 0,
                        "sessions": slice.count
                    ]
                }
            }

            func tradeStats(_ returns: [Double]) -> [String: Any] {
                let gains = returns.filter { $0 > 0 }
                let losses = returns.filter { $0 < 0 }
                let grossProfit = gains.reduce(0, +)
                let grossLoss = abs(losses.reduce(0, +))
                return [
                    "round_trips": returns.count,
                    "win_rate_percent": returns.isEmpty ? 0 : Double(gains.count) / Double(returns.count) * 100,
                    "average_return_percent": returns.isEmpty ? 0 : returns.reduce(0, +) / Double(returns.count) * 100,
                    "profit_factor": grossLoss > 0 ? grossProfit / grossLoss : (grossProfit > 0 ? 999.0 : 0.0)
                ]
            }

            func pathDocument(_ id: String, _ run: ResearchIntradayRoundTripRun) -> [String: Any] {
                let points = run.report.points
                let since2020 = BacktestMetricsCalculator.performanceMetrics(
                    from: points.filter { $0.date.recordDateString >= "2020-01-01" }
                )
                let since2022 = BacktestMetricsCalculator.performanceMetrics(
                    from: points.filter { $0.date.recordDateString >= "2022-01-01" }
                )
                let allReturns = tradeSymbols.flatMap { run.audit.realizedReturnsBySymbol[$0] ?? [] }
                let activeSessions = run.dailyStates.filter { state in
                    tradeSymbols.contains { (state.targetWeights[$0] ?? 0) > 0 }
                }.count
                var hash: UInt64 = 1469598103934665603
                for state in run.dailyStates {
                    for symbol in tradeSymbols {
                        var value = UInt64(bitPattern: Int64(((state.targetWeights[symbol] ?? 0) * 1_000_000).rounded()))
                        for _ in 0..<8 {
                            hash ^= value & UInt64(0xff)
                            hash &*= UInt64(1099511628211)
                            value >>= 8
                        }
                    }
                }
                return [
                    "id": id,
                    "start": points.first?.date.recordDateString ?? "",
                    "end": points.last?.date.recordDateString ?? "",
                    "sessions": points.count,
                    "active_sessions": activeSessions,
                    "cagr_percent": (run.report.annualizedReturn ?? 0) * 100,
                    "mdd_percent": run.report.maxDrawdown * 100,
                    "volatility_percent": (run.report.annualizedVolatility ?? 0) * 100,
                    "sharpe": run.report.sharpeRatio ?? 0,
                    "total_return_percent": run.report.totalReturn * 100,
                    "average_intraday_gross": run.report.averageExposureRatio,
                    "max_intraday_gross": run.audit.maxIntradayGrossExposure,
                    "minimum_end_of_day_cash": run.audit.minimumEndOfDayCash,
                    "overnight_position_days": run.audit.overnightPositionDays,
                    "round_trips_by_symbol": run.audit.roundTripsBySymbol,
                    "trade_stats": tradeStats(allReturns),
                    "since2020_cagr_percent": (since2020?.annualizedReturn ?? 0) * 100,
                    "since2020_sharpe": since2020?.sharpeRatio ?? 0,
                    "since2022_cagr_percent": (since2022?.annualizedReturn ?? 0) * 100,
                    "since2022_sharpe": since2022?.sharpeRatio ?? 0,
                    "folds": foldMetrics(points),
                    "target_fingerprint": String(format: "%016llx", hash)
                ]
            }

            let candidateSpecs: [(String, [String])] = [
                ("CUS001-NASDAQ", ["nasdaq"]),
                ("CUS001-SP500", ["sp500"]),
                ("CUS001-COMBINED", tradeSymbols)
            ]
            let controlSpecs: [(String, [String])] = [
                ("C-CHINA-AVAILABLE-NASDAQ", ["nasdaq"]),
                ("C-CHINA-AVAILABLE-SP500", ["sp500"]),
                ("C-CHINA-AVAILABLE-COMBINED", tradeSymbols)
            ]
            var candidateRuns: [(String, ResearchIntradayRoundTripRun)] = []
            var controlRuns: [(String, ResearchIntradayRoundTripRun)] = []
            for spec in candidateSpecs {
                guard let run = runPath(
                    id: spec.0,
                    selectedTradeSymbols: spec.1,
                    mode: .candidate,
                    slippagePercent: 0
                ) else {
                    print("CHINA_US_RELAY_001_CANDIDATE_RUN_FAILED=\(spec.0)")
                    return
                }
                candidateRuns.append((spec.0, run))
            }
            for spec in controlSpecs {
                guard let run = runPath(
                    id: spec.0,
                    selectedTradeSymbols: spec.1,
                    mode: .matchedAvailabilityControl,
                    slippagePercent: 0
                ) else {
                    print("CHINA_US_RELAY_001_CONTROL_RUN_FAILED=\(spec.0)")
                    return
                }
                controlRuns.append((spec.0, run))
            }
            guard let cashRun = runPath(
                id: "C-CASH-COMBINED",
                selectedTradeSymbols: tradeSymbols,
                mode: .cash,
                slippagePercent: 0
            ), let stressRun = runPath(
                id: "CUS001-COMBINED-SLIP005",
                selectedTradeSymbols: tradeSymbols,
                mode: .candidate,
                slippagePercent: 0.05
            ) else {
                print("CHINA_US_RELAY_001_AUDIT_RUN_FAILED")
                return
            }

            let candidateCombined = candidateRuns.first { $0.0 == "CUS001-COMBINED" }!.1
            if !formal {
                let trades = candidateCombined.audit.roundTripsBySymbol.values.reduce(0, +)
                print("CHINA_US_RELAY_001_SMOKE_TRADE_COUNT=\(trades)")
                print("CHINA_US_RELAY_001_SMOKE_MAX_GROSS=\(String(format: "%.10f", candidateCombined.audit.maxIntradayGrossExposure))")
                print("CHINA_US_RELAY_001_SMOKE_OVERNIGHT_DAYS=\(candidateCombined.audit.overnightPositionDays)")
                print("CHINA_US_RELAY_001_SMOKE_MIN_CASH=\(String(format: "%.6f", candidateCombined.audit.minimumEndOfDayCash))")
                print("CHINA_US_RELAY_001_SMOKE_OK")
                return
            }

            if let outputDir {
                try? FileManager.default.createDirectory(atPath: outputDir, withIntermediateDirectories: true)
                for (id, run) in candidateRuns + controlRuns + [("C-CASH-COMBINED", cashRun), ("CUS001-COMBINED-SLIP005", stressRun)] {
                    var lines = ["date,portfolio_value"]
                    lines.append(contentsOf: run.report.points.map {
                        "\($0.date.recordDateString),\(String(format: "%.10f", $0.portfolioValue))"
                    })
                    let path = URL(fileURLWithPath: outputDir).appendingPathComponent("\(id)-portfolio.csv").path
                    try? (lines.joined(separator: "\n") + "\n").write(toFile: path, atomically: true, encoding: .utf8)
                }
            }

            let document: [String: Any] = [
                "trial_id": "ATM-SVP3-CHINA-US-RELAY-001",
                "candidate_id": "S-CHINA-US-RELAY-001",
                "candidate_paths": candidateRuns.map { pathDocument($0.0, $0.1) },
                "matched_control_paths": controlRuns.map { pathDocument($0.0, $0.1) },
                "cash_control": pathDocument("C-CASH-COMBINED", cashRun),
                "slippage_stress": pathDocument("CUS001-COMBINED-SLIP005", stressRun),
                "fee_rate_per_fill": 0.00005,
                "primary_slippage_rate_per_fill": 0.0,
                "stress_slippage_rate_per_fill": 0.0005,
                "evaluation_start": "2005-01-05",
                "evaluation_end": "2026-08-20"
            ]
            guard JSONSerialization.isValidJSONObject(document),
                  let json = try? JSONSerialization.data(withJSONObject: document, options: [.sortedKeys]),
                  let text = String(data: json, encoding: .utf8) else {
                print("CHINA_US_RELAY_001_JSON_FAILED")
                return
            }
            print("CHINA_US_RELAY_001_FORMAL_JSON=" + text)
            print("CHINA_US_RELAY_001_FORMAL_OK")
            return
        }
