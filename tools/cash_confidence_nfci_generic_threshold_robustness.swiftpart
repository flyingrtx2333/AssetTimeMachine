        if ProcessInfo.processInfo.environment["ATM_CC_NFCI_GENERIC_THRESHOLD_ROBUSTNESS"] == "1" {
            struct GenericThresholdCandidate {
                let creditThreshold: Double
                let leverageThreshold: Double
                let genericRetention: Double
                let annualized: Double
                let maxDrawdown: Double
                let volatility: Double
                let sharpe: Double
                let since2020Annualized: Double
                let since2020Sharpe: Double
                let last10Annualized: Double
                let last10Sharpe: Double
                let trades: Int
                let events: Int
                let maxTargetGross: Double
                let maxActualGross: Double
                let minCash: Double
                let financedDays: Int
            }
            func loadGenericThresholdSeries(_ path: String) -> [(releaseDate: String, value: Double)] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [] }
                return text.split(whereSeparator: \.isNewline).dropFirst().compactMap { line in
                    let fields = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard fields.count >= 3, let value = Double(fields[2]), value.isFinite else { return nil }
                    return (String(fields[0]), value)
                }.sorted { $0.0 < $1.0 }
            }
            let creditSeries = loadGenericThresholdSeries("tools/research-results/NFCICREDIT_initial_release.csv")
            let leverageSeries = loadGenericThresholdSeries("tools/research-results/NFCILEVERAGE_initial_release.csv")
            guard creditSeries.count >= 700, leverageSeries.count >= 700 else { return }
            func genericThresholdChange(_ series: [(releaseDate: String, value: Double)], on date: String, lookback: Int) -> Double? {
                var latest: Int?
                for i in series.indices {
                    if series[i].releaseDate <= date { latest = i } else { break }
                }
                guard let latest, latest >= lookback else { return nil }
                return series[latest].value - series[latest - lookback].value
            }
            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceLowNoise
            let optionsBySymbol = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { optionsBySymbol[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }
            guard let baseRun = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                assetInputs: inputs, initialCash: 100_000, settings: settings, mode: mode
            ), let baseStartDate = baseRun.report.points.first?.date else { return }
            let baseTargets = Dictionary(uniqueKeysWithValues: baseRun.dailyStates.map { ($0.date.recordDateString, $0.targetWeights) })
            let baseTradeDates = Set(baseRun.report.trades.map { $0.date.recordDateString })
            let usSymbols: Set<String> = ["nasdaq", "sp500"]
            var candidates: [GenericThresholdCandidate] = []
            for creditThreshold in [-0.02, -0.03, -0.04] {
                for leverageThreshold in [-0.03, -0.04, -0.05] {
                    for genericRetention in [0.75, 0.90, 1.00] {
                        let config = ResearchTargetStrategyConfig(
                            symbol: "cc_nfci_generic_threshold_robustness",
                            title: "Generic threshold robustness",
                            warmupSessions: 21, rebalanceSessions: 1, rebalanceBand: 0.244,
                            maxGrossExposure: 1.0, allowsFinancedExposure: false,
                            financingAnnualRate: 0, buyReason: "Generic threshold robustness"
                        )
                        var previousBase: [String: Double] = [:]
                        var pending: [String: Double] = [:]
                        var events = 0
                        guard let run = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                            assetInputs: inputs, initialCash: 100_000, settings: settings, config: config,
                            rebalanceDecision: { index, signalIndex, data in
                                guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else {
                                    return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                                }
                                let executionKey = data.dates[index].recordDateString
                                guard baseTradeDates.contains(executionKey), var target = baseTargets[executionKey] else {
                                    return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                                }
                                let prior = previousBase
                                previousBase = target
                                guard !prior.isEmpty else {
                                    pending = target
                                    return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                                }
                                let signalKey = data.dates[signalIndex].recordDateString
                                let credit = genericThresholdChange(creditSeries, on: signalKey, lookback: 8).map { $0 <= creditThreshold } ?? false
                                let leverage = genericThresholdChange(leverageSeries, on: signalKey, lookback: 4).map { $0 <= leverageThreshold } ?? false
                                let priorGross = prior.values.reduce(0, +)
                                let proposedGross = target.values.reduce(0, +)
                                let priorUS = prior.reduce(0.0) { $0 + (usSymbols.contains($1.key) ? $1.value : 0) }
                                let proposedUS = target.reduce(0.0) { $0 + (usSymbols.contains($1.key) ? $1.value : 0) }
                                let usDecrease = priorUS - proposedUS
                                let grossDecrease = priorGross - proposedGross
                                var extras: [String: Double] = [:]
                                if credit || leverage {
                                    if usDecrease >= 0.05, grossDecrease >= 0.03 {
                                        let retention = credit && leverage ? 1.00 : 0.50
                                        for symbol in usSymbols {
                                            let reduction = max((prior[symbol] ?? 0) - (target[symbol] ?? 0), 0)
                                            if reduction > 0 { extras[symbol] = retention * reduction }
                                        }
                                    } else if grossDecrease >= 0.05 {
                                        for (symbol, priorWeight) in prior {
                                            let reduction = max(priorWeight - (target[symbol] ?? 0), 0)
                                            if reduction > 0 { extras[symbol] = genericRetention * reduction }
                                        }
                                    }
                                }
                                let desired = extras.values.reduce(0, +)
                                if desired > 0 {
                                    let cash = max(1.0 - proposedGross, 0)
                                    let scale = min(1.0, cash / desired)
                                    for (symbol, extra) in extras { target[symbol, default: 0] += extra * scale }
                                    events += 1
                                }
                                let gross = target.values.reduce(0, +)
                                if gross > 1, gross > 0 { target = target.mapValues { max($0, 0) / gross } }
                                pending = target
                                return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                            },
                            targetWeights: { _, _ in pending }
                        ) else { continue }
                        let points = run.report.points.filter { $0.date >= baseStartDate }
                        guard let metrics = BacktestMetricsCalculator.performanceMetrics(from: points) else { continue }
                        let p2020 = points.filter { $0.date.recordDateString >= "2020-01-01" }
                        let p10 = points.filter { $0.date.recordDateString >= "2016-08-15" }
                        let m2020 = BacktestMetricsCalculator.performanceMetrics(from: p2020)
                        let m10 = BacktestMetricsCalculator.performanceMetrics(from: p10)
                        var maxTargetGross = 0.0
                        var maxActualGross = 0.0
                        var minCash = Double.greatestFiniteMagnitude
                        var financedDays = 0
                        for state in run.dailyStates where state.portfolioValue > 0 && state.date >= baseStartDate {
                            maxTargetGross = max(maxTargetGross, state.targetWeights.values.reduce(0, +))
                            maxActualGross = max(maxActualGross, state.holdingsBySymbol.values.reduce(0, +) / state.portfolioValue)
                            minCash = min(minCash, state.cash / state.portfolioValue)
                            if state.cash < -0.0001 { financedDays += 1 }
                        }
                        candidates.append(.init(
                            creditThreshold: creditThreshold,
                            leverageThreshold: leverageThreshold,
                            genericRetention: genericRetention,
                            annualized: metrics.annualizedReturn ?? -1,
                            maxDrawdown: metrics.maxDrawdown,
                            volatility: metrics.annualizedVolatility ?? -1,
                            sharpe: metrics.sharpeRatio ?? -1,
                            since2020Annualized: m2020?.annualizedReturn ?? -1,
                            since2020Sharpe: m2020?.sharpeRatio ?? -1,
                            last10Annualized: m10?.annualizedReturn ?? -1,
                            last10Sharpe: m10?.sharpeRatio ?? -1,
                            trades: run.report.trades.filter { $0.date >= baseStartDate }.count,
                            events: events,
                            maxTargetGross: maxTargetGross,
                            maxActualGross: maxActualGross,
                            minCash: minCash == Double.greatestFiniteMagnitude ? 0 : minCash,
                            financedDays: financedDays
                        ))
                    }
                }
            }
            candidates.sort { lhs, rhs in
                if abs(lhs.sharpe - rhs.sharpe) > 1e-12 { return lhs.sharpe > rhs.sharpe }
                return lhs.annualized > rhs.annualized
            }
            print("APP_CC_NFCI_GENERIC_THRESHOLD_ROBUSTNESS_BASE")
            print(String(format: "%.6f,%.6f,%.6f,%d", (baseRun.report.annualizedReturn ?? 0)*100, baseRun.report.maxDrawdown*100, baseRun.report.sharpeRatio ?? 0, baseRun.report.trades.count))
            print("APP_CC_NFCI_GENERIC_THRESHOLD_ROBUSTNESS")
            print("rank,credit_threshold,leverage_threshold,generic_retention,annualized,max_drawdown,volatility,sharpe,since2020_annualized,since2020_sharpe,last10_annualized,last10_sharpe,trades,events,max_target_gross,max_actual_gross,min_cash,financed_days")
            for (rank, c) in candidates.enumerated() {
                print([
                    String(rank + 1),
                    String(format: "%.2f", c.creditThreshold),
                    String(format: "%.2f", c.leverageThreshold),
                    String(format: "%.2f", c.genericRetention),
                    String(format: "%.6f", c.annualized * 100),
                    String(format: "%.6f", c.maxDrawdown * 100),
                    String(format: "%.6f", c.volatility * 100),
                    String(format: "%.6f", c.sharpe),
                    String(format: "%.6f", c.since2020Annualized * 100),
                    String(format: "%.6f", c.since2020Sharpe),
                    String(format: "%.6f", c.last10Annualized * 100),
                    String(format: "%.6f", c.last10Sharpe),
                    String(c.trades), String(c.events),
                    String(format: "%.9f", c.maxTargetGross),
                    String(format: "%.9f", c.maxActualGross),
                    String(format: "%.9f", c.minCash), String(c.financedDays)
                ].joined(separator: ","))
            }
            return
        }
