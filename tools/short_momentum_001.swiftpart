        if ProcessInfo.processInfo.environment["ATM_SHORT_MOMENTUM_001"] == "1" {
            let formal = ProcessInfo.processInfo.environment["ATM_SHORT_MOMENTUM_001_FORMAL"] == "1"
            let outputDir = ProcessInfo.processInfo.environment["ATM_SHORT_MOMENTUM_001_OUTPUT_DIR"]
            let symbols = ["gold_cny", "nasdaq", "sp500", "csi300", "shanghai_composite"]
            let options = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = symbols.compactMap { options[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }
            guard inputs.count == symbols.count else {
                print("SHORT_MOMENTUM_001_INPUTS_MISSING")
                return
            }

            let settings = AdvancedBacktestRiskSettings(
                feeRate: 1.00,
                slippageRate: 0.05,
                maxPositionRatio: 100,
                cooldownDays: 0,
                stopLossRatio: 0,
                takeProfitRatio: 0
            )
            let formatter = DateFormatter()
            formatter.calendar = BacktestSeriesAlignment.historicalSeriesCalendar
            formatter.locale = Locale(identifier: "en_US_POSIX")
            formatter.timeZone = BacktestSeriesAlignment.historicalSeriesCalendar.timeZone
            formatter.dateFormat = "yyyy-MM-dd"
            guard let evaluationStart = formatter.date(from: "2002-07-03"),
                  let evaluationEnd = formatter.date(from: "2026-08-20") else {
                print("SHORT_MOMENTUM_001_DATE_PARSE_FAILED")
                return
            }
            let bounds = evaluationStart...evaluationEnd
            let folds: [(String, String, String)] = [
                ("2002-2005", "2002-07-03", "2005-12-31"),
                ("2006-2008", "2006-01-01", "2008-12-31"),
                ("2009-2011", "2009-01-01", "2011-12-31"),
                ("2012-2014", "2012-01-01", "2014-12-31"),
                ("2015-2017", "2015-01-01", "2017-12-31"),
                ("2018-2021", "2018-01-01", "2021-12-31"),
                ("2022-latest", "2022-01-01", "9999-12-31")
            ]

            enum ShortMomentumMode { case shortMomentum, annualEqual, cash }

            func config(_ id: String) -> ResearchTargetStrategyConfig {
                ResearchTargetStrategyConfig(
                    symbol: id,
                    title: "跨资产短期动量001",
                    warmupSessions: 40,
                    rebalanceSessions: 1,
                    rebalanceBand: 0,
                    maxGrossExposure: 1,
                    allowsFinancedExposure: false,
                    financingAnnualRate: 0,
                    buyReason: "上一完整自然月正收益冠军"
                )
            }

            func monthBoundary(index: Int, signalIndex: Int, data: ResearchTargetDataContext) -> Bool {
                guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else { return false }
                return String(data.dates[index].recordDateString.prefix(7)) != String(data.dates[signalIndex].recordDateString.prefix(7))
            }

            func yearBoundary(index: Int, signalIndex: Int, data: ResearchTargetDataContext) -> Bool {
                guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else { return false }
                return String(data.dates[index].recordDateString.prefix(4)) != String(data.dates[signalIndex].recordDateString.prefix(4))
            }

            func runPath(
                id: String,
                mode: ShortMomentumMode
            ) -> (run: ResearchTargetStrategyRun, ownerByMonth: [String: String])? {
                var firstDecision = true
                var lastOwner: String? = nil
                var ownerByMonth: [String: String] = [:]
                guard let run = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                    assetInputs: inputs,
                    initialCash: 100_000,
                    settings: settings,
                    config: config(id),
                    dateBounds: bounds,
                    rebalanceDecision: { index, signalIndex, data in
                        guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        if firstDecision {
                            firstDecision = false
                            if mode == .shortMomentum {
                                lastOwner = ShortMomentum001Logic.owner(
                                    signalIndex: signalIndex,
                                    dateKeys: data.dates.map(\.recordDateString),
                                    pricesBySymbol: data.pricesBySymbol,
                                    symbols: symbols
                                )
                            }
                            return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                        }
                        switch mode {
                        case .cash:
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        case .annualEqual:
                            return BacktestRebalanceDecision(shouldRebalance: yearBoundary(index: index, signalIndex: signalIndex, data: data), refreshOverlay: false)
                        case .shortMomentum:
                            guard monthBoundary(index: index, signalIndex: signalIndex, data: data) else {
                                return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                            }
                            let owner = ShortMomentum001Logic.owner(
                                signalIndex: signalIndex,
                                dateKeys: data.dates.map(\.recordDateString),
                                pricesBySymbol: data.pricesBySymbol,
                                symbols: symbols
                            )
                            let changed = owner != lastOwner
                            lastOwner = owner
                            return BacktestRebalanceDecision(shouldRebalance: changed, refreshOverlay: false)
                        }
                    },
                    targetWeights: { context, data in
                        switch mode {
                        case .cash:
                            return [:]
                        case .annualEqual:
                            let weight = 1.0 / Double(symbols.count)
                            return Dictionary(uniqueKeysWithValues: symbols.map { ($0, weight) })
                        case .shortMomentum:
                            let owner = ShortMomentum001Logic.owner(
                                signalIndex: context.signalIndex,
                                dateKeys: data.dates.map(\.recordDateString),
                                pricesBySymbol: data.pricesBySymbol,
                                symbols: symbols
                            )
                            let month = String(context.date.recordDateString.prefix(7))
                            ownerByMonth[month] = owner ?? "cash"
                            guard let owner else { return [:] }
                            return [owner: 1.0]
                        }
                    }
                ) else { return nil }
                return (run, ownerByMonth)
            }

            guard let candidatePair = runPath(id: "STMOM001", mode: .shortMomentum),
                  let equalPair = runPath(id: "C-ANNUAL-EQUAL", mode: .annualEqual),
                  let cashPair = runPath(id: "C-CASH", mode: .cash) else {
                print("SHORT_MOMENTUM_001_RUN_FAILED")
                return
            }

            func points(_ run: ResearchTargetStrategyRun) -> [BacktestSeriesPoint] {
                run.report.points.filter { $0.date >= evaluationStart && $0.date <= evaluationEnd }
            }
            func states(_ run: ResearchTargetStrategyRun) -> [BacktestDailyState] {
                run.dailyStates.filter { $0.date >= evaluationStart && $0.date <= evaluationEnd }
            }
            func targetFingerprint(_ dailyStates: [BacktestDailyState]) -> String {
                var hash: UInt64 = 1469598103934665603
                for state in dailyStates {
                    for symbol in symbols {
                        var value = UInt64(bitPattern: Int64(((state.targetWeights[symbol] ?? 0) * 1_000_000).rounded()))
                        for _ in 0..<8 {
                            hash ^= value & UInt64(0xff)
                            hash &*= UInt64(1099511628211)
                            value >>= 8
                        }
                    }
                }
                return String(format: "%016llx", hash)
            }
            func foldMetrics(_ source: [BacktestSeriesPoint]) -> [[String: Any]] {
                folds.map { name, start, end in
                    let slice = source.filter {
                        $0.date.recordDateString >= start && $0.date.recordDateString <= end
                    }
                    let metrics = BacktestMetricsCalculator.performanceMetrics(from: slice)
                    return [
                        "name": name,
                        "sessions": slice.count,
                        "cagr_percent": (metrics?.annualizedReturn ?? 0) * 100,
                        "mdd_percent": (metrics?.maxDrawdown ?? 0) * 100,
                        "sharpe": metrics?.sharpeRatio ?? 0
                    ]
                }
            }
            func pathDocument(
                _ id: String,
                _ run: ResearchTargetStrategyRun,
                owners: [String: String]
            ) -> [String: Any] {
                let p = points(run)
                let s = states(run)
                let m = BacktestMetricsCalculator.performanceMetrics(from: p)
                let m20 = BacktestMetricsCalculator.performanceMetrics(from: p.filter { $0.date.recordDateString >= "2020-01-01" })
                let m22 = BacktestMetricsCalculator.performanceMetrics(from: p.filter { $0.date.recordDateString >= "2022-01-01" })
                let realizedGross = s.map { state -> Double in
                    guard state.portfolioValue > 0 else { return 0 }
                    return state.holdingsBySymbol.values.reduce(0, +) / state.portfolioValue
                }
                return [
                    "id": id,
                    "start": p.first?.date.recordDateString ?? "",
                    "end": p.last?.date.recordDateString ?? "",
                    "sessions": p.count,
                    "cagr_percent": (m?.annualizedReturn ?? 0) * 100,
                    "mdd_percent": (m?.maxDrawdown ?? 0) * 100,
                    "volatility_percent": (m?.annualizedVolatility ?? 0) * 100,
                    "sharpe": m?.sharpeRatio ?? 0,
                    "trades": run.report.trades.count,
                    "average_cash_ratio": run.report.averageCashRatio,
                    "max_gross": realizedGross.max() ?? 0,
                    "minimum_cash": s.map(\.cash).min() ?? 0,
                    "target_fingerprint": targetFingerprint(s),
                    "since2020_cagr_percent": (m20?.annualizedReturn ?? 0) * 100,
                    "since2020_sharpe": m20?.sharpeRatio ?? 0,
                    "since2022_cagr_percent": (m22?.annualizedReturn ?? 0) * 100,
                    "since2022_sharpe": m22?.sharpeRatio ?? 0,
                    "folds": foldMetrics(p),
                    "owner_by_month": owners
                ]
            }

            let candidateDoc = pathDocument("STMOM001", candidatePair.run, owners: candidatePair.ownerByMonth)
            let equalDoc = pathDocument("C-ANNUAL-EQUAL", equalPair.run, owners: [:])
            let cashDoc = pathDocument("C-CASH", cashPair.run, owners: [:])

            if !formal {
                let trades = candidateDoc["trades"] as? Int ?? 0
                let maxGross = candidateDoc["max_gross"] as? Double ?? 0
                let minCash = candidateDoc["minimum_cash"] as? Double ?? -1
                let ownerMonths = (candidateDoc["owner_by_month"] as? [String: String])?.count ?? 0
                print("SHORT_MOMENTUM_001_SMOKE_TRADES=\(trades)")
                print("SHORT_MOMENTUM_001_SMOKE_MAX_GROSS=\(String(format: "%.10f", maxGross))")
                print("SHORT_MOMENTUM_001_SMOKE_MIN_CASH=\(String(format: "%.6f", minCash))")
                print("SHORT_MOMENTUM_001_SMOKE_OWNER_MONTHS=\(ownerMonths)")
                guard trades > 0, maxGross <= 1.000000001, minCash >= -1e-6, ownerMonths >= 200 else {
                    print("SHORT_MOMENTUM_001_SMOKE_INVALID")
                    return
                }
                print("SHORT_MOMENTUM_001_SMOKE_OK")
                return
            }

            if let outputDir {
                try? FileManager.default.createDirectory(atPath: outputDir, withIntermediateDirectories: true)
                for (id, run) in [("STMOM001", candidatePair.run), ("C-ANNUAL-EQUAL", equalPair.run), ("C-CASH", cashPair.run)] {
                    var lines = ["date,portfolio_value"]
                    lines.append(contentsOf: points(run).map {
                        "\($0.date.recordDateString),\(String(format: "%.10f", $0.portfolioValue))"
                    })
                    let path = URL(fileURLWithPath: outputDir).appendingPathComponent("\(id)-portfolio.csv").path
                    try? (lines.joined(separator: "\n") + "\n").write(toFile: path, atomically: true, encoding: .utf8)
                }
            }

            let document: [String: Any] = [
                "trial_id": "ATM-SVP3-SHORT-MOMENTUM-001",
                "candidate_id": "S-SHORT-MOMENTUM-001",
                "candidate": candidateDoc,
                "annual_equal_control": equalDoc,
                "cash_control": cashDoc,
                "fee_percent_per_trade": 1.00,
                "slippage_percent_per_trade": 0.05,
                "evaluation_start": "2002-07-03",
                "evaluation_end": "2026-08-20",
                "rule": "at each new calendar month, hold 100% of the single asset with the highest strictly positive return over the immediately preceding complete calendar month; otherwise hold cash; trade only when owner changes"
            ]
            guard JSONSerialization.isValidJSONObject(document),
                  let json = try? JSONSerialization.data(withJSONObject: document, options: [.sortedKeys]),
                  let text = String(data: json, encoding: .utf8) else {
                print("SHORT_MOMENTUM_001_JSON_FAILED")
                return
            }
            print("SHORT_MOMENTUM_001_FORMAL_JSON=" + text)
            print("SHORT_MOMENTUM_001_FORMAL_OK")
            return
        }
