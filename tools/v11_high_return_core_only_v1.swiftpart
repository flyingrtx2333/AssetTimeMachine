        if ProcessInfo.processInfo.environment["ATM_V11_HIGH_CORE_ONLY_V1"] == "1" {
            func loadHighCoreNFCI(_ path: String) -> [BacktestNFCIPoint] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [] }
                return text.split(whereSeparator: \.isNewline).dropFirst().compactMap { line in
                    let fields = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard fields.count >= 3, let value = Double(fields[2]), value.isFinite else { return nil }
                    return BacktestNFCIPoint(releaseDate: String(fields[0]), referenceDate: String(fields[1]), availableAt: nil, value: value)
                }
            }

            let formal = ProcessInfo.processInfo.environment["ATM_V11_HIGH_CORE_ONLY_V1_FORMAL"] == "1"
            let outputDir = ProcessInfo.processInfo.environment["ATM_V11_HIGH_CORE_ONLY_V1_OUTPUT_DIR"]
            let roleSymbols = ["gold_cny", "nasdaq", "sp500", "csi300", "shanghai_composite"]
            let mode: AdvancedBacktestStrategyMode = .nfciDualCoreSimplifiedV11
            let options = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { options[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { seriesBySymbol[normalizedHistorySymbol($0)] }
            }
            let settings = AdvancedBacktestRiskSettings(feeRate: 1.00, slippageRate: 0.05, maxPositionRatio: 100, cooldownDays: 0, stopLossRatio: 0, takeProfitRatio: 0)
            let lowFeeSettings = AdvancedBacktestRiskSettings(feeRate: 0.03, slippageRate: 0.05, maxPositionRatio: 100, cooldownDays: 0, stopLossRatio: 0, takeProfitRatio: 0)
            let nfci = BacktestNFCIAsOfData(
                source: "ALFRED initial-release fixture",
                credit: loadHighCoreNFCI("tools/research-results/NFCICREDIT_initial_release.csv"),
                leverage: loadHighCoreNFCI("tools/research-results/NFCILEVERAGE_initial_release.csv")
            )
            guard let control = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                assetInputs: inputs, initialCash: 100_000, settings: settings, mode: mode, nfciAsOf: nfci
            ), let candidate = BacktestEngine.runSimplifiedV11HighReturnCoreForResearch(
                assetInputs: inputs, initialCash: 100_000, settings: settings, nfciAsOf: nfci
            ), let lowFeeCandidate = BacktestEngine.runSimplifiedV11HighReturnCoreForResearch(
                assetInputs: inputs, initialCash: 100_000, settings: lowFeeSettings, nfciAsOf: nfci
            ) else {
                print("V11_HIGH_CORE_ONLY_BUILD_FAILED")
                return
            }

            func targetFingerprint(_ states: [BacktestDailyState]) -> String {
                var hash: UInt64 = 1469598103934665603
                for state in states {
                    for symbol in roleSymbols {
                        var value = UInt64(bitPattern: Int64(((state.targetWeights[symbol] ?? 0) * 1_000_000).rounded()))
                        for _ in 0..<8 {
                            hash ^= value & UInt64(0xff)
                            hash &*= UInt64(1099511628211)
                            value >>= 8
                        }
                    }
                }
                return String(format: "%016llx", hash)
            }

            func constraints(_ states: [BacktestDailyState]) -> (maxGross: Double, minWeight: Double) {
                let maxGross = states.map { state in roleSymbols.reduce(0.0) { $0 + max(state.targetWeights[$1] ?? 0, 0) } }.max() ?? 0
                let values = states.flatMap { state in roleSymbols.map { state.targetWeights[$0] ?? 0 } }
                return (maxGross, values.min() ?? 0)
            }

            let folds: [(String, String, String)] = [
                ("2012-2014", "2012-07-05", "2014-12-31"),
                ("2015-2016", "2015-01-01", "2016-12-31"),
                ("2017-2018", "2017-01-01", "2018-12-31"),
                ("2019-2020", "2019-01-01", "2020-12-31"),
                ("2021-2022", "2021-01-01", "2022-12-31"),
                ("2023-2024", "2023-01-01", "2024-12-31"),
                ("2025-latest", "2025-01-01", "9999-12-31")
            ]
            func foldMetrics(_ points: [BacktestSeriesPoint]) -> [(String, Double, Double, Double)] {
                folds.map { name, start, end in
                    let slice = points.filter { $0.date.recordDateString >= start && $0.date.recordDateString <= end }
                    let metrics = BacktestMetricsCalculator.performanceMetrics(from: slice)
                    return (name, metrics?.annualizedReturn ?? 0, metrics?.maxDrawdown ?? 0, metrics?.sharpeRatio ?? 0)
                }
            }
            func writePortfolio(_ id: String, _ points: [BacktestSeriesPoint]) {
                guard formal, let outputDir else { return }
                try? FileManager.default.createDirectory(atPath: outputDir, withIntermediateDirectories: true)
                let path = URL(fileURLWithPath: outputDir).appendingPathComponent("\(id)-portfolio.csv").path
                var lines = ["date,portfolio_value"]
                lines.append(contentsOf: points.map { "\($0.date.recordDateString),\(String(format: "%.10f", $0.portfolioValue))" })
                try? (lines.joined(separator: "\n") + "\n").write(toFile: path, atomically: true, encoding: .utf8)
            }
            func printPath(_ id: String, _ run: AdvancedRotationStrategyRun) {
                let c = constraints(run.dailyStates)
                let m2020 = BacktestMetricsCalculator.performanceMetrics(from: run.report.points.filter { $0.date.recordDateString >= "2020-01-01" })
                let m2022 = BacktestMetricsCalculator.performanceMetrics(from: run.report.points.filter { $0.date.recordDateString >= "2022-01-01" })
                let fs = foldMetrics(run.report.points)
                print("candidate_id=\(id)")
                print("cagr=\(String(format: "%.6f", (run.report.annualizedReturn ?? 0) * 100))")
                print("mdd=\(String(format: "%.6f", run.report.maxDrawdown * 100))")
                print("vol=\(String(format: "%.6f", (run.report.annualizedVolatility ?? 0) * 100))")
                print("sharpe=\(String(format: "%.6f", run.report.sharpeRatio ?? 0))")
                print("trades=\(run.report.trades.count)")
                print("average_cash=\(String(format: "%.6f", run.report.averageCashRatio))")
                print("max_gross=\(String(format: "%.10f", c.maxGross))")
                print("min_weight=\(String(format: "%.10f", c.minWeight))")
                print("fingerprint=\(targetFingerprint(run.dailyStates))")
                print("since2020_cagr=\(String(format: "%.6f", (m2020?.annualizedReturn ?? 0) * 100))")
                print("since2020_sharpe=\(String(format: "%.6f", m2020?.sharpeRatio ?? 0))")
                print("since2022_cagr=\(String(format: "%.6f", (m2022?.annualizedReturn ?? 0) * 100))")
                print("since2022_sharpe=\(String(format: "%.6f", m2022?.sharpeRatio ?? 0))")
                print("fold_names=\(fs.map { $0.0 }.joined(separator: ";"))")
                print("fold_sharpes=\(fs.map { String(format: "%.6f", $0.3) }.joined(separator: ";"))")
                print("fold_cagrs=\(fs.map { String(format: "%.6f", $0.1 * 100) }.joined(separator: ";"))")
                print("fold_mdds=\(fs.map { String(format: "%.6f", $0.2 * 100) }.joined(separator: ";"))")
                print("END_CANDIDATE")
                writePortfolio(id, run.report.points)
            }

            print("V11_HIGH_CORE_ONLY_V1")
            print("control_fingerprint=\(targetFingerprint(control.dailyStates))")
            print("candidate_fingerprint=\(targetFingerprint(candidate.dailyStates))")
            print("candidate_low_fee_fingerprint=\(targetFingerprint(lowFeeCandidate.dailyStates))")
            let c = constraints(candidate.dailyStates)
            print("candidate_max_gross=\(String(format: "%.10f", c.maxGross))")
            print("candidate_min_weight=\(String(format: "%.10f", c.minWeight))")
            if !formal {
                print("V11_HIGH_CORE_ONLY_V1_COMPLETE")
                return
            }
            printPath("V11-CONTROL", control)
            printPath("S-V11-HIGHCORE-ONLY", candidate)
            print("V11_HIGH_CORE_ONLY_V1_COMPLETE")
            return
        }
