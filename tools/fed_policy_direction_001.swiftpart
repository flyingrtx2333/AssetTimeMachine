        if ProcessInfo.processInfo.environment["ATM_FED_POLICY_DIRECTION_001"] == "1" {
            let formal = ProcessInfo.processInfo.environment["ATM_FED_POLICY_DIRECTION_001_FORMAL"] == "1"
            let outputDir = ProcessInfo.processInfo.environment["ATM_FED_POLICY_DIRECTION_001_OUTPUT_DIR"]
            let symbols = ["qqq_tr", "spy_tr"]

            func loadAdjustedCloseSeries(path: String, symbol: String, label: String) -> PublicHistorySeries? {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return nil }
                var dates: [String] = []; var prices: [Double] = []
                for line in text.split(whereSeparator: \.isNewline).dropFirst() {
                    let f = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard f.count >= 2, let v = Double(f[1]), v.isFinite, v > 0 else { continue }
                    dates.append(String(f[0])); prices.append(v)
                }
                guard dates.count >= 500, dates.count == prices.count else { return nil }
                return PublicHistorySeries(symbol: symbol, category: "us_etf_total_return_proxy", label: label, currency: "USD", unit: "adjusted_close", source: "Frozen Yahoo adjusted close", dates: dates, prices: prices, hasOHLC: false, ohlcSource: nil, ohlcCoverageRatio: nil, openPrices: nil, highPrices: nil, lowPrices: nil, closePrices: nil, volumes: nil)
            }

            func loadPolicyEvents(path: String) -> [FedPolicyDirection001Logic.Event] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [] }
                return text.split(whereSeparator: \.isNewline).dropFirst().compactMap { line in
                    let f = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard f.count >= 2 else { return nil }
                    let direction = String(f[1])
                    let state: FedPolicyDirection001Logic.State
                    if direction == "down" { state = .easing }
                    else if direction == "up" { state = .tightening }
                    else { return nil }
                    return FedPolicyDirection001Logic.Event(dateKey: String(f[0]), state: state)
                }.sorted { $0.dateKey < $1.dateKey }
            }

            guard let qqq = loadAdjustedCloseSeries(path: "tools/research-results/strategy-validation/factor-data/ATM-SVP2-ORTHO-FACTOR-005/QQQ.csv", symbol: "qqq_tr", label: "QQQ adjusted-close TR"),
                  let spy = loadAdjustedCloseSeries(path: "tools/research-results/strategy-validation/factor-data/ATM-SVP2-ORTHO-FACTOR-003/SPY.csv", symbol: "spy_tr", label: "SPY adjusted-close TR"),
                  let fx = seriesBySymbol["usd_per_cny"] else { print("FED_POLICY_DIRECTION_001_INPUTS_MISSING"); return }
            let events = loadPolicyEvents(path: "tools/research-results/strategy-validation/factor-data/FED-POLICY-DIRECTION-OFFICIAL-2026-08-23/policy_changes.csv")
            guard !events.isEmpty else { print("FED_POLICY_DIRECTION_001_EVENTS_MISSING"); return }

            func option(_ s: PublicHistorySeries, _ title: String, _ color: Color) -> BacktestAssetOption {
                BacktestAssetOption(symbol: s.symbol, title: title, color: color, requiresHistoricalFX: true, historicalFXSymbol: "usd_per_cny", currency: "USD")
            }
            let inputs = [
                (assetSeries: Optional(qqq), assetOption: option(qqq, "QQQ", AssetTheme.accentRed), fxSeries: Optional(fx)),
                (assetSeries: Optional(spy), assetOption: option(spy, "SPY", AssetTheme.textPrimary), fxSeries: Optional(fx))
            ]
            let settings = AdvancedBacktestRiskSettings(feeRate: 1.00, slippageRate: 0.05, maxPositionRatio: 100, cooldownDays: 0, stopLossRatio: 0, takeProfitRatio: 0)
            let formatter = DateFormatter(); formatter.calendar = BacktestSeriesAlignment.historicalSeriesCalendar; formatter.locale = Locale(identifier: "en_US_POSIX"); formatter.timeZone = BacktestSeriesAlignment.historicalSeriesCalendar.timeZone; formatter.dateFormat = "yyyy-MM-dd"
            guard let start = formatter.date(from: "2001-01-04"), let end = formatter.date(from: "2026-08-13") else { print("FED_POLICY_DIRECTION_001_DATE_FAILED"); return }
            let bounds = start...end
            let folds: [(String,String,String)] = [
                ("2001-2004","2001-01-04","2004-12-31"), ("2005-2008","2005-01-01","2008-12-31"), ("2009-2012","2009-01-01","2012-12-31"),
                ("2013-2016","2013-01-01","2016-12-31"), ("2017-2020","2017-01-01","2020-12-31"), ("2021-2023","2021-01-01","2023-12-31"), ("2024-latest","2024-01-01","9999-12-31")
            ]
            enum Mode { case policy, qqq, cash }
            func config(_ id: String) -> ResearchTargetStrategyConfig { ResearchTargetStrategyConfig(symbol: id, title: "Fed Policy Direction 001", warmupSessions: 2, rebalanceSessions: 1, rebalanceBand: 0, maxGrossExposure: 1, allowsFinancedExposure: false, financingAnnualRate: 0, buyReason: "最近一次Fed政策目标变动方向") }
            func runPath(_ id: String, _ mode: Mode) -> ResearchTargetStrategyRun? {
                var first = true
                return BacktestEngine.runResearchTargetProviderStrategyWithTrace(assetInputs: inputs, initialCash: 100_000, settings: settings, config: config(id), dateBounds: bounds, rebalanceDecision: { index, signalIndex, data in
                    guard data.dates.indices.contains(index) else { return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false) }
                    if first { first = false; return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false) }
                    guard mode == .policy, data.dates.indices.contains(signalIndex) else { return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false) }
                    let current = FedPolicyDirection001Logic.state(executionDateKey: data.dates[index].recordDateString, events: events)
                    let prior = FedPolicyDirection001Logic.state(executionDateKey: data.dates[signalIndex].recordDateString, events: events)
                    return BacktestRebalanceDecision(shouldRebalance: current != prior, refreshOverlay: false)
                }, targetWeights: { context, _ in
                    switch mode {
                    case .cash: return [:]
                    case .qqq: return ["qqq_tr": 1.0]
                    case .policy:
                        return FedPolicyDirection001Logic.state(executionDateKey: context.date.recordDateString, events: events) == .easing ? ["qqq_tr": 1.0] : [:]
                    }
                })
            }
            guard let candidate = runPath("FEDPOL001", .policy), let control = runPath("C-QQQ-BUYHOLD", .qqq), let cash = runPath("C-CASH", .cash) else { print("FED_POLICY_DIRECTION_001_RUN_FAILED"); return }
            func pts(_ r: ResearchTargetStrategyRun) -> [BacktestSeriesPoint] { r.report.points.filter { $0.date >= start && $0.date <= end } }
            func sts(_ r: ResearchTargetStrategyRun) -> [BacktestDailyState] { r.dailyStates.filter { $0.date >= start && $0.date <= end } }
            func fp(_ ss: [BacktestDailyState]) -> String { var h: UInt64 = 1469598103934665603; for s in ss { for sym in symbols { var v=UInt64(bitPattern:Int64(((s.targetWeights[sym] ?? 0)*1_000_000).rounded())); for _ in 0..<8 { h ^= v & UInt64(0xff); h &*= UInt64(1099511628211); v >>= 8 } } }; return String(format:"%016llx",h) }
            func foldMetrics(_ p:[BacktestSeriesPoint]) -> [[String:Any]] { folds.map { name,a,b in let x=p.filter{$0.date.recordDateString>=a && $0.date.recordDateString<=b}; let m=BacktestMetricsCalculator.performanceMetrics(from:x); return ["name":name,"sessions":x.count,"cagr_percent":(m?.annualizedReturn ?? 0)*100,"mdd_percent":(m?.maxDrawdown ?? 0)*100,"sharpe":m?.sharpeRatio ?? 0] } }
            func doc(_ id:String,_ r:ResearchTargetStrategyRun)->[String:Any] { let p=pts(r),s=sts(r),m=BacktestMetricsCalculator.performanceMetrics(from:p),m20=BacktestMetricsCalculator.performanceMetrics(from:p.filter{$0.date.recordDateString>="2020-01-01"}),m22=BacktestMetricsCalculator.performanceMetrics(from:p.filter{$0.date.recordDateString>="2022-01-01"}); let g=s.map{x in x.portfolioValue>0 ? x.holdingsBySymbol.values.reduce(0,+)/x.portfolioValue:0}; return ["id":id,"start":p.first?.date.recordDateString ?? "","end":p.last?.date.recordDateString ?? "","sessions":p.count,"cagr_percent":(m?.annualizedReturn ?? 0)*100,"mdd_percent":(m?.maxDrawdown ?? 0)*100,"volatility_percent":(m?.annualizedVolatility ?? 0)*100,"sharpe":m?.sharpeRatio ?? 0,"trades":r.report.trades.count,"average_cash_ratio":r.report.averageCashRatio,"max_gross":g.max() ?? 0,"minimum_cash":s.map(\.cash).min() ?? 0,"target_fingerprint":fp(s),"since2020_cagr_percent":(m20?.annualizedReturn ?? 0)*100,"since2020_sharpe":m20?.sharpeRatio ?? 0,"since2022_cagr_percent":(m22?.annualizedReturn ?? 0)*100,"since2022_sharpe":m22?.sharpeRatio ?? 0,"folds":foldMetrics(p)] }
            let cdoc=doc("FEDPOL001",candidate), qdoc=doc("C-QQQ-BUYHOLD",control), cashdoc=doc("C-CASH",cash)
            if !formal { let t=cdoc["trades"] as? Int ?? 0,g=cdoc["max_gross"] as? Double ?? 0,mc=cdoc["minimum_cash"] as? Double ?? -1; print("FED_POLICY_DIRECTION_001_SMOKE_TRADES=\(t)"); print("FED_POLICY_DIRECTION_001_SMOKE_MAX_GROSS=\(g)"); print("FED_POLICY_DIRECTION_001_SMOKE_MIN_CASH=\(mc)"); guard t>0,g<=1.000000001,mc >= -1e-6 else { print("FED_POLICY_DIRECTION_001_SMOKE_INVALID"); return }; print("FED_POLICY_DIRECTION_001_SMOKE_OK"); return }
            if let outputDir { try? FileManager.default.createDirectory(atPath:outputDir,withIntermediateDirectories:true); for (id,r) in [("FEDPOL001",candidate),("C-QQQ-BUYHOLD",control),("C-CASH",cash)] { var lines=["date,portfolio_value"]; lines.append(contentsOf:pts(r).map{"\($0.date.recordDateString),\(String(format:"%.10f",$0.portfolioValue))"}); let path=URL(fileURLWithPath:outputDir).appendingPathComponent("\(id)-portfolio.csv").path; try?(lines.joined(separator:"\n")+"\n").write(toFile:path,atomically:true,encoding:.utf8) } }
            let out:[String:Any]=["trial_id":"ATM-SVP3-FED-POLICY-DIRECTION-001","candidate_id":"S-FED-POLICY-DIRECTION-001","candidate":cdoc,"qqq_buy_hold_control":qdoc,"cash_control":cashdoc,"policy_event_count":events.count,"fee_percent_per_trade":1.0,"slippage_percent_per_trade":0.05,"evaluation_start":"2001-01-04","evaluation_end":"2026-08-13","rule":"latest official Fed target change strictly before execution date: down/easing -> 100% QQQ adjusted-close total-return proxy; up/tightening -> CNY cash; trade only when direction regime changes"]
            guard JSONSerialization.isValidJSONObject(out),let json=try?JSONSerialization.data(withJSONObject:out,options:[.sortedKeys]),let text=String(data:json,encoding:.utf8) else{print("FED_POLICY_DIRECTION_001_JSON_FAILED");return}; print("FED_POLICY_DIRECTION_001_FORMAL_JSON="+text); print("FED_POLICY_DIRECTION_001_FORMAL_OK"); return
        }
