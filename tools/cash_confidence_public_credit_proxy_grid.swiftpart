        if ProcessInfo.processInfo.environment["ATM_CC_PUBLIC_CREDIT_PROXY_GRID"] == "1" {
            struct PublicCreditProxyCandidate {
                let title: String
                let lookback: Int
                let threshold: Double
                let retention: Double
                let annualized: Double
                let maxDrawdown: Double
                let volatility: Double
                let sharpe: Double
                let sliceRows: [SliceMetricRow]
                let trades: Int
                let averageCashRatio: Double
                let events: Int
                let eventDates: [String]
                let maxTargetGross: Double
                let maxActualGross: Double
                let minCashRatio: Double
                let financedDays: Int
            }

            func loadPublicCreditCSV(_ path: String, valueColumn: String) -> [String: Double] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [:] }
                let lines = text.split(whereSeparator: \.isNewline)
                guard let header = lines.first else { return [:] }
                let columns = header.split(separator: ",", omittingEmptySubsequences: false).map(String.init)
                guard let valueIndex = columns.firstIndex(of: valueColumn) else { return [:] }
                var result: [String: Double] = [:]
                for line in lines.dropFirst() {
                    let fields = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard fields.count > valueIndex,
                          let value = Double(fields[valueIndex]), value.isFinite else { continue }
                    result[String(fields[0])] = value
                }
                return result
            }

            func alignPublicCredit(_ map: [String: Double], dates: [Date]) -> [Double?] {
                var output: [Double?] = []
                output.reserveCapacity(dates.count)
                var lastValue: Double?
                for date in dates {
                    if let value = map[date.recordDateString] { lastValue = value }
                    output.append(lastValue)
                }
                return output
            }

            func publicCreditChange(_ values: [Double?], lookback: Int) -> [Double?] {
                var output = Array<Double?>(repeating: nil, count: values.count)
                guard values.count > lookback else { return output }
                for index in lookback..<values.count {
                    guard let current = values[index], let prior = values[index - lookback] else { continue }
                    output[index] = current - prior
                }
                return output
            }

            func publicCreditZ(_ values: [Double?], window: Int = 756, minimumCount: Int = 252) -> [Double?] {
                var output = Array<Double?>(repeating: nil, count: values.count)
                for index in values.indices {
                    let start = max(0, index - window + 1)
                    let sample = values[start...index].compactMap { $0 }
                    guard sample.count >= minimumCount, let current = values[index] else { continue }
                    let mean = sample.reduce(0, +) / Double(sample.count)
                    let variance = sample.count > 1
                        ? sample.reduce(0.0) { $0 + ($1 - mean) * ($1 - mean) } / Double(sample.count - 1)
                        : 0
                    let sd = sqrt(max(variance, 0))
                    guard sd > 0.0000001 else { continue }
                    output[index] = min(max((current - mean) / sd, -4), 4)
                }
                return output
            }

            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceLowNoise
            let optionsBySymbol = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { optionsBySymbol[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }
            guard let baseRun = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                assetInputs: inputs,
                initialCash: 100_000,
                settings: settings,
                mode: mode
            ), let baseStartDate = baseRun.report.points.first?.date else {
                print("APP_CC_PUBLIC_CREDIT_PROXY_GRID\nbase_missing")
                return
            }

            let dates = baseRun.dailyStates.map(\.date)
            let baseTargetsByDate = Dictionary(uniqueKeysWithValues: baseRun.dailyStates.map { ($0.date.recordDateString, $0.targetWeights) })
            let baseTradeDates = Set(baseRun.report.trades.map { $0.date.recordDateString })
            let cp = alignPublicCredit(loadPublicCreditCSV("tools/fixtures/macro-risk/DCPN3M.csv", valueColumn: "DCPN3M"), dates: dates)
            let tbill = alignPublicCredit(loadPublicCreditCSV("tools/fixtures/macro-risk/DTB3.csv", valueColumn: "DTB3"), dates: dates)
            let spread: [Double?] = zip(cp, tbill).map { lhs, rhs in
                guard let lhs, let rhs else { return nil }
                return lhs - rhs
            }

            let lookbacks = [42, 63, 126]
            var safeZByLookback: [Int: [Double?]] = [:]
            for lookback in lookbacks {
                let raw = publicCreditZ(publicCreditChange(spread, lookback: lookback))
                safeZByLookback[lookback] = [nil] + Array(raw.dropLast())
            }

            let configurations: [(String, Int, Double, Double)] = [
                ("冠军重放控制组", 63, -999, 0.00),
                ("公开信用42日Z≤-0.75保留75%", 42, -0.75, 0.75),
                ("公开信用42日Z≤-0.75完全保留", 42, -0.75, 1.00),
                ("公开信用63日Z≤-0.75保留75%", 63, -0.75, 0.75),
                ("公开信用63日Z≤-0.75完全保留", 63, -0.75, 1.00),
                ("公开信用63日Z≤-1.00完全保留", 63, -1.00, 1.00),
                ("公开信用126日Z≤-0.75保留75%", 126, -0.75, 0.75),
                ("公开信用126日Z≤-0.75完全保留", 126, -0.75, 1.00),
            ]
            let usSymbols: Set<String> = ["nasdaq", "sp500"]
            var candidates: [PublicCreditProxyCandidate] = []

            for (title, lookback, threshold, retention) in configurations {
                let creditZ = safeZByLookback[lookback] ?? []
                let zByDate = Dictionary(uniqueKeysWithValues: zip(dates, creditZ).map { ($0.0.recordDateString, $0.1) })
                let config = ResearchTargetStrategyConfig(
                    symbol: "cc_public_credit_proxy",
                    title: title,
                    warmupSessions: 21,
                    rebalanceSessions: 1,
                    rebalanceBand: 0.244,
                    maxGrossExposure: 1.0,
                    allowsFinancedExposure: false,
                    financingAnnualRate: 0,
                    buyReason: "公开信用压力美股减仓保留"
                )
                var previousBaseWeights: [String: Double] = [:]
                var pendingWeights: [String: Double] = [:]
                var eventDates: [String] = []

                guard let run = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                    assetInputs: inputs,
                    initialCash: 100_000,
                    settings: settings,
                    config: config,
                    rebalanceDecision: { index, signalIndex, data in
                        guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let executionKey = data.dates[index].recordDateString
                        guard baseTradeDates.contains(executionKey), var target = baseTargetsByDate[executionKey] else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let priorBase = previousBaseWeights
                        previousBaseWeights = target
                        if retention > 0, !priorBase.isEmpty {
                            let priorGross = priorBase.values.reduce(0, +)
                            let proposedGross = target.values.reduce(0, +)
                            let priorUS = priorBase.reduce(0.0) { $0 + (usSymbols.contains($1.key) ? $1.value : 0) }
                            let proposedUS = target.reduce(0.0) { $0 + (usSymbols.contains($1.key) ? $1.value : 0) }
                            let usDecrease = priorUS - proposedUS
                            let grossDecrease = priorGross - proposedGross
                            let signalKey = data.dates[signalIndex].recordDateString
                            let tightening = (zByDate[signalKey] ?? nil).map { $0 <= threshold } ?? false
                            if tightening, usDecrease >= 0.05, grossDecrease >= 0.03 {
                                var desiredExtras: [String: Double] = [:]
                                for symbol in usSymbols {
                                    let reduction = max((priorBase[symbol] ?? 0) - (target[symbol] ?? 0), 0)
                                    if reduction > 0 { desiredExtras[symbol] = retention * reduction }
                                }
                                let desiredTotal = desiredExtras.values.reduce(0, +)
                                if desiredTotal > 0 {
                                    let cash = max(1.0 - proposedGross, 0)
                                    let scale = min(1.0, cash / desiredTotal)
                                    for (symbol, extra) in desiredExtras {
                                        target[symbol, default: 0] += extra * scale
                                    }
                                    eventDates.append(signalKey)
                                }
                            }
                        }
                        let gross = target.values.reduce(0, +)
                        if gross > 1, gross > 0 { target = target.mapValues { max($0, 0) / gross } }
                        pendingWeights = target
                        return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                    },
                    targetWeights: { _, _ in pendingWeights }
                ) else { continue }

                let points = run.report.points.filter { $0.date >= baseStartDate }
                guard let metrics = BacktestMetricsCalculator.performanceMetrics(from: points) else { continue }
                let fullRow = MetricRow(
                    title: title,
                    id: "cc_public_credit_proxy",
                    annualized: metrics.annualizedReturn,
                    maxDrawdown: metrics.maxDrawdown,
                    volatility: metrics.annualizedVolatility,
                    sharpe: metrics.sharpeRatio,
                    start: points.first?.date.recordDateString ?? "n/a",
                    end: points.last?.date.recordDateString ?? "n/a",
                    pointCount: points.count
                )
                var maxTargetGross = 0.0
                var maxActualGross = 0.0
                var minCashRatio = Double.greatestFiniteMagnitude
                var financedDays = 0
                for state in run.dailyStates where state.portfolioValue > 0 && state.date >= baseStartDate {
                    maxTargetGross = max(maxTargetGross, state.targetWeights.values.reduce(0, +))
                    maxActualGross = max(maxActualGross, state.holdingsBySymbol.values.reduce(0, +) / state.portfolioValue)
                    minCashRatio = min(minCashRatio, state.cash / state.portfolioValue)
                    if state.cash < -0.0001 { financedDays += 1 }
                }
                candidates.append(PublicCreditProxyCandidate(
                    title: title,
                    lookback: lookback,
                    threshold: threshold,
                    retention: retention,
                    annualized: metrics.annualizedReturn ?? -1,
                    maxDrawdown: metrics.maxDrawdown,
                    volatility: metrics.annualizedVolatility ?? -1,
                    sharpe: metrics.sharpeRatio ?? -1,
                    sliceRows: metricRowsForSlices(title: title, id: "cc_public_credit_proxy", points: points, fullRow: fullRow),
                    trades: run.report.trades.filter { $0.date >= baseStartDate }.count,
                    averageCashRatio: run.report.averageCashRatio,
                    events: eventDates.count,
                    eventDates: eventDates,
                    maxTargetGross: maxTargetGross,
                    maxActualGross: maxActualGross,
                    minCashRatio: minCashRatio == Double.greatestFiniteMagnitude ? 0 : minCashRatio,
                    financedDays: financedDays
                ))
            }

            print("APP_CC_PUBLIC_CREDIT_PROXY_BASE")
            print("annualized,max_drawdown,volatility,sharpe,trades,average_cash_ratio")
            print(String(format: "%.6f,%.6f,%.6f,%.6f,%d,%.6f", (baseRun.report.annualizedReturn ?? 0) * 100, baseRun.report.maxDrawdown * 100, (baseRun.report.annualizedVolatility ?? 0) * 100, baseRun.report.sharpeRatio ?? 0, baseRun.report.trades.count, baseRun.report.averageCashRatio))
            candidates.sort { lhs, rhs in
                let lhsScore = lhs.annualized - max(lhs.maxDrawdown - 0.08, 0) * 2
                let rhsScore = rhs.annualized - max(rhs.maxDrawdown - 0.08, 0) * 2
                if lhsScore == rhsScore { return lhs.sharpe > rhs.sharpe }
                return lhsScore > rhsScore
            }
            printSliceRows(candidates.flatMap(\.sliceRows), header: "APP_CC_PUBLIC_CREDIT_PROXY_GRID")
            print("APP_CC_PUBLIC_CREDIT_PROXY_DIAGNOSTICS")
            print("title,lookback,threshold,retention,trades,average_cash_ratio,events,max_target_gross,max_actual_gross,min_cash_ratio,financed_days,event_dates")
            for candidate in candidates {
                print([
                    candidate.title,
                    String(candidate.lookback),
                    String(format: "%.2f", candidate.threshold),
                    String(format: "%.2f", candidate.retention),
                    String(candidate.trades),
                    String(format: "%.6f", candidate.averageCashRatio),
                    String(candidate.events),
                    String(format: "%.9f", candidate.maxTargetGross),
                    String(format: "%.9f", candidate.maxActualGross),
                    String(format: "%.9f", candidate.minCashRatio),
                    String(candidate.financedDays),
                    candidate.eventDates.joined(separator: "|"),
                ].joined(separator: ","))
            }
            return
        }
