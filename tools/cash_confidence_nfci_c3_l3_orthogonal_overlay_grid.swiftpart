        if ProcessInfo.processInfo.environment["ATM_CC_NFCI_C3_L3_ORTHOGONAL_OVERLAY_GRID"] == "1" {
            struct C3L3OrthogonalCandidate {
                let title: String
                let vixRetention: Double
                let baaRetention: Double
                let annualized: Double
                let maxDrawdown: Double
                let volatility: Double
                let sharpe: Double
                let sliceRows: [SliceMetricRow]
                let trades: Int
                let averageCashRatio: Double
                let nfciEvents: Int
                let vixEvents: Int
                let baaEvents: Int
                let eventDates: [String]
                let maxTargetGross: Double
                let maxActualGross: Double
                let minCashRatio: Double
                let financedDays: Int
            }

            func loadC3L3OrthogonalSeries(_ path: String) -> [(releaseDate: String, value: Double)] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [] }
                return text.split(whereSeparator: \.isNewline).dropFirst().compactMap { line in
                    let fields = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard fields.count >= 3, let value = Double(fields[2]), value.isFinite else { return nil }
                    return (String(fields[0]), value)
                }.sorted { $0.0 < $1.0 }
            }

            func loadC3L3OrthogonalCSV(_ path: String, valueColumn: String) -> [String: Double] {
                guard let text = try? String(contentsOfFile: path, encoding: .utf8) else { return [:] }
                let lines = text.split(whereSeparator: \.isNewline)
                guard let header = lines.first else { return [:] }
                let columns = header.split(separator: ",", omittingEmptySubsequences: false).map(String.init)
                guard let valueIndex = columns.firstIndex(of: valueColumn) else { return [:] }
                var output: [String: Double] = [:]
                for line in lines.dropFirst() {
                    let fields = line.split(separator: ",", omittingEmptySubsequences: false)
                    guard fields.count > valueIndex, let value = Double(fields[valueIndex]), value.isFinite else { continue }
                    output[String(fields[0])] = value
                }
                return output
            }

            func c3L3OrthogonalChange(_ series: [(releaseDate: String, value: Double)], on signalDate: String, lookback: Int) -> Double? {
                var latest: Int?
                for index in series.indices {
                    if series[index].releaseDate <= signalDate { latest = index } else { break }
                }
                guard let latest, latest >= lookback else { return nil }
                return series[latest].value - series[latest - lookback].value
            }

            func alignC3L3Orthogonal(_ map: [String: Double], dates: [Date]) -> [Double?] {
                var output: [Double?] = []
                output.reserveCapacity(dates.count)
                var last: Double?
                for date in dates {
                    if let value = map[date.recordDateString] { last = value }
                    output.append(last)
                }
                return output
            }

            func changeC3L3Orthogonal(_ values: [Double?], lookback: Int) -> [Double?] {
                var output = Array<Double?>(repeating: nil, count: values.count)
                guard values.count > lookback else { return output }
                for index in lookback..<values.count {
                    guard let current = values[index], let prior = values[index - lookback] else { continue }
                    output[index] = current - prior
                }
                return output
            }

            func zC3L3Orthogonal(_ values: [Double?], window: Int = 756, minimumCount: Int = 252) -> [Double?] {
                var output = Array<Double?>(repeating: nil, count: values.count)
                for index in values.indices {
                    let start = max(0, index - window + 1)
                    let sample = values[start...index].compactMap { $0 }
                    guard sample.count >= minimumCount, let current = values[index] else { continue }
                    let mean = sample.reduce(0, +) / Double(sample.count)
                    let variance = sample.count > 1
                        ? sample.reduce(0.0) { $0 + ($1 - mean) * ($1 - mean) } / Double(sample.count - 1)
                        : 0
                    let sd = sqrt(max(variance, 0))
                    guard sd > 0.0000001 else { continue }
                    output[index] = min(max((current - mean) / sd, -4), 4)
                }
                return output
            }

            let creditSeries = loadC3L3OrthogonalSeries("tools/research-results/NFCICREDIT_initial_release.csv")
            let leverageSeries = loadC3L3OrthogonalSeries("tools/research-results/NFCILEVERAGE_initial_release.csv")
            let vixMap = loadC3L3OrthogonalCSV("tools/fixtures/macro-risk/VIXCLS.csv", valueColumn: "VIXCLS")
            let vix3mMap = loadC3L3OrthogonalCSV("tools/fixtures/macro-risk/VXVCLS.csv", valueColumn: "VXVCLS")
            let baaMap = loadC3L3OrthogonalCSV("tools/fixtures/macro-risk/BAA10Y.csv", valueColumn: "BAA10Y")
            guard creditSeries.count >= 700, leverageSeries.count >= 700,
                  !vixMap.isEmpty, !vix3mMap.isEmpty, !baaMap.isEmpty else {
                print("APP_CC_NFCI_C3_L3_ORTHOGONAL_OVERLAY_GRID\nseries_missing")
                return
            }

            let mode = AdvancedBacktestStrategyMode.riskContributionCashConfidenceLowNoise
            let optionsBySymbol = Dictionary(uniqueKeysWithValues: BacktestDefaults.strategyAssetOptions.map { ($0.symbol, $0) })
            let inputs = mode.requiredSignalAssetSymbols.compactMap { optionsBySymbol[$0] }.map { option in
                BacktestEngine.advancedAssetInput(for: option) { symbol in
                    seriesBySymbol[normalizedHistorySymbol(symbol)]
                }
            }
            guard let baseRun = BacktestEngine.runAdvancedRotationStrategyWithTrace(
                assetInputs: inputs,
                initialCash: 100_000,
                settings: settings,
                mode: mode
            ), let baseStartDate = baseRun.report.points.first?.date else {
                print("APP_CC_NFCI_C3_L3_ORTHOGONAL_OVERLAY_GRID\nbase_missing")
                return
            }

            let baseTargets = Dictionary(uniqueKeysWithValues: baseRun.dailyStates.map { ($0.date.recordDateString, $0.targetWeights) })
            let baseTradeDates = Set(baseRun.report.trades.map { $0.date.recordDateString })
            let macroDates = baseRun.dailyStates.map(\.date)
            let baaAligned = alignC3L3Orthogonal(baaMap, dates: macroDates)
            let baaChangeZ = zC3L3Orthogonal(changeC3L3Orthogonal(baaAligned, lookback: 63))
            // BAA10Y is published on the following business day. Lag one additional
            // trading session so a signal formed after T-1 close never sees a value
            // that would only become public during T.
            let baaPublicationSafe: [Double?] = [nil] + Array(baaChangeZ.dropLast())
            let baaByDate = Dictionary(uniqueKeysWithValues: zip(macroDates, baaPublicationSafe).map { ($0.0.recordDateString, $0.1) })
            let usSymbols: Set<String> = ["nasdaq", "sp500"]

            func blankC3L3OrthogonalMA(_ values: [Double], _ period: Int) -> [Double?] {
                Array(repeating: nil, count: values.count)
            }
            func blankC3L3OrthogonalBoll(_ values: [Double], _ period: Int, _ multiplier: Double) -> [(middle: Double, lower: Double, upper: Double)?] {
                Array(repeating: nil, count: values.count)
            }
            guard let nasdaqInput = inputs.first(where: { $0.assetOption.symbol == "nasdaq" }),
                  let preparedNasdaq = BacktestAdvancedSeriesPreparer.preparedAdvancedSeries(
                    assetSeries: nasdaqInput.assetSeries,
                    assetOption: nasdaqInput.assetOption,
                    fxSeries: nasdaqInput.fxSeries,
                    movingAverage: blankC3L3OrthogonalMA,
                    bollingerBands: blankC3L3OrthogonalBoll
                  ) else {
                print("APP_CC_NFCI_C3_L3_ORTHOGONAL_OVERLAY_GRID\nnasdaq_cny_missing")
                return
            }
            let nasdaqCNYMap = Dictionary(uniqueKeysWithValues: preparedNasdaq.pricePoints.map { ($0.date.recordDateString, $0.cnyPrice) })

            let configurations: [(title: String, vixRetention: Double, baaRetention: Double)] = [
                ("C3L3 Generic100 基准", 0.00, 0.00),
                ("C3L3 + VIX解除25%", 0.25, 0.00),
                ("C3L3 + VIX解除50%", 0.50, 0.00),
                ("C3L3 + BAA收窄25%", 0.00, 0.25),
                ("C3L3 + BAA收窄50%", 0.00, 0.50),
                ("C3L3 + VIX25% + BAA50%", 0.25, 0.50),
            ]
            var candidates: [C3L3OrthogonalCandidate] = []

            for configuration in configurations {
                let config = ResearchTargetStrategyConfig(
                    symbol: "cc_nfci_c3_l3_orthogonal_overlay",
                    title: configuration.title,
                    warmupSessions: 21,
                    rebalanceSessions: 1,
                    rebalanceBand: 0.244,
                    maxGrossExposure: 1.0,
                    allowsFinancedExposure: false,
                    financingAnnualRate: 0,
                    buyReason: "C3L3与正交风险因子减仓保留"
                )
                var previousBase: [String: Double] = [:]
                var pending: [String: Double] = [:]
                var alignedVIX: [Double?] = []
                var alignedVIX3M: [Double?] = []
                var alignedNasdaqCNY: [Double] = []
                var nfciEvents = 0
                var vixEvents = 0
                var baaEvents = 0
                var eventDates: [String] = []

                guard let run = BacktestEngine.runResearchTargetProviderStrategyWithTrace(
                    assetInputs: inputs,
                    initialCash: 100_000,
                    settings: settings,
                    config: config,
                    rebalanceDecision: { index, signalIndex, data in
                        guard data.dates.indices.contains(index), data.dates.indices.contains(signalIndex) else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        if alignedVIX.isEmpty {
                            alignedVIX = alignC3L3Orthogonal(vixMap, dates: data.dates)
                            alignedVIX3M = alignC3L3Orthogonal(vix3mMap, dates: data.dates)
                            var lastNasdaq: Double?
                            for date in data.dates {
                                if let value = nasdaqCNYMap[date.recordDateString] { lastNasdaq = value }
                                guard let value = lastNasdaq else {
                                    return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                                }
                                alignedNasdaqCNY.append(value)
                            }
                        }

                        let executionKey = data.dates[index].recordDateString
                        guard baseTradeDates.contains(executionKey), var target = baseTargets[executionKey] else {
                            return BacktestRebalanceDecision(shouldRebalance: false, refreshOverlay: false)
                        }
                        let prior = previousBase
                        previousBase = target
                        guard !prior.isEmpty else {
                            pending = target
                            return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                        }

                        let signalKey = data.dates[signalIndex].recordDateString
                        let creditTrigger = c3L3OrthogonalChange(creditSeries, on: signalKey, lookback: 8).map { $0 <= -0.03 } ?? false
                        let leverageTrigger = c3L3OrthogonalChange(leverageSeries, on: signalKey, lookback: 4).map { $0 <= -0.03 } ?? false
                        let priorGross = prior.values.reduce(0, +)
                        let proposedGross = target.values.reduce(0, +)
                        let priorUS = prior.reduce(0.0) { $0 + (usSymbols.contains($1.key) ? $1.value : 0) }
                        let proposedUS = target.reduce(0.0) { $0 + (usSymbols.contains($1.key) ? $1.value : 0) }
                        let usDecrease = priorUS - proposedUS
                        let grossDecrease = priorGross - proposedGross
                        var extras: [String: Double] = [:]
                        var tags: [String] = []

                        if creditTrigger || leverageTrigger {
                            if usDecrease >= 0.05, grossDecrease >= 0.03 {
                                let retention = creditTrigger && leverageTrigger ? 1.00 : 0.50
                                for symbol in usSymbols {
                                    let reduction = max((prior[symbol] ?? 0) - (target[symbol] ?? 0), 0)
                                    if reduction > 0 { extras[symbol] = retention * reduction }
                                }
                            } else if grossDecrease >= 0.05 {
                                for (symbol, priorWeight) in prior {
                                    let reduction = max(priorWeight - (target[symbol] ?? 0), 0)
                                    if reduction > 0 { extras[symbol] = reduction }
                                }
                            }
                            if !extras.isEmpty {
                                nfciEvents += 1
                                tags.append(creditTrigger && leverageTrigger ? "CL" : (creditTrigger ? "C" : "L"))
                            }
                        } else {
                            var vixRelease = false
                            if configuration.vixRetention > 0,
                               signalIndex >= 5,
                               alignedVIX.indices.contains(signalIndex), alignedVIX.indices.contains(signalIndex - 5),
                               alignedVIX3M.indices.contains(signalIndex - 5),
                               alignedNasdaqCNY.indices.contains(signalIndex), alignedNasdaqCNY.indices.contains(signalIndex - 5),
                               let vixNow = alignedVIX[signalIndex],
                               let vixPrior = alignedVIX[signalIndex - 5],
                               let vix3mPrior = alignedVIX3M[signalIndex - 5],
                               vixPrior > 0, vix3mPrior > 0, alignedNasdaqCNY[signalIndex - 5] > 0 {
                                let nasdaqMomentum5 = alignedNasdaqCNY[signalIndex] / alignedNasdaqCNY[signalIndex - 5] - 1
                                vixRelease = (vixPrior / vix3mPrior >= 1.0 || vixPrior >= 30.0)
                                    && vixNow / vixPrior - 1 <= -0.10
                                    && nasdaqMomentum5 > 0
                            }
                            if vixRelease, grossDecrease >= 0.05 {
                                for (symbol, priorWeight) in prior {
                                    let reduction = max(priorWeight - (target[symbol] ?? 0), 0)
                                    if reduction > 0 {
                                        extras[symbol] = max(extras[symbol] ?? 0, configuration.vixRetention * reduction)
                                    }
                                }
                                if !extras.isEmpty {
                                    vixEvents += 1
                                    tags.append("V")
                                }
                            }

                            let baaFavorable = (baaByDate[signalKey] ?? nil).map { $0 <= -0.75 } ?? false
                            if configuration.baaRetention > 0, baaFavorable,
                               usDecrease >= 0.05, grossDecrease >= 0.03 {
                                var baaApplied = false
                                for symbol in usSymbols {
                                    let reduction = max((prior[symbol] ?? 0) - (target[symbol] ?? 0), 0)
                                    if reduction > 0 {
                                        extras[symbol] = max(extras[symbol] ?? 0, configuration.baaRetention * reduction)
                                        baaApplied = true
                                    }
                                }
                                if baaApplied {
                                    baaEvents += 1
                                    tags.append("B")
                                }
                            }
                        }

                        let desired = extras.values.reduce(0, +)
                        if desired > 0 {
                            let cash = max(1.0 - proposedGross, 0)
                            let scale = min(1.0, cash / desired)
                            for (symbol, extra) in extras { target[symbol, default: 0] += extra * scale }
                            eventDates.append(tags.joined(separator: "+") + ":" + signalKey)
                        }
                        let gross = target.values.reduce(0, +)
                        if gross > 1.0, gross > 0 { target = target.mapValues { max($0, 0) / gross } }
                        pending = target
                        return BacktestRebalanceDecision(shouldRebalance: true, refreshOverlay: false)
                    },
                    targetWeights: { _, _ in pending }
                ) else { continue }

                let points = run.report.points.filter { $0.date >= baseStartDate }
                guard let metrics = BacktestMetricsCalculator.performanceMetrics(from: points) else { continue }
                let fullRow = MetricRow(
                    title: configuration.title,
                    id: "cc_nfci_c3_l3_orthogonal_overlay",
                    annualized: metrics.annualizedReturn,
                    maxDrawdown: metrics.maxDrawdown,
                    volatility: metrics.annualizedVolatility,
                    sharpe: metrics.sharpeRatio,
                    start: points.first?.date.recordDateString ?? "n/a",
                    end: points.last?.date.recordDateString ?? "n/a",
                    pointCount: points.count
                )
                var maxTargetGross = 0.0
                var maxActualGross = 0.0
                var minCashRatio = Double.greatestFiniteMagnitude
                var financedDays = 0
                for state in run.dailyStates where state.portfolioValue > 0 && state.date >= baseStartDate {
                    maxTargetGross = max(maxTargetGross, state.targetWeights.values.reduce(0, +))
                    maxActualGross = max(maxActualGross, state.holdingsBySymbol.values.reduce(0, +) / state.portfolioValue)
                    minCashRatio = min(minCashRatio, state.cash / state.portfolioValue)
                    if state.cash < -0.0001 { financedDays += 1 }
                }
                candidates.append(.init(
                    title: configuration.title,
                    vixRetention: configuration.vixRetention,
                    baaRetention: configuration.baaRetention,
                    annualized: metrics.annualizedReturn ?? -1,
                    maxDrawdown: metrics.maxDrawdown,
                    volatility: metrics.annualizedVolatility ?? -1,
                    sharpe: metrics.sharpeRatio ?? -1,
                    sliceRows: metricRowsForSlices(
                        title: configuration.title,
                        id: "cc_nfci_c3_l3_orthogonal_overlay",
                        points: points,
                        fullRow: fullRow
                    ),
                    trades: run.report.trades.filter { $0.date >= baseStartDate }.count,
                    averageCashRatio: run.report.averageCashRatio,
                    nfciEvents: nfciEvents,
                    vixEvents: vixEvents,
                    baaEvents: baaEvents,
                    eventDates: eventDates,
                    maxTargetGross: maxTargetGross,
                    maxActualGross: maxActualGross,
                    minCashRatio: minCashRatio == Double.greatestFiniteMagnitude ? 0 : minCashRatio,
                    financedDays: financedDays
                ))
            }

            print("APP_CC_NFCI_C3_L3_ORTHOGONAL_BASE")
            print(String(format: "%.6f,%.6f,%.6f,%d", (baseRun.report.annualizedReturn ?? 0) * 100, baseRun.report.maxDrawdown * 100, baseRun.report.sharpeRatio ?? 0, baseRun.report.trades.count))
            candidates.sort { lhs, rhs in
                if lhs.sharpe == rhs.sharpe { return lhs.annualized > rhs.annualized }
                return lhs.sharpe > rhs.sharpe
            }
            printSliceRows(candidates.flatMap(\.sliceRows), header: "APP_CC_NFCI_C3_L3_ORTHOGONAL_GRID")
            print("APP_CC_NFCI_C3_L3_ORTHOGONAL_DIAGNOSTICS")
            print("title,vix_retention,baa_retention,nfci_events,vix_events,baa_events,trades,average_cash,max_target_gross,max_actual_gross,min_cash,financed_days,event_dates")
            for candidate in candidates {
                print([
                    candidate.title,
                    String(format: "%.2f", candidate.vixRetention),
                    String(format: "%.2f", candidate.baaRetention),
                    String(candidate.nfciEvents),
                    String(candidate.vixEvents),
                    String(candidate.baaEvents),
                    String(candidate.trades),
                    String(format: "%.6f", candidate.averageCashRatio),
                    String(format: "%.9f", candidate.maxTargetGross),
                    String(format: "%.9f", candidate.maxActualGross),
                    String(format: "%.9f", candidate.minCashRatio),
                    String(candidate.financedDays),
                    candidate.eventDates.joined(separator: "|")
                ].joined(separator: ","))
            }
            return
        }
